/src/HotelPOS.Api/media/

# Written by AuthorizationMatrixTests when the matrix differs from the reviewed snapshot
*.actual.txt

# Local secrets and machine configuration (never commit)
appsettings.Local.json
appsettings.Production.json
**/HotelPOS.Desktop/settings.json
*.pfx

# OS
Thumbs.db
.DS_Store
