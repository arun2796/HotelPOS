{
  "Urls": "http://0.0.0.0:5000",
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "HotelPOS": "Server=.\\SQLEXPRESS;Database=HotelPOS;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Jwt": {
    "Issuer": "HotelPOS",
    "Audience": "HotelPOS.Clients",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenHours": 12
  },

  "Database": {
    "AutoMigrate": true,
    "Seed": true
  },

  "Seed": {
    "AdminPassword": "",
    "DemoData": false
  },

  "App": {
    "MinClientVersion": "0.1.0"
  },

  "Logging": {
    "Directory": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  }
}
