<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Phase 18/19: browser host for the staff client (waiters on phones, kitchen on tablets). The pages live in
       HotelPOS.Client.Shared; this project only boots them in the browser. Served by HotelPOS.Api under /app, so
       every asset path is relative to /app/ and the API, hub and images are same-origin. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <StaticWebAssetBasePath>app</StaticWebAssetBasePath>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <BlazorEnableCompression>true</BlazorEnableCompression>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HotelPOS.Client.Shared\HotelPOS.Client.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
