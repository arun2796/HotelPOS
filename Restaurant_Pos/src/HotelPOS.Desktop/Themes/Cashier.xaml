<!-- Phase 21 Cashier-track styles (merged after Controls.xaml). Keep track-specific styles here so parallel work does not collide. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
                    xmlns:billing="clr-namespace:HotelPOS.Desktop.Modules.Billing"
                    xmlns:contracts="clr-namespace:HotelPOS.Contracts.Billing;assembly=HotelPOS.Contracts"
                    xmlns:customers="clr-namespace:HotelPOS.Contracts.Customers;assembly=HotelPOS.Contracts">

  <!-- The workspace page for the "billing" module (App.xaml maps the other pages; this one lives with its styles). -->
  <DataTemplate DataType="{x:Type billing:CashierWorkspaceViewModel}">
    <billing:CashierWorkspaceView />
  </DataTemplate>

  <!-- ============================ Queue chips ============================ -->
  <!-- Filter chip: pill toggle; checked = primary fill with white text. The count sits in a small round badge. -->
  <Style x:Key="Cashier.FilterChip" TargetType="ToggleButton">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" CornerRadius="{StaticResource Radius.Pill}" Padding="{TemplateBinding Padding}" Background="{DynamicResource Brush.SurfaceSubtle}"
                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.LayerHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Cashier.FilterChip.Count" TargetType="Border">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextElement.FontSize" Value="11" />
    <Setter Property="TextElement.FontWeight" Value="Bold" />
  </Style>

  <!-- ============================ Queue list ============================ -->
  <Style x:Key="Cashier.Queue" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,0,12,12" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
  </Style>

  <!-- A bill card in the queue: left accent in the status tone, primary border + soft fill when selected. -->
  <Style x:Key="Cashier.QueueItem" TargetType="ListBoxItem">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Root" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Card}" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Accent" Width="4" Margin="6,10,0,10" CornerRadius="2" Background="{DynamicResource Brush.Border}" />
              <ContentPresenter Grid.Column="1" Margin="12,12,14,12" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.LayerHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="2" />
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
              <Setter TargetName="Accent" Property="Background" Value="{DynamicResource Brush.Primary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Bill card: table + order number, status badge, waiter and wait time, what is due; "Held by" when another counter has it. -->
  <DataTemplate x:Key="Cashier.BillCard" DataType="{x:Type billing:BillQueueItemViewModel}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding TableCode}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding OrderNumberText}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}"
                   VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis" />
        <controls:StatusBadge Grid.Column="2" Display="{Binding Display}" />
      </Grid>
      <Grid Grid.Row="1" Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding WaiterName}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
          <controls:Icon Kind="clock" Width="12" Height="12" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding WaitingText}" Style="{StaticResource Text.Caption}" Margin="4,0,0,0" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2" Margin="0,6,0,0">
        <TextBlock Text="{Binding DueText}" FontSize="{DynamicResource Font.Size.Amount}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
        <Border Style="{StaticResource Chip.Warning}" HorizontalAlignment="Right" VerticalAlignment="Center"
                Visibility="{Binding IsClaimedByOther, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <controls:Icon Kind="lock" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Text="{Binding ClaimBadge, StringFormat='Held by {0}'}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DataTemplate>

  <!-- ============================ Shared rows ============================ -->
  <DataTemplate x:Key="Cashier.AmountRow" DataType="{x:Type billing:AmountRow}">
    <Grid Margin="0,3,0,0">
      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}"
                 TextTrimming="CharacterEllipsis" Margin="0,0,100,0" />
      <TextBlock Text="{Binding Amount}" Style="{StaticResource Text.Numeric}" />
    </Grid>
  </DataTemplate>

  <!-- ============================ Centre: the bill ============================ -->
  <DataTemplate x:Key="Cashier.BillTemplate" DataType="{x:Type billing:BillDetailViewModel}">
    <Border Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, then pills (status, invoice, guests, waiter, requested time). -->
        <Grid Margin="20,16,20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
              <controls:StatusBadge Display="{Binding Display}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <WrapPanel Margin="0,8,0,0">
              <Border Style="{StaticResource Chip.Neutral}" Margin="0,0,6,4">
                <TextBlock Text="{Binding InvoiceTitle}" />
              </Border>
              <Border Style="{StaticResource Chip.Neutral}" Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="users" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="{Binding GuestsText}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Chip.Neutral}" Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="user" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="{Binding WaiterText}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Chip.Neutral}" Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="clock" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="{Binding RequestedText}" />
                </StackPanel>
              </Border>
            </WrapPanel>
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding BackCommand}" Style="{StaticResource Button.Ghost}" VerticalAlignment="Top" Margin="8,0,0,0"
                  ToolTip="Back to the queue (Esc)" AutomationProperties.Name="Back to the queue">
            <controls:Icon Kind="x" Width="18" Height="18" />
          </Button>
        </Grid>

        <!-- Notices -->
        <StackPanel Grid.Row="1" Margin="20,12,20,0">
          <Border Style="{StaticResource Banner.Warning}" Visibility="{Binding IsHeldByOther, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Take over" Command="{Binding TakeOverCommand}" Margin="12,0,0,0"
                      Visibility="{Binding CanTakeOver, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Text="{Binding HeldByText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <controls:ErrorState Icon="alert" Title="Could not update the bill" Message="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>

        <!-- Lines (OrderLine: picture or initials, options, note) and the order-notes banner -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Margin="0,8,0,0">
          <StackPanel Margin="20,0,20,8">
            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type billing:BillLineRow}">
                  <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                    <controls:OrderLine Quantity="{Binding QuantityValue}" ItemName="{Binding Name}" Modifiers="{Binding Modifiers}" Note="{Binding Note}"
                                        PriceText="{Binding Total}" Image="{Binding ImageFile, Converter={StaticResource ImageFile}}" ImageSize="48" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Banner.Warning}" Margin="0,12,0,0" Visibility="{Binding HasOrderNotes, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Kind="info" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0" Foreground="{DynamicResource Brush.WarningText}" />
                <StackPanel>
                  <TextBlock Text="Order notes" FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" />
                  <TextBlock Text="{Binding OrderNotes}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Totals -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
          <StackPanel>
            <Grid>
              <TextBlock Text="Subtotal" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" />
              <TextBlock Text="{Binding SubtotalText}" Style="{StaticResource Text.Numeric}" />
            </Grid>
            <Grid Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DiscountLabel}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                <Button Content="Add discount" Command="{Binding ShowDiscountCommand}" Style="{StaticResource Button.Link}" Margin="8,0,0,0"
                        Visibility="{Binding IsPaid, Converter={StaticResource InverseBoolToVisibility}}"
                        IsEnabled="{Binding CanEdit}" />
              </StackPanel>
              <TextBlock Text="{Binding DiscountText}" Style="{StaticResource Text.Numeric}" Foreground="{DynamicResource Brush.SuccessText}"
                         Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding TaxRows}" ItemTemplate="{StaticResource Cashier.AmountRow}" Focusable="False" Margin="0,1,0,0" />
            <Grid Margin="0,3,0,0" Visibility="{Binding HasRoundOff, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Round off" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" />
              <TextBlock Text="{Binding RoundOffText}" Style="{StaticResource Text.Numeric}" />
            </Grid>
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
              <Grid>
                <TextBlock Text="Total" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GrandTotalText}" FontSize="{DynamicResource Font.Size.Amount}" FontWeight="Bold" HorizontalAlignment="Right"
                           Typography.NumeralAlignment="Tabular" />
              </Grid>
            </Border>
            <StackPanel Visibility="{Binding HasPayments, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
              <ItemsControl ItemsSource="{Binding PaymentRows}" ItemTemplate="{StaticResource Cashier.AmountRow}" Focusable="False" />
              <Grid Margin="0,4,0,0">
                <TextBlock Text="Balance due" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding BalanceText}" Style="{StaticResource Text.Numeric}" FontWeight="SemiBold" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Customer and actions -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,10,20,14">
          <StackPanel>
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:Icon Kind="user" Width="16" Height="16" Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock Text="{Binding CustomerText}" Style="{StaticResource Text.Body}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="320" />
              </StackPanel>
              <Button Content="Customer…" Command="{Binding ShowCustomerCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Content="{Binding FinalizeText}" Command="{Binding FinalizeCommand}" Style="{StaticResource Button.PrimaryOutline}" MinHeight="44"
                      IsEnabled="{Binding CanFinalize}" />
              <Button Grid.Column="2" Content="Reopen for waiter" Command="{Binding ReopenCommand}" Style="{StaticResource Button.Secondary}" MinHeight="44"
                      IsEnabled="{Binding CanReopen}" />
              <Button Grid.Column="4" Content="Void" Command="{Binding VoidCommand}" Style="{StaticResource Button.Danger}" MinHeight="44"
                      IsEnabled="{Binding CanVoid}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ============================ Right: payment (permanent) ============================ -->
  <!-- Complete payment: the one primary action; while a payment is being submitted it reads "Submitting…" and is disabled. -->
  <Style x:Key="Cashier.CompleteButton" TargetType="Button" BasedOn="{StaticResource Button.Large}">
    <Setter Property="Content" Value="Complete payment" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsBusy}" Value="True">
        <Setter Property="Content" Value="Submitting…" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <DataTemplate x:Key="Cashier.PaymentTemplate" DataType="{x:Type billing:BillDetailViewModel}">
    <Border Style="{StaticResource PaymentPanel}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
          <StackPanel Margin="16,14,16,8">
            <Grid>
              <TextBlock Text="Payment" Style="{StaticResource Text.Subtitle}" />
              <controls:StatusBadge Display="{Binding Display}" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock Text="Amount due" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding BalanceText}" Style="{StaticResource PaymentPanel.Due}" />

            <!-- Held elsewhere: look, do not change -->
            <Border Style="{StaticResource Banner.Warning}" Margin="0,10,0,0" Visibility="{Binding IsHeldByOther, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding HeldByText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
            </Border>

            <!-- Paid (this session: with the change to give back; a closed bill from the Paid chip: its payments) -->
            <StackPanel Visibility="{Binding IsPaid, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
              <Border Style="{StaticResource PaymentPanel.Change}" Padding="14,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <controls:Icon Kind="check" Width="20" Height="20" Foreground="{DynamicResource Brush.SuccessText}" />
                    <TextBlock Text="Paid" FontSize="{DynamicResource Font.Size.Section}" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding InvoiceTitle}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                  <StackPanel Visibility="{Binding IsDonePanel, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Change to give back" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding ChangeDueText}" Style="{StaticResource PaymentPanel.ChangeAmount}" TextAlignment="Left" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding PaymentRows}" ItemTemplate="{StaticResource Cashier.AmountRow}" Focusable="False" Margin="0,10,0,0" />
            </StackPanel>

            <!-- Form -->
            <StackPanel Visibility="{Binding CanPay, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
              <Border Style="{StaticResource Banner.Warning}" Visibility="{Binding HasMethods, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="No payment method is set up. Ask an administrator to add one under Billing setup." Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
              </Border>
              <StackPanel Visibility="{Binding HasMethods, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Payment method" Style="{StaticResource Text.Label}" />
                <!-- D6: one toggle per active configured method in sort order; the hotkey is the caption. Split is fixed (F9). -->
                <ItemsControl ItemsSource="{Binding MethodButtons}" Focusable="False" Margin="0,6,-8,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type billing:PaymentMethodButton}">
                      <ToggleButton Style="{StaticResource PaymentPanel.Method}" MinHeight="44" Margin="0,0,8,6" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                    Command="{Binding DataContext.PayWithCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Method}" AutomationProperties.Name="{Binding Name}">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Hotkey}" FontSize="11" FontWeight="Normal" Opacity="0.75" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                      </ToggleButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ToggleButton Style="{StaticResource PaymentPanel.Method}" IsChecked="{Binding IsSplitSelected, Mode=OneWay}" Command="{Binding PaySplitCommand}"
                              HorizontalAlignment="Stretch" Margin="0,0,0,4" MinHeight="40" AutomationProperties.Name="Split payment">
                  <StackPanel Orientation="Horizontal">
                    <controls:Icon Kind="swap" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Split payment" VerticalAlignment="Center" />
                    <TextBlock Text="F9" FontSize="11" FontWeight="Normal" Opacity="0.75" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                </ToggleButton>

            <ContentControl Content="{Binding Payment}" Focusable="False">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type billing:PaymentViewModel}">
                  <StackPanel>
                    <StackPanel Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
                      <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Amount to pay" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" MinHeight="40" TextAlignment="Right"
                                 Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Amount to pay" />
                      </Grid>
                      <StackPanel Visibility="{Binding IsCash, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Quick amounts" Style="{StaticResource Text.Caption}" Margin="0,6,0,2" />
                        <ItemsControl ItemsSource="{Binding QuickTenders}" Focusable="False" Margin="0,0,-8,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type billing:QuickTenderOption}">
                              <Button Content="{Binding Label}" Style="{StaticResource PaymentPanel.QuickAmount}" MinHeight="38" Margin="0,0,8,6"
                                      Command="{Binding DataContext.QuickTenderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Amount received" Style="{StaticResource Text.Caption}" Margin="0,2,0,2" />
                        <TextBox Text="{Binding TenderedText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PaymentPanel.Received}" MaxLength="12" MinHeight="46"
                                 AutomationProperties.Name="Amount received" />
                        <Border Style="{StaticResource PaymentPanel.Change}" Margin="0,4,0,0" Padding="14,6">
                          <Grid>
                            <TextBlock Text="Change due" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ChangeText}" Style="{StaticResource PaymentPanel.ChangeAmount}" />
                          </Grid>
                        </Border>
                      </StackPanel>
                      <StackPanel Visibility="{Binding NeedsReference, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Reference / approval code" Style="{StaticResource Text.Caption}" Margin="0,10,0,2" />
                        <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" MinHeight="40" AutomationProperties.Name="Reference" />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                      <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type billing:PaymentLineViewModel}">
                            <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="0,6">
                              <StackPanel>
                                <Grid>
                                  <TextBlock Text="{Binding Method.Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                  <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right" ToolTip="Remove" AutomationProperties.Name="Remove line"
                                          Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}">
                                    <controls:Icon Kind="x" Width="14" Height="14" />
                                  </Button>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" IsReadOnly="{Binding IsPaid}" AutomationProperties.Name="Amount" />
                                  <TextBox Grid.Column="1" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="8,0,0,0"
                                           ToolTip="Reference" IsReadOnly="{Binding IsPaid}" AutomationProperties.Name="Reference"
                                           Visibility="{Binding NeedsReference, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Add a part" Style="{StaticResource Text.Caption}" Margin="0,8,0,4" />
                      <ItemsControl ItemsSource="{Binding Methods}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type contracts:PaymentMethodDto}">
                            <Button Content="{Binding Name}" Style="{StaticResource Button.Secondary}" MinWidth="72" Margin="0,0,6,6"
                                    Command="{Binding DataContext.AddLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid Margin="0,6,0,0">
                        <TextBlock Text="Remaining" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Text.Numeric}" FontWeight="Bold" />
                      </Grid>
                    </StackPanel>

                    <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.WarningText}"
                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibility}}" />
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Footer, always in view: the failure (inline, actionable), Complete payment, or the paid actions. -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
          <StackPanel>
            <controls:ErrorState Icon="alert" Title="Payment not taken" Message="{Binding PaymentError}" Margin="0,0,0,10"
                                 Visibility="{Binding PaymentError, Converter={StaticResource StringToVisibility}}" />
            <Button Style="{StaticResource Cashier.CompleteButton}" Command="{Binding ConfirmPaymentCommand}" IsEnabled="{Binding CanConfirmPayment}"
                    Visibility="{Binding CanPay, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Complete payment" />
            <StackPanel Visibility="{Binding IsPaid, Converter={StaticResource BoolToVisibility}}">
              <UniformGrid Columns="2">
                <Button Content="Print receipt" Command="{Binding PrintReceiptCommand}" Style="{StaticResource Button.Secondary}" MinHeight="44" Margin="0,0,4,0" />
                <Button Content="Print invoice" Command="{Binding PrintInvoiceCommand}" Style="{StaticResource Button.Secondary}" MinHeight="44" Margin="4,0,0,0" />
              </UniformGrid>
              <Button Content="Next bill" Command="{Binding NextBillCommand}" Style="{StaticResource Button.Large}" Margin="0,8,0,0" />
            </StackPanel>
            <!-- Quick actions: the keyboard legend (the method buttons carry their own key). -->
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0">
              <Run Text="F2" FontWeight="SemiBold" /><Run Text=" cash  ·  " /><Run Text="F3–F8" FontWeight="SemiBold" /><Run Text=" other methods  ·  " /><Run Text="F9" FontWeight="SemiBold" /><Run Text=" split  ·  " /><Run Text="Esc" FontWeight="SemiBold" /><Run Text=" back to the queue" />
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ============================ Overlays: discount, customer, invoice preview ============================ -->
  <DataTemplate x:Key="Cashier.PanelsTemplate" DataType="{x:Type billing:BillDetailViewModel}">
    <Border Style="{StaticResource Dialog.Frame}" Width="620" MaxHeight="660" Padding="24">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>

            <StackPanel Visibility="{Binding IsDiscountPanel, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Discount" Style="{StaticResource Text.Title}" />
              <TextBlock Text="Choose a predefined discount, or enter one with a reason. Large discounts need a manager." Style="{StaticResource Text.Caption}"
                         TextWrapping="Wrap" Margin="0,4,0,12" />
              <ItemsControl ItemsSource="{Binding Discounts}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type billing:DiscountRow}">
                    <Button MinHeight="52" MinWidth="130" Margin="0,0,8,8"
                            Command="{Binding DataContext.ApplyPredefinedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                      <StackPanel>
                        <TextBlock Text="{Binding Discount.Name}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Manual discount" Style="{StaticResource Text.Label}" Margin="0,10,0,0" />
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox SelectedIndex="{Binding ManualKind}">
                  <ComboBoxItem Content="Percent %" />
                  <ComboBoxItem Content="Amount" />
                </ComboBox>
                <TextBox Grid.Column="2" Text="{Binding ManualValue, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" ToolTip="Value" AutomationProperties.Name="Discount value" />
                <TextBox Grid.Column="4" Text="{Binding ManualReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" ToolTip="Reason" AutomationProperties.Name="Discount reason" />
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Apply" Command="{Binding ApplyManualCommand}" Style="{StaticResource Button.Primary}" MinWidth="120" />
                <Button Content="Remove discount" Command="{Binding RemoveDiscountCommand}" Margin="12,0,0,0"
                        Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding IsCustomerPanel, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Customer details" Style="{StaticResource Text.Title}" />
              <TextBlock Text="Printed on the invoice. A GSTIN is needed for a business (B2B) invoice." Style="{StaticResource Text.Caption}" Margin="0,4,0,12" />
              <StackPanel Visibility="{Binding HasCustomerPicker, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
                <TextBlock Text="Find a customer" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}" MinHeight="44"
                         ToolTip="Search by name, phone or GSTIN" AutomationProperties.Name="Find a customer" />
                <ItemsControl ItemsSource="{Binding CustomerMatches}" Focusable="False" Margin="0,6,0,0"
                              Visibility="{Binding HasCustomerMatches, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type customers:CustomerDto}">
                      <Button Command="{Binding DataContext.PickCustomerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" MinHeight="48" Margin="0,0,0,4"
                              AutomationProperties.Name="{Binding Name}">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Phone}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding Gstin}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No customer matches. Fill in the details below, or add the customer on the Customers screen."
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding HasNoCustomerMatches, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding PickedCustomerName, StringFormat='Picked: {0}'}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                           Visibility="{Binding PickedCustomerName, Converter={StaticResource StringToVisibility}}" />
                <Button Content="Clear customer" Command="{Binding ClearCustomerCommand}" HorizontalAlignment="Left" MinHeight="44" Margin="0,8,0,0"
                        ToolTip="Take the customer off this bill"
                        Visibility="{Binding CanClearCustomer, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
              <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,0,0,12" AutomationProperties.Name="Customer name" />
              <TextBlock Text="Phone" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,0,0,12" AutomationProperties.Name="Customer phone" />
              <TextBlock Text="GSTIN" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding CustomerGstin, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" CharacterCasing="Upper" AutomationProperties.Name="GSTIN" />
              <TextBlock Text="{Binding GstinHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,12" />
              <TextBlock Text="Legal name (as registered)" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding CustomerLegalName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,12" AutomationProperties.Name="Legal name" />
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Customer state" Style="{StaticResource Text.Label}" />
                  <ComboBox ItemsSource="{Binding StateChoices}" SelectedValuePath="Code" DisplayMemberPath="Name"
                            SelectedValue="{Binding CustomerStateCode}" AutomationProperties.Name="Customer state" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Place of supply" Style="{StaticResource Text.Label}" />
                  <ComboBox ItemsSource="{Binding StateChoices}" SelectedValuePath="Code" DisplayMemberPath="Name"
                            SelectedValue="{Binding PlaceOfSupply}" AutomationProperties.Name="Place of supply" />
                </StackPanel>
              </Grid>
              <TextBlock Text="Place of supply is the restaurant's own state unless the service is supplied in another state (then IGST applies)."
                         Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
              <Button Content="Save" Command="{Binding SaveCustomerCommand}" Style="{StaticResource Button.Primary}" MinWidth="120"
                      HorizontalAlignment="Left" Margin="0,16,0,0" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsPreviewPanel, Converter={StaticResource BoolToVisibility}}">
              <Grid>
                <TextBlock Text="Invoice preview" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="Print preview" Command="{Binding PreviewInvoiceCommand}" MinHeight="40" />
                  <Button Content="Print" Command="{Binding PrintInvoiceCommand}" Style="{StaticResource Button.Primary}" MinHeight="40" MinWidth="110" Margin="8,0,0,0" />
                </StackPanel>
              </Grid>
              <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,8,0,0"
                      Background="#FFFFFF" TextElement.Foreground="#18181B" TextElement.FontFamily="Consolas">
                <StackPanel>
                  <TextBlock Text="{Binding RestaurantName}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding RestaurantAddress}" HorizontalAlignment="Center"
                             Visibility="{Binding RestaurantAddress, Converter={StaticResource StringToVisibility}}" />
                  <TextBlock HorizontalAlignment="Center" Visibility="{Binding RestaurantGstin, Converter={StaticResource StringToVisibility}}">
                    <Run Text="GSTIN" />
                    <Run Text="{Binding RestaurantGstin, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="TAX INVOICE" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding InvoiceTitle}" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding Title}" />
                  <TextBlock Text="{Binding CustomerText}" />
                  <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type billing:BillLineRow}">
                        <Grid>
                          <TextBlock Margin="0,0,90,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Quantity, Mode=OneWay}" />
                            <Run Text="x" />
                            <Run Text="{Binding Name, Mode=OneWay}" />
                          </TextBlock>
                          <TextBlock Text="{Binding Total}" HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid Margin="0,8,0,0">
                    <TextBlock Text="Subtotal" />
                    <TextBlock Text="{Binding SubtotalText}" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Discount" />
                    <TextBlock Text="{Binding DiscountText}" HorizontalAlignment="Right" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding TaxRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type billing:AmountRow}">
                        <Grid>
                          <TextBlock Text="{Binding Label}" />
                          <TextBlock Text="{Binding Amount}" HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid Visibility="{Binding HasRoundOff, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Round off" />
                    <TextBlock Text="{Binding RoundOffText}" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid Margin="0,6,0,0">
                    <TextBlock Text="TOTAL" FontWeight="Bold" />
                    <TextBlock Text="{Binding GrandTotalText}" FontWeight="Bold" HorizontalAlignment="Right" />
                  </Grid>
                  <TextBlock Text="{Binding ReceiptFooter}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>

            <Border Style="{StaticResource Banner.Error}" Margin="0,14,0,0"
                    Visibility="{Binding PanelError, Converter={StaticResource StringToVisibility}}">
              <TextBlock Text="{Binding PanelError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Close" Command="{Binding ClosePanelCommand}" MinWidth="110" MinHeight="48" HorizontalAlignment="Right" Margin="0,18,0,0" />
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
