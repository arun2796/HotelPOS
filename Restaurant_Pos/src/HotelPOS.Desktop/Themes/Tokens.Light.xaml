<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Light theme tokens (Phase 17 enterprise palette: cool greys, green accent, light sidebar). ThemeService swaps this dictionary for
       Tokens.Dark.xaml; both define exactly the same keys. Views and styles use them only through DynamicResource. -->

  <!-- Surfaces and layers -->
  <SolidColorBrush x:Key="Brush.Background" Color="#F4F7FA" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F8FAFC" />
  <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="#F1F5F9" />
  <SolidColorBrush x:Key="Brush.LayerHover" Color="#F1F5F9" />
  <SolidColorBrush x:Key="Brush.LayerPressed" Color="#E8EEF4" />
  <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#0D000000" />
  <SolidColorBrush x:Key="Brush.PressedOverlay" Color="#1A000000" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="#8009090B" />

  <!-- Borders -->
  <SolidColorBrush x:Key="Brush.Border" Color="#E3E8EF" />
  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#EEF2F6" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#CBD5E1" />

  <!-- Text -->
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="#172033" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#667085" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="#98A2B3" />

  <!-- Inputs -->
  <SolidColorBrush x:Key="Brush.InputBackground" Color="#F8FAFC" />
  <SolidColorBrush x:Key="Brush.InputBackgroundFocus" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.InputBorder" Color="#D5DCE5" />
  <SolidColorBrush x:Key="Brush.Focus" Color="#078B45" />

  <!-- Accent and semantic colours. "Soft" fills sit behind text of the matching colour. -->
  <SolidColorBrush x:Key="Brush.Primary" Color="#078B45" />
  <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#06763B" />
  <SolidColorBrush x:Key="Brush.PrimaryText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.PrimarySoft" Color="#E9F8EF" />
  <SolidColorBrush x:Key="Brush.Link" Color="#078B45" />
  <SolidColorBrush x:Key="Brush.Info" Color="#2563EB" />
  <SolidColorBrush x:Key="Brush.InfoSoft" Color="#EFF6FF" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626" />
  <SolidColorBrush x:Key="Brush.DangerText" Color="#B91C1C" />
  <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FEF2F2" />
  <SolidColorBrush x:Key="Brush.Success" Color="#16A34A" />
  <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#E9F8EF" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#F59E0B" />
  <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FFF7E6" />
  <SolidColorBrush x:Key="Brush.Purple" Color="#7C3AED" />
  <SolidColorBrush x:Key="Brush.Teal" Color="#0D9488" />

  <!-- Chart series, in order (payment split, future charts). -->
  <SolidColorBrush x:Key="Brush.Chart.0" Color="#078B45" />
  <SolidColorBrush x:Key="Brush.Chart.1" Color="#2563EB" />
  <SolidColorBrush x:Key="Brush.Chart.2" Color="#F59E0B" />
  <SolidColorBrush x:Key="Brush.Chart.3" Color="#7C3AED" />
  <SolidColorBrush x:Key="Brush.Chart.4" Color="#0D9488" />
  <SolidColorBrush x:Key="Brush.Chart.5" Color="#E11D48" />

  <!-- Sidebar: near-black in both themes -->
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.SidebarText" Color="#344054" />
  <SolidColorBrush x:Key="Brush.SidebarTextActive" Color="#078B45" />
  <SolidColorBrush x:Key="Brush.SidebarTextMuted" Color="#98A2B3" />
  <SolidColorBrush x:Key="Brush.SidebarHover" Color="#F1F5F9" />
  <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#E9F8EF" />
  <SolidColorBrush x:Key="Brush.SidebarAccent" Color="#078B45" />
  <SolidColorBrush x:Key="Brush.SidebarDivider" Color="#E3E8EF" />

  <!-- Table and ticket states. Same meaning as before; shades chosen so white text on them meets WCAG AA (4.5:1). -->
  <SolidColorBrush x:Key="Brush.Status.Available" Color="#047857" />
  <SolidColorBrush x:Key="Brush.Status.Occupied" Color="#2563EB" />
  <SolidColorBrush x:Key="Brush.Status.Ordering" Color="#7C3AED" />
  <SolidColorBrush x:Key="Brush.Status.Preparing" Color="#B45309" />
  <SolidColorBrush x:Key="Brush.Status.Ready" Color="#DC2626" />
  <SolidColorBrush x:Key="Brush.Status.Billing" Color="#0F766E" />
  <SolidColorBrush x:Key="Brush.Status.OutOfService" Color="#71717A" />

  <!-- Elevation: only floating layers (dialogs, menus, toasts) cast a shadow; cards stay flat so busy screens
       (kitchen tickets, table map) render cheaply on low-end tablets. -->
  <DropShadowEffect x:Key="Shadow.Popup" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.10" Color="#000000" />

</ResourceDictionary>
