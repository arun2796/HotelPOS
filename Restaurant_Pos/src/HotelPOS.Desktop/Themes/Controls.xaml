<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls">

  <!-- HotelPOS building blocks (Phase 11.3): templates for the controls in Controls/. Colours and sizes come from the
       token and density dictionaries, like DesignSystem.xaml. -->

  <!-- ============================ EmptyState ============================ -->
  <Style TargetType="controls:EmptyState">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="24" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:EmptyState">
          <StackPanel MaxWidth="380">
            <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Background="{DynamicResource Brush.SurfaceSubtle}">
              <TextBlock Text="{TemplateBinding Glyph}" Style="{StaticResource Text.Icon}" FontSize="22" HorizontalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
            </Border>
            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.Subtitle}" TextAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="{TemplateBinding Message}" Style="{StaticResource Text.Caption}" TextAlignment="Center" Margin="0,6,0,0" />
            <ContentPresenter HorizontalAlignment="Center" Margin="0,16,0,0" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ KpiTile / KpiStrip ============================ -->
  <Style TargetType="controls:KpiTile">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,16,16" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:KpiTile">
          <Border x:Name="Root" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Card}" Padding="20" MinHeight="116" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{TemplateBinding Title}" FontSize="{DynamicResource Font.Size.Label}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock Text="{TemplateBinding Value}" FontSize="30" FontWeight="Bold" Margin="0,6,0,2"
                           Foreground="{DynamicResource Brush.TextPrimary}" Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="{TemplateBinding Detail}" Style="{StaticResource Text.Caption}" />
              </StackPanel>
              <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top"
                      Background="{DynamicResource Brush.PrimarySoft}">
                <TextBlock Text="{TemplateBinding Glyph}" Style="{StaticResource Text.Icon}" FontSize="18" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Primary}" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            </Trigger>
            <Trigger Property="Command" Value="{x:Null}">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:KpiStrip">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,0,-16,0" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=controls:KpiStrip}}" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ BusyOverlay ============================ -->
  <Style TargetType="controls:BusyOverlay">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:BusyOverlay">
          <Grid>
            <ContentPresenter />
            <Grid x:Name="Layer" Visibility="Collapsed" Opacity="0">
              <Border Background="{DynamicResource Brush.Surface}" Opacity="0.7" CornerRadius="{StaticResource Radius.Card}" />
              <Border Style="{StaticResource Card}" Padding="20,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Width="180">
                  <TextBlock Text="{TemplateBinding Message}" Style="{StaticResource Text.Body}" TextAlignment="Center" />
                  <ProgressBar IsIndeterminate="{TemplateBinding IsBusy}" Margin="0,12,0,0" />
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsBusy" Value="True">
              <Setter TargetName="Layer" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Show">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Layer" Storyboard.TargetProperty="Opacity" To="1"
                                     BeginTime="0:0:0.25" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Show" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ PageHeader ============================ -->
  <Style TargetType="controls:PageHeader">
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:PageHeader">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.Title}" />
              <TextBlock x:Name="Description" Text="{TemplateBinding Description}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Description" Value="">
              <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ ReportFilterBar ============================ -->
  <Style TargetType="controls:ReportFilterBar">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ReportFilterBar">
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Card}" Padding="12">
            <!-- Filters wrap onto more lines when the page is narrow; the screen's actions stay at the right. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <WrapPanel VerticalAlignment="Center" Margin="0,0,0,-8">
                <StackPanel x:Name="Range" Orientation="Horizontal" Margin="0,0,12,8">
                  <ComboBox x:Name="PresetBox" ItemsSource="{TemplateBinding Presets}" Width="170"
                            SelectedItem="{Binding SelectedPreset, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            AutomationProperties.Name="Period">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource Humanize}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Margin="8,0,0,0" IsEnabled="{TemplateBinding IsCustomRange}">
                    <DatePicker Width="150" AutomationProperties.Name="From"
                                SelectedDate="{Binding FromDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                    <TextBlock Text="to" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0" />
                    <DatePicker Width="150" AutomationProperties.Name="To"
                                SelectedDate="{Binding ToDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                  </StackPanel>
                </StackPanel>
                <ContentPresenter Content="{TemplateBinding Filters}" VerticalAlignment="Center" Margin="0,0,12,8" />
                <TextBox x:Name="Search" Width="220" Margin="0,0,12,8" MaxLength="100"
                         Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="{TemplateBinding SearchHint}" AutomationProperties.Name="{TemplateBinding SearchHint}" />
                <Button x:Name="Run" Content="{TemplateBinding RunText}" Command="{TemplateBinding RunCommand}"
                        Style="{StaticResource Button.Primary}" MinWidth="90" Margin="0,0,0,8" />
              </WrapPanel>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ShowRange" Value="False">
              <Setter TargetName="Range" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Presets" Value="{x:Null}">
              <Setter TargetName="PresetBox" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ShowSearch" Value="False">
              <Setter TargetName="Search" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="RunCommand" Value="{x:Null}">
              <Setter TargetName="Run" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Charts ============================ -->
  <!-- Fill of a chart shape or legend dot from its item's ColorIndex (0-5). -->
  <Style x:Key="Chart.Swatch" TargetType="Shape">
    <Setter Property="Fill" Value="{DynamicResource Brush.Chart.0}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ColorIndex}" Value="1">
        <Setter Property="Fill" Value="{DynamicResource Brush.Chart.1}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ColorIndex}" Value="2">
        <Setter Property="Fill" Value="{DynamicResource Brush.Chart.2}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ColorIndex}" Value="3">
        <Setter Property="Fill" Value="{DynamicResource Brush.Chart.3}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ColorIndex}" Value="4">
        <Setter Property="Fill" Value="{DynamicResource Brush.Chart.4}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ColorIndex}" Value="5">
        <Setter Property="Fill" Value="{DynamicResource Brush.Chart.5}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- A 0..1 share drawn as a thin rounded bar (top items). -->
  <Style x:Key="Chart.ShareBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
    <Setter Property="Height" Value="6" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
  </Style>

  <!-- ============================ Hub tabs ============================ -->
  <!-- Tabs of a hub page (Menu, Sections & Tables): text tabs with an accent underline, BillingHub style. -->
  <Style x:Key="Hub.Tab" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,28,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Background="Transparent" MinHeight="{DynamicResource Size.Control}">
            <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="2,0"
                              TextElement.FontSize="{DynamicResource Font.Size.Button}" TextElement.FontWeight="SemiBold"
                              TextElement.Foreground="{DynamicResource Brush.TextSecondary}" />
            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="1" Background="{DynamicResource Brush.Primary}"
                    Visibility="Hidden" Margin="0,0,0,-1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Hub.Tabs" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Hub.Tab}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
