<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <SolidColorBrush x:Key="Brush.Background" Color="#0F172A" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#1E293B" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#243247" />
  <SolidColorBrush x:Key="Brush.Border" Color="#334155" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="#B3020617" />

  <!-- Text -->
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F1F5F9" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#94A3B8" />

  <!-- Inputs -->
  <SolidColorBrush x:Key="Brush.InputBackground" Color="#0F172A" />
  <SolidColorBrush x:Key="Brush.InputBorder" Color="#475569" />
  <SolidColorBrush x:Key="Brush.Focus" Color="#60A5FA" />

  <!-- Accents -->
  <SolidColorBrush x:Key="Brush.Primary" Color="#3B82F6" />
  <SolidColorBrush x:Key="Brush.PrimaryText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.PrimarySoft" Color="#1E3A8A" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#EF4444" />
  <SolidColorBrush x:Key="Brush.DangerSoft" Color="#450A0A" />
  <SolidColorBrush x:Key="Brush.Success" Color="#22C55E" />
  <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#052E16" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#F59E0B" />
  <SolidColorBrush x:Key="Brush.WarningSoft" Color="#451A03" />

  <!-- Sidebar -->
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#020617" />
  <SolidColorBrush x:Key="Brush.SidebarText" Color="#E2E8F0" />
  <SolidColorBrush x:Key="Brush.SidebarTextMuted" Color="#64748B" />
  <SolidColorBrush x:Key="Brush.SidebarHover" Color="#1E293B" />
  <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#2563EB" />

  <!-- Table status colours -->
  <SolidColorBrush x:Key="Brush.Status.Available" Color="#22C55E" />
  <SolidColorBrush x:Key="Brush.Status.Occupied" Color="#3B82F6" />
  <SolidColorBrush x:Key="Brush.Status.Ordering" Color="#A78BFA" />
  <SolidColorBrush x:Key="Brush.Status.Preparing" Color="#F59E0B" />
  <SolidColorBrush x:Key="Brush.Status.Ready" Color="#EF4444" />
  <SolidColorBrush x:Key="Brush.Status.Billing" Color="#2DD4BF" />
  <SolidColorBrush x:Key="Brush.Status.OutOfService" Color="#94A3B8" />

</ResourceDictionary>
