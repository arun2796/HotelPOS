<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:conv="clr-namespace:HotelPOS.Desktop.Converters">

  <!-- HotelPOS design system (Phase 11), after BillingHub's DesignSystem.xaml. Theme-independent: every colour comes
       from Tokens.Light/Dark.xaml and every size that changes with density from Density.Comfort/Compact.xaml, always
       through DynamicResource so ThemeService can swap them at runtime. The style keys below are the public names
       views use; keep them stable. -->

  <!-- ============================ Typography ============================ -->
  <!-- Phase 21: the bundled Inter (Resources/Fonts, SIL OFL) first, Segoe UI as the fallback. -->
  <FontFamily x:Key="Font.Body">/HotelPOS.Desktop;component/Resources/Fonts/#Inter, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

  <!-- ============================ Shape ============================ -->
  <CornerRadius x:Key="Radius.Input">6</CornerRadius>
  <CornerRadius x:Key="Radius.Button">8</CornerRadius>
  <CornerRadius x:Key="Radius.Card">8</CornerRadius>
  <CornerRadius x:Key="Radius.Dialog">10</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

  <!-- Neutral ramp (zinc), identical in both themes; prefer the semantic Brush.* tokens in views. -->
  <SolidColorBrush x:Key="Brush.Neutral.0" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Neutral.50" Color="#FAFAFA" />
  <SolidColorBrush x:Key="Brush.Neutral.100" Color="#F4F4F5" />
  <SolidColorBrush x:Key="Brush.Neutral.200" Color="#E4E4E7" />
  <SolidColorBrush x:Key="Brush.Neutral.300" Color="#D4D4D8" />
  <SolidColorBrush x:Key="Brush.Neutral.400" Color="#A1A1AA" />
  <SolidColorBrush x:Key="Brush.Neutral.500" Color="#71717A" />
  <SolidColorBrush x:Key="Brush.Neutral.600" Color="#52525B" />
  <SolidColorBrush x:Key="Brush.Neutral.700" Color="#3F3F46" />
  <SolidColorBrush x:Key="Brush.Neutral.800" Color="#27272A" />
  <SolidColorBrush x:Key="Brush.Neutral.900" Color="#18181B" />
  <SolidColorBrush x:Key="Brush.Neutral.950" Color="#09090B" />

  <!-- ============================ Converters ============================ -->
  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
  <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
  <conv:NullToVisibilityConverter x:Key="NullToCollapsedInverse" Invert="True" />
  <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
  <conv:InverseBoolConverter x:Key="InverseBool" />
  <conv:ListJoinConverter x:Key="ListJoin" />
  <conv:UtcToLocalConverter x:Key="UtcToLocal" />
  <conv:ActiveTextConverter x:Key="ActiveText" />
  <conv:BarHeightConverter x:Key="BarHeight" />
  <conv:ImageFileConverter x:Key="ImageFile" />
  <conv:HumanizeConverter x:Key="Humanize" />

  <!-- Keyboard focus ring: shown only when focus arrives from the keyboard, never after a click or tap. -->
  <Style x:Key="Focus.Visual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Brush.Focus}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Text ============================ -->
  <Style x:Key="Text.Display" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Text.Title" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Text.Subtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Text.Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Label}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style x:Key="Text.Error" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- Money and quantities: tabular figures so columns of amounts line up. -->
  <Style x:Key="Text.Amount" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <Style x:Key="Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ============================ Surfaces ============================ -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
  </Style>

  <Style x:Key="Banner.Base" TargetType="Border">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style x:Key="Banner.Error" TargetType="Border" BasedOn="{StaticResource Banner.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
  </Style>
  <Style x:Key="Banner.Info" TargetType="Border" BasedOn="{StaticResource Banner.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
  </Style>
  <Style x:Key="Banner.Success" TargetType="Border" BasedOn="{StaticResource Banner.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
  </Style>
  <Style x:Key="Banner.Warning" TargetType="Border" BasedOn="{StaticResource Banner.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
  </Style>

  <Style x:Key="Pill.Base" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
    <Setter Property="TextElement.FontSize" Value="12" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style x:Key="Pill.Success" TargetType="Border" BasedOn="{StaticResource Pill.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.SuccessText}" />
  </Style>
  <Style x:Key="Pill.Warning" TargetType="Border" BasedOn="{StaticResource Pill.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.WarningText}" />
  </Style>
  <Style x:Key="Pill.Danger" TargetType="Border" BasedOn="{StaticResource Pill.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.DangerText}" />
  </Style>
  <Style x:Key="Pill.Info" TargetType="Border" BasedOn="{StaticResource Pill.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.InfoText}" />
  </Style>
  <Style x:Key="Pill.Neutral" TargetType="Border" BasedOn="{StaticResource Pill.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.NeutralSoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.NeutralText}" />
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Buttons ============================ -->
  <!-- One template for every button. Hover and press draw a translucent layer over the button's own background, so
       a view can give a button any colour (pay, ticket, table buttons) and still get the same feedback. -->
  <Style x:Key="Button.Base" TargetType="Button">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Button}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="MinWidth" Value="{DynamicResource Size.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Button}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Button}" />
            <Border x:Name="State" CornerRadius="{StaticResource Radius.Button}" Background="Transparent" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="State" Property="Background" Value="{DynamicResource Brush.HoverOverlay}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="State" Property="Background" Value="{DynamicResource Brush.PressedOverlay}" />
              <Setter TargetName="Root" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource Button.Base}" />

  <!-- Secondary: grey outline on a transparent fill (Cancel, Back, Print). -->
  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}" />
  </Style>

  <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}" />
  </Style>

  <!-- Primary outline: the quieter green action (Start, Recall) next to a filled one. -->
  <Style x:Key="Button.PrimaryOutline" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
  </Style>

  <!-- Warning: the orange "Mark ready" / "Request bill" action. Dark text: white on #F59E0B is only 2:1. -->
  <Style x:Key="Button.Warning" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnWarning}" />
  </Style>

  <!-- Large: the 56 px touch size (pay, send to kitchen) in the primary fill; the cashier screens run Compact density, so
       the payment buttons ask for it explicitly. Use Button.Large.Outline / Button.Large.Warning for the other fills. -->
  <Style x:Key="Button.Large" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Padding" Value="24,12" />
  </Style>
  <Style x:Key="Button.Large.Outline" TargetType="Button" BasedOn="{StaticResource Button.PrimaryOutline}">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Padding" Value="24,12" />
  </Style>
  <Style x:Key="Button.Large.Warning" TargetType="Button" BasedOn="{StaticResource Button.Warning}">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Padding" Value="24,12" />
  </Style>

  <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- Square icon-only button. Give it a ToolTip: the tooltip is its accessible name. -->
  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Width" Value="{DynamicResource Size.Control}" />
    <Setter Property="Height" Value="{DynamicResource Size.Control}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}, TargetNullValue=''}" />
  </Style>

  <Style x:Key="Button.Link" TargetType="Button">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Link}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.HoverOverlay}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PressedOverlay}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Scrolling ============================ -->
  <!-- Empty on purpose: replaces MaterialDesign's implicit ScrollViewer style (which pads and re-templates every
       scroll area, including the text host inside each TextBox) with WPF's standard one. -->
  <Style TargetType="ScrollViewer" />

  <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Pill}" Margin="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.TextTertiary}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.TextSecondary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="{DynamicResource Size.ScrollBar}" />
    <Setter Property="MinWidth" Value="{DynamicResource Size.ScrollBar}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollBar.Thumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="{DynamicResource Size.ScrollBar}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.ScrollBar}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================ Text inputs ============================ -->
  <!-- Placeholder text: md:HintAssist.Hint="e.g. WAITER-01" on a TextBox, ComboBox or DatePicker. -->
  <Style TargetType="TextBox">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Input}"
                  SnapsToDevicePixels="True">
            <!-- The text host applies the TextBox's Padding itself; only the placeholder needs it from the template. -->
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
              <Border x:Name="PlaceholderHost" Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                <ContentPresenter x:Name="Placeholder"
                                  Content="{TemplateBinding md:HintAssist.Hint}"
                                  TextElement.Foreground="{DynamicResource Brush.TextTertiary}"
                                  Margin="2,0,0,0"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Visibility="Collapsed" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="AcceptsReturn" Value="True">
              <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch" />
              <Setter TargetName="PART_ContentHost" Property="VerticalScrollBarVisibility" Value="Auto" />
              <Setter TargetName="PART_ContentHost" Property="Margin" Value="0,10" />
              <Setter TargetName="Placeholder" Property="VerticalAlignment" Value="Top" />
              <Setter TargetName="Placeholder" Property="Margin" Value="2,10,0,0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputBackgroundFocus}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Input}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputBackgroundFocus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ ComboBox ============================ -->
  <!-- The toggle covers the whole field, so a click anywhere opens the list; the chevron sits at the right. -->
  <Style x:Key="ComboBox.Toggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <Path x:Name="Chevron" Width="10" Height="6" Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Data="M 0,0 L 5,5 L 10,0" Stretch="None" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{DynamicResource Brush.TextSecondary}" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform>
                <RotateTransform />
              </Path.RenderTransform>
            </Path>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chevron" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="180" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Input}" />
            <ToggleButton Style="{StaticResource ComboBox.Toggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter x:Name="ContentSite"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left" />
            <ContentPresenter x:Name="Placeholder"
                       Content="{TemplateBinding md:HintAssist.Hint}"
                       TextElement.Foreground="{DynamicResource Brush.TextTertiary}"
                       Margin="{TemplateBinding Padding}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />
            <TextBox x:Name="PART_EditableTextBox"
                     Style="{x:Null}"
                     Margin="{TemplateBinding Padding}"
                     Padding="0"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="{TemplateBinding FontSize}"
                     Foreground="{TemplateBinding Foreground}"
                     CaretBrush="{TemplateBinding Foreground}"
                     IsReadOnly="{TemplateBinding IsReadOnly}"
                     VerticalAlignment="Center"
                     Visibility="Hidden" />
            <Popup x:Name="PART_Popup"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade">
              <Grid Margin="0,4,12,12"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <!-- Shadow on its own layer, so the list text is not rasterised through the effect. -->
                <Border CornerRadius="8" Background="{DynamicResource Brush.Surface}" Effect="{DynamicResource Shadow.Popup}" />
                <Border Padding="4"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <ScrollViewer SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SelectedItem" Value="{x:Null}">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
              <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_EditableTextBox" Property="Margin" Value="12,0,32,0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputBackgroundFocus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.ListItem}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.LayerHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ DatePicker ============================ -->
  <Style TargetType="DatePickerTextBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePickerTextBox">
          <Grid>
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            <ContentControl x:Name="PART_Watermark" Opacity="0" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DatePicker">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Root" Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Input}" />
            <DatePickerTextBox x:Name="PART_TextBox"
                               Margin="{TemplateBinding Padding}"
                               FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               VerticalAlignment="Center"
                               Focusable="{TemplateBinding Focusable}" />
            <ContentPresenter x:Name="Placeholder"
                       Content="{TemplateBinding md:HintAssist.Hint}"
                       TextElement.Foreground="{DynamicResource Brush.TextTertiary}"
                       Margin="{TemplateBinding Padding}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />
            <Button x:Name="PART_Button" Grid.Column="1" Style="{x:Null}" Width="36" Margin="0,4,4,4" Focusable="False" Cursor="Hand">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.LayerHover}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SelectedDate" Value="{x:Null}">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputBackgroundFocus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ CheckBox ============================ -->
  <Style TargetType="CheckBox">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Box"
                    Width="{DynamicResource Size.CheckBox}" Height="{DynamicResource Size.CheckBox}"
                    CornerRadius="5" BorderThickness="1.5"
                    BorderBrush="{DynamicResource Brush.BorderStrong}"
                    Background="{DynamicResource Brush.Surface}"
                    VerticalAlignment="Center">
              <Viewbox Margin="2">
                <Path x:Name="Check" Width="16" Height="16" Data="M 3,8.5 L 6.5,12 L 13,4.5" Stroke="White" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Hidden" />
              </Viewbox>
            </Border>
            <ContentPresenter x:Name="Content" Grid.Column="1" Margin="10,0,0,0"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="False">
              <Setter TargetName="Content" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Progress ============================ -->
  <!-- Thin bar. Indeterminate runs a sliding segment instead of a static full bar. -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2">
            <Grid ClipToBounds="True">
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}" />
              <Border x:Name="Runner" Width="120" HorizontalAlignment="Left" CornerRadius="2"
                      Background="{TemplateBinding Foreground}" Visibility="Collapsed">
                <Border.RenderTransform>
                  <TranslateTransform X="-120" />
                </Border.RenderTransform>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Run">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Runner"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-120" To="1400" Duration="0:0:1.6" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Run" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Lists and tooltips ============================ -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="{DynamicResource Padding.ListItem}" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.ListItem}" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.LayerHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Inverted tooltip (dark on light theme, light on dark) so it never blends into the surface below. -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Background}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="0,0,8,8"
                  MaxWidth="360" TextElement.Foreground="{TemplateBinding Foreground}">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ DataGrid ============================ -->
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="RowBackground" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.SurfaceAlt}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeaderWidth" Value="0" />
    <Setter Property="RowHeight" Value="{DynamicResource Size.GridRow}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="EnableRowVirtualization" Value="True" />
  </Style>

  <Style x:Key="DataGrid.HeaderGripper" TargetType="Thumb">
    <Setter Property="Width" Value="8" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.GridHeader}" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.GridHeader}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Cell}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" />
                <Path x:Name="SortArrow" Grid.Column="1" Width="8" Height="5" Margin="6,0,0,0" VerticalAlignment="Center"
                      Data="M 0,5 L 4,0 L 8,5 Z" Fill="{TemplateBinding Foreground}" Stretch="Fill"
                      RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" />
              </Grid>
            </Border>
            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource DataGrid.HeaderGripper}" />
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource DataGrid.HeaderGripper}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SortDirection" Value="Ascending">
              <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="SortDirection" Value="Descending">
              <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
              <Setter TargetName="SortArrow" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="180" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Numeric columns: right-aligned header and cells with tabular figures (DataGridTextColumn ElementStyle). -->
  <Style x:Key="DataGrid.NumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>
  <Style x:Key="Text.GridNumber" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <!-- A text column that may not fit: ends in an ellipsis and shows the whole value as a tooltip. -->
  <Style x:Key="Text.GridTrim" TargetType="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
  </Style>

  <!-- Row hover and selection live on the row (style triggers win over the grid's row/alternating backgrounds). -->
  <Style TargetType="DataGridRow">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.LayerHover}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="{DynamicResource Padding.Cell}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================ Restaurant controls ============================ -->
  <!-- Table tile on the floor map and the admin dashboard (Phase 21): soft tone fill, a tone border, the table code at 22 px,
       then status icon + label (+ order number), guests and the running timer. Ready is the one solid tile (a check and the
       word "Ready" keep it apart from Available). The tone follows the table's Status, so the colours are the same on every
       terminal; the selected table gets a thicker, dark ring. The view's DataTemplate lays the content out. -->
  <Style x:Key="TableTile" TargetType="Button">
    <Setter Property="Width" Value="156" />
    <Setter Property="Height" Value="120" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessText}" />
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Available}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Card}" />
            <Border x:Name="State" Background="Transparent" CornerRadius="{StaticResource Radius.Card}" />
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Card}" Padding="12,8">
              <ContentPresenter />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="State" Property="Background" Value="{DynamicResource Brush.HoverOverlay}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="State" Property="Background" Value="{DynamicResource Brush.PressedOverlay}" />
              <Setter TargetName="Root" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="Occupied">
        <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Occupied}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.InfoText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Ordering">
        <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Ordering}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.InfoText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Preparing">
        <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Preparing}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Ready">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.Ready}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Ready}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Billing">
        <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Billing}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="OutOfService">
        <Setter Property="Background" Value="{DynamicResource Brush.NeutralSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.OutOfService}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.NeutralText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="3" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Status of a table as a badge (table details header): soft tone fill and tone text, Ready solid. -->
  <Style x:Key="TableStatusBadge" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.SuccessText}" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="Occupied">
        <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.InfoText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Ordering">
        <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.InfoText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Preparing">
        <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.WarningText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Ready">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.Ready}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PrimaryText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Billing">
        <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.WarningText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="OutOfService">
        <Setter Property="Background" Value="{DynamicResource Brush.NeutralSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.NeutralText}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="LegendDot" TargetType="Border">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Margin" Value="16,0,6,0" />
  </Style>

  <!-- Filter / tab chips (categories, sections, report tabs). -->
  <Style x:Key="Chip" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Root" CornerRadius="{StaticResource Radius.Pill}" Padding="16,0" MinHeight="{DynamicResource Size.Control}"
                  Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  TextElement.Foreground="{DynamicResource Brush.TextSecondary}" TextElement.FontSize="{DynamicResource Font.Size.Button}"
                  TextElement.FontWeight="SemiBold" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.LayerHover}" />
              <Setter TargetName="Root" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Root" Property="TextElement.Foreground" Value="{DynamicResource Brush.PrimaryText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ChipList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Chip}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NumPadKey" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Height" Value="52" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- ============================ Sidebar navigation ============================ -->
  <Style x:Key="NavList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,0,0,8" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
    <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
  </Style>

  <!-- Sidebar item (Phase 21): group header (and a divider above every group but the first) on the first item of a group; the selected
       item is a filled primary pill with white text, hover is a lighter navy; a count badge (SidebarBadge) on items that have a count.
       A module with ShowInNav = false is collapsed (still selectable by the shell, never shown). -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <StackPanel>
            <Border x:Name="GroupDivider" Height="1" Margin="18,12,18,0" Background="{DynamicResource Brush.SidebarDivider}"
                    Visibility="{Binding ShowGroupDivider, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="GroupHeader" Text="{Binding Group}"
                       Visibility="{Binding ShowGroupHeader, Converter={StaticResource BoolToVisibility}}"
                       Margin="22,14,12,6"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.SidebarTextMuted}" />
            <Grid Margin="10,1">
              <Border x:Name="Root" CornerRadius="8" Padding="12,0" Height="{DynamicResource Size.NavItem}" Background="Transparent">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="16"
                             Foreground="{DynamicResource Brush.SidebarText}" />
                  <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Title}" Margin="8,0,0,0"
                             FontSize="{DynamicResource Font.Size.Body}" FontWeight="Medium"
                             Foreground="{DynamicResource Brush.SidebarText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Border x:Name="Soon" Grid.Column="2" CornerRadius="4" Padding="6,1" Background="{DynamicResource Brush.SidebarHover}" VerticalAlignment="Center"
                          Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="Soon" FontSize="10" Foreground="{DynamicResource Brush.SidebarTextMuted}" />
                  </Border>
                  <Border x:Name="Badge" Grid.Column="2" CornerRadius="9" MinWidth="20" Height="18" Padding="5,0" VerticalAlignment="Center"
                          Background="{DynamicResource Brush.SidebarBadge}"
                          Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.SidebarTextActive}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SidebarHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SidebarSelected}" />
              <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.SidebarTextActive}" />
              <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.SidebarTextActive}" />
            </Trigger>
            <!-- Collapsed sidebar: icons only (the divider still marks where a group starts); the badge sits on the icon's corner. -->
            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
              <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Soon" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Badge" Property="Grid.Column" Value="0" />
              <Setter TargetName="Badge" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Badge" Property="VerticalAlignment" Value="Top" />
              <Setter TargetName="Badge" Property="Margin" Value="0,-6,-12,0" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding ShowInNav}" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
        <Setter Property="ToolTip" Value="{Binding Title}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
