<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark theme tokens. Same keys as Tokens.Light.xaml. Fills that carry white text (primary, danger, status)
       stay dark enough for WCAG AA; colours used as text on dark surfaces (link, danger text) are lighter. -->

  <!-- Surfaces and layers -->
  <SolidColorBrush x:Key="Brush.Background" Color="#0A0A0B" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#111113" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#151518" />
  <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="#18181B" />
  <SolidColorBrush x:Key="Brush.LayerHover" Color="#1F1F23" />
  <SolidColorBrush x:Key="Brush.LayerPressed" Color="#27272A" />
  <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="Brush.PressedOverlay" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="#B3000000" />

  <!-- Borders -->
  <SolidColorBrush x:Key="Brush.Border" Color="#27272A" />
  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#1F1F23" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#3F3F46" />

  <!-- Text -->
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FAFAFA" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A1A1AA" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="#71717A" />

  <!-- Inputs -->
  <SolidColorBrush x:Key="Brush.InputBackground" Color="#1E1E23" />
  <SolidColorBrush x:Key="Brush.InputBackgroundFocus" Color="#111113" />
  <SolidColorBrush x:Key="Brush.InputBorder" Color="#2E2E34" />
  <SolidColorBrush x:Key="Brush.Focus" Color="#60A5FA" />

  <!-- Accent and semantic colours -->
  <SolidColorBrush x:Key="Brush.Primary" Color="#2E6FF0" />
  <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#2563EB" />
  <SolidColorBrush x:Key="Brush.PrimaryText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.PrimarySoft" Color="#172554" />
  <SolidColorBrush x:Key="Brush.Link" Color="#60A5FA" />
  <SolidColorBrush x:Key="Brush.Info" Color="#60A5FA" />
  <SolidColorBrush x:Key="Brush.InfoSoft" Color="#0B1E3F" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#E11D48" />
  <SolidColorBrush x:Key="Brush.DangerText" Color="#FB7185" />
  <SolidColorBrush x:Key="Brush.DangerSoft" Color="#2B0A10" />
  <SolidColorBrush x:Key="Brush.Success" Color="#10B981" />
  <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#052E1F" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#F59E0B" />
  <SolidColorBrush x:Key="Brush.WarningSoft" Color="#2B1A05" />
  <SolidColorBrush x:Key="Brush.Purple" Color="#A78BFA" />
  <SolidColorBrush x:Key="Brush.Teal" Color="#2DD4BF" />

  <!-- Sidebar -->
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#0E0E10" />
  <SolidColorBrush x:Key="Brush.SidebarText" Color="#D4D4D8" />
  <SolidColorBrush x:Key="Brush.SidebarTextActive" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.SidebarTextMuted" Color="#82828C" />
  <SolidColorBrush x:Key="Brush.SidebarHover" Color="#1A1A1E" />
  <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#27272A" />
  <SolidColorBrush x:Key="Brush.SidebarAccent" Color="#3B82F6" />
  <SolidColorBrush x:Key="Brush.SidebarDivider" Color="#1F1F23" />

  <!-- Table and ticket states: identical to light so a colour means the same thing on every terminal. -->
  <SolidColorBrush x:Key="Brush.Status.Available" Color="#047857" />
  <SolidColorBrush x:Key="Brush.Status.Occupied" Color="#2563EB" />
  <SolidColorBrush x:Key="Brush.Status.Ordering" Color="#7C3AED" />
  <SolidColorBrush x:Key="Brush.Status.Preparing" Color="#B45309" />
  <SolidColorBrush x:Key="Brush.Status.Ready" Color="#DC2626" />
  <SolidColorBrush x:Key="Brush.Status.Billing" Color="#0F766E" />
  <SolidColorBrush x:Key="Brush.Status.OutOfService" Color="#71717A" />

  <DropShadowEffect x:Key="Shadow.Popup" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />

</ResourceDictionary>
