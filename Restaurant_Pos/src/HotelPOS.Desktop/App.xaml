<Application x:Class="HotelPOS.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:shell="clr-namespace:HotelPOS.Desktop.Shell"
             xmlns:config="clr-namespace:HotelPOS.Desktop.Modules.Config"
             xmlns:auth="clr-namespace:HotelPOS.Desktop.Modules.Auth"
             xmlns:common="clr-namespace:HotelPOS.Desktop.Modules.Common"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin"
             xmlns:tables="clr-namespace:HotelPOS.Desktop.Modules.Tables"
             xmlns:menuadmin="clr-namespace:HotelPOS.Desktop.Modules.MenuAdmin"
             xmlns:orders="clr-namespace:HotelPOS.Desktop.Modules.Orders"
             xmlns:kitchen="clr-namespace:HotelPOS.Desktop.Modules.Kitchen"
             xmlns:billing="clr-namespace:HotelPOS.Desktop.Modules.Billing"
             xmlns:cash="clr-namespace:HotelPOS.Desktop.Modules.Cash"
             xmlns:gst="clr-namespace:HotelPOS.Desktop.Modules.Gst"
             xmlns:customers="clr-namespace:HotelPOS.Desktop.Modules.Customers"
             xmlns:licensing="clr-namespace:HotelPOS.Desktop.Modules.Licensing"
             xmlns:printing="clr-namespace:HotelPOS.Desktop.Modules.Printing"
             xmlns:dashboard="clr-namespace:HotelPOS.Desktop.Modules.Dashboard"
             xmlns:reports="clr-namespace:HotelPOS.Desktop.Modules.Reports"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- MaterialDesign base: its palette in our accent (so its controls never have undefined brushes), then its
             control defaults. Our design system below overrides the controls we use. -->
        <md:CustomColorTheme BaseTheme="Light" PrimaryColor="#2563EB" SecondaryColor="#2563EB" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
        <!-- Swapped at runtime by ThemeService: Tokens.Light / Tokens.Dark and Density.Comfort / Density.Compact. -->
        <ResourceDictionary Source="Themes/Tokens.Light.xaml" />
        <ResourceDictionary Source="Themes/Density.Compact.xaml" />
        <ResourceDictionary Source="Themes/DesignSystem.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate DataType="{x:Type config:ConfigurationViewModel}">
        <config:ConfigurationView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type auth:UpdateRequiredViewModel}">
        <auth:UpdateRequiredView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type auth:LoginViewModel}">
        <auth:LoginView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type auth:ChangePasswordViewModel}">
        <auth:ChangePasswordView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type shell:ShellViewModel}">
        <shell:ShellView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type common:PlaceholderViewModel}">
        <common:PlaceholderView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type customers:CustomersViewModel}">
        <customers:CustomersView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type admin:UsersViewModel}">
        <admin:UsersView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type admin:RolesViewModel}">
        <admin:RolesView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type admin:DevicesViewModel}">
        <admin:DevicesView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type admin:BackupViewModel}">
        <admin:BackupView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type admin:ServerViewModel}">
        <admin:ServerView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type admin:AuditLogsViewModel}">
        <admin:AuditLogsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type admin:SettingsViewModel}">
        <admin:SettingsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type admin:SettingsHubViewModel}">
        <admin:SettingsHubView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type admin:FloorViewModel}">
        <admin:FloorView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type tables:TableMapViewModel}">
        <tables:TableMapView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type menuadmin:MenuAdminViewModel}">
        <menuadmin:MenuAdminView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type orders:OrderBuilderViewModel}">
        <orders:OrderBuilderView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type orders:MyOrdersViewModel}">
        <orders:OrderListView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type kitchen:KitchenDisplayViewModel}">
        <kitchen:KitchenDisplayView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type kitchen:CompletedOrdersViewModel}">
        <kitchen:CompletedOrdersView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type billing:BillingQueueViewModel}">
        <billing:BillingQueueView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type billing:BillDetailViewModel}">
        <billing:BillDetailView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type billing:ClosedBillsViewModel}">
        <billing:ClosedBillsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type billing:BillingSetupViewModel}">
        <billing:BillingSetupView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type cash:CashierHomeViewModel}">
        <cash:CashierHomeView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type cash:ShiftsViewModel}">
        <cash:ShiftsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type cash:DayEndViewModel}">
        <cash:DayEndView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type cash:DayEndHistoryViewModel}">
        <cash:DayEndHistoryView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type gst:GstHubViewModel}">
        <gst:GstHubView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type licensing:LicenseViewModel}">
        <licensing:LicenseView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type licensing:ImportWizardViewModel}">
        <licensing:ImportWizardView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type gst:PeriodCloseViewModel}">
        <gst:PeriodCloseView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type cash:ShiftCountPanelViewModel}">
        <cash:ShiftCountPanelView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type cash:CashMovementPanelViewModel}">
        <cash:CashMovementPanelView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type cash:ShiftReportPanelViewModel}">
        <cash:ShiftReportPanelView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type printing:PrinterSettingsViewModel}">
        <printing:PrinterSettingsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type printing:PrintPreviewViewModel}">
        <printing:PrintPreviewView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
        <dashboard:DashboardView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type reports:ReportsViewModel}">
        <reports:ReportsView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
