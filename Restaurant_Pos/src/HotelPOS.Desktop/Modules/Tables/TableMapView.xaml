<UserControl x:Class="HotelPOS.Desktop.Modules.Tables.TableMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tables="clr-namespace:HotelPOS.Desktop.Modules.Tables"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tables:TableMapViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- wraps to a second line when the details panel narrows the map, instead of clipping the last button -->
    <WrapPanel Margin="0,0,0,8">
      <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Margin="0,0,16,0">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type tables:SectionFilter}">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" FontSize="14"
                   VerticalAlignment="Top" Margin="16,13,16,0" TextTrimming="CharacterEllipsis" MaxWidth="260" />
        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}"
                 Margin="0,0,16,0" AutomationProperties.Name="List or map view" ToolTip="Show the tables as a list or on the floor plan" />
      </StackPanel>
      <Button Command="{Binding NewTakeawayOrderCommand}" ToolTip="Start takeaway order" VerticalAlignment="Top" Margin="0,0,8,0"
              Visibility="{Binding CanTakeOrders, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <controls:Icon Kind="shopping-bag" Width="14" Height="14" Margin="0,0,6,0" />
          <TextBlock Text="Takeaway" />
        </StackPanel>
      </Button>
      <Button Command="{Binding NewDeliveryOrderCommand}" ToolTip="Start delivery order" VerticalAlignment="Top" Margin="0,0,8,0"
              Visibility="{Binding CanTakeOrders, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <controls:Icon Kind="truck" Width="14" Height="14" Margin="0,0,6,0" />
          <TextBlock Text="Delivery" />
        </StackPanel>
      </Button>
      <Button Command="{Binding RefreshMapCommand}" ToolTip="Reload from the server" VerticalAlignment="Top">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>
    </WrapPanel>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <Grid Grid.Row="2">
      <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type tables:TableMapSectionViewModel}">
              <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,10" />
                <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left" MaxHeight="520"
                         Visibility="{Binding UseCanvas, Converter={StaticResource BoolToVisibility}}">
                  <Border Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" BorderBrush="{DynamicResource Brush.Border}"
                          BorderThickness="1" CornerRadius="8" Background="{DynamicResource Brush.Surface}">
                    <ItemsControl ItemsSource="{Binding PlacedTables}" Focusable="False" AutomationProperties.Name="Floor plan">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                          <Setter Property="Canvas.Left" Value="{Binding PlanX}" />
                          <Setter Property="Canvas.Top" Value="{Binding PlanY}" />
                        </Style>
                      </ItemsControl.ItemContainerStyle>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type tables:TableTileViewModel}">
                          <Button Style="{StaticResource FloorTileButton}" Width="{Binding PlanWidth}" Height="{Binding PlanHeight}"
                                  controls:FloorTile.Angle="{Binding RotationAngle}"
                                  Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" AutomationProperties.Name="{Binding Code}">
                            <Grid>
                              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Code}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding StatusLine}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding GuestsText}" FontSize="12" HorizontalAlignment="Center" Opacity="0.9" />
                              </StackPanel>
                              <controls:Icon Kind="calendar" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Foreground="{DynamicResource Brush.Primary}" ToolTip="{Binding ReservationText}"
                                             Visibility="{Binding HasUpcomingReservation, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </Viewbox>
                <ItemsControl ItemsSource="{Binding Tables}" Focusable="False"
                              Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type tables:TableTileViewModel}">
                      <Button Style="{StaticResource TableTile}"
                              Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Code}">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Text="{Binding Code}" FontSize="22" FontWeight="Bold" />
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"
                                      Visibility="{Binding ElapsedText, Converter={StaticResource StringToVisibility}}">
                            <controls:Icon Kind="clock" Width="12" Height="12" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding ElapsedText}" FontSize="12" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                          </StackPanel>
                          <Border Grid.Row="1" Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,2"
                                  Visibility="{Binding HasUpcomingReservation, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                              <controls:Icon Kind="calendar" Width="12" Height="12" Margin="0,0,4,0" Foreground="{DynamicResource Brush.Primary}" />
                              <TextBlock Text="{Binding ReservationText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Border>
                          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,2">
                            <controls:Icon Kind="{Binding StatusIcon}" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding StatusLine}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Row="3" Text="{Binding GuestsText}" FontSize="12" Opacity="0.9" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <controls:EmptyState Glyph="&#xE80A;" Title="No tables yet"
                           Message="An administrator or manager can add sections and tables under Sections &amp; Tables."
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

      <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="Legend:" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.Available}" />
      <TextBlock Text="Available" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.Occupied}" />
      <TextBlock Text="Occupied" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.Ordering}" />
      <TextBlock Text="Ordering" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.Preparing}" />
      <TextBlock Text="Preparing" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.Ready}" />
      <TextBlock Text="Ready" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.BillingFluor}" />
      <TextBlock Text="Billing" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.OutOfService}" />
      <TextBlock Text="Out of service" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
    </WrapPanel>

    <tables:TableDetailsView Grid.Column="1" Grid.RowSpan="4" Width="360" Margin="20,0,0,0"
                             DataContext="{Binding Details}"
                             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
