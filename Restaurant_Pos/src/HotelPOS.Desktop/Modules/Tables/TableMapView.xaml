<UserControl x:Class="HotelPOS.Desktop.Modules.Tables.TableMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tables="clr-namespace:HotelPOS.Desktop.Modules.Tables"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tables:TableMapViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Section filters + refresh -->
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type tables:SectionFilter}">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" FontSize="14"
                 VerticalAlignment="Top" Margin="16,11,16,0" />
      <Button Grid.Column="2" Command="{Binding RefreshMapCommand}" ToolTip="Reload from the server" VerticalAlignment="Top">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <!-- Map -->
    <Grid Grid.Row="2">
      <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type tables:TableMapSectionViewModel}">
              <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,10" />
                <ItemsControl ItemsSource="{Binding Tables}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type tables:TableTileViewModel}">
                      <Button Style="{StaticResource TableTile}"
                              Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Code}">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Text="{Binding Code}" FontSize="24" FontWeight="Bold" />
                          <TextBlock Text="{Binding ElapsedText}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" />
                          <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" />
                          <TextBlock Grid.Row="3" Text="{Binding GuestsText}" FontSize="12" Opacity="0.9" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="No tables yet" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" />
        <TextBlock Text="An administrator or manager can add sections and tables under Sections &amp; Tables."
                   Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}"
                   TextAlignment="Center" Margin="0,8,0,0" />
      </StackPanel>

      <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <!-- Legend -->
    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="Legend:" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.Available}" />
      <TextBlock Text="Available" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.Occupied}" />
      <TextBlock Text="Occupied" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.Ordering}" />
      <TextBlock Text="Ordering" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.Preparing}" />
      <TextBlock Text="Preparing" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.Ready}" />
      <TextBlock Text="Ready" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.Billing}" />
      <TextBlock Text="Billing" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Brush.Status.OutOfService}" />
      <TextBlock Text="Out of service" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
    </WrapPanel>

    <!-- Details panel -->
    <tables:TableDetailsView Grid.Column="1" Grid.RowSpan="4" Width="360" Margin="20,0,0,0"
                             DataContext="{Binding Details}"
                             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
