<UserControl x:Class="HotelPOS.Desktop.Modules.Tables.TableDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tables="clr-namespace:HotelPOS.Desktop.Modules.Tables"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tables:TableDetailsViewModel}"
             d:DesignWidth="360" d:DesignHeight="700">

  <Border Style="{StaticResource Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Grid>
            <TextBlock Text="{Binding Table.Code}" Style="{StaticResource Text.Display}" />
            <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding CloseCommand}" ToolTip="Close">
              <TextBlock Text="&#xE711;" Style="{StaticResource Text.Icon}" />
            </Button>
          </Grid>
          <TextBlock Text="{Binding Table.Name}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}"
                     Visibility="{Binding Table.Name, Converter={StaticResource StringToVisibility}}" />

          <Border Style="{StaticResource TableStatusBadge}" DataContext="{Binding Table}" Margin="0,12,0,16">
            <TextBlock Text="{Binding StatusText}" />
          </Border>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Section" Style="{StaticResource Text.Label}" />
            <TextBlock Grid.Column="1" Text="Guests" Style="{StaticResource Text.Label}" />
            <TextBlock Grid.Row="1" Text="{Binding Table.SectionName}" Style="{StaticResource Text.Body}" Margin="0,0,0,10" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Table.GuestsDetailText}" Style="{StaticResource Text.Body}" Margin="0,0,0,10" />
            <TextBlock Grid.Row="2" Text="Occupied since" Style="{StaticResource Text.Label}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Order" Style="{StaticResource Text.Label}" />
            <StackPanel Grid.Row="3" Orientation="Horizontal">
              <TextBlock Text="{Binding OccupiedSinceText}" Style="{StaticResource Text.Body}" />
              <TextBlock Text="{Binding Table.ElapsedText}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OrderText}" Style="{StaticResource Text.Body}" />
          </Grid>

          <StackPanel Visibility="{Binding Table.IsAvailable, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Number of guests" Style="{StaticResource Text.Label}" />
            <Border Background="{DynamicResource Brush.InputBackground}" BorderBrush="{DynamicResource Brush.InputBorder}"
                    BorderThickness="1" CornerRadius="8" Height="48" Margin="4,0,4,4">
              <TextBlock Text="{Binding GuestInput}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextPrimary}" />
            </Border>
            <ItemsControl ItemsSource="{Binding Keys}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource NumPadKey}" Content="{Binding}"
                          Command="{Binding DataContext.DigitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <UniformGrid Columns="3">
              <Button Style="{StaticResource NumPadKey}" Content="C" Command="{Binding ClearInputCommand}" ToolTip="Clear" />
              <Button Style="{StaticResource NumPadKey}" Content="0" Command="{Binding DigitCommand}" CommandParameter="0" />
              <Button Style="{StaticResource NumPadKey}" Command="{Binding BackspaceCommand}" ToolTip="Delete last digit">
                <TextBlock Text="&#xE750;" Style="{StaticResource Text.Icon}" />
              </Button>
            </UniformGrid>
          </StackPanel>

          <Border Style="{StaticResource Banner.Error}" Margin="0,12,0,0"
                  Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="1" Margin="0,16,0,0">
        <Button Content="OCCUPY" Style="{StaticResource Button.Primary}" MinHeight="56" FontSize="17"
                Command="{Binding OccupyCommand}"
                Visibility="{Binding Table.IsAvailable, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="RELEASE" MinHeight="56" FontSize="17"
                Command="{Binding ReleaseCommand}"
                Visibility="{Binding Table.IsOccupied, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
