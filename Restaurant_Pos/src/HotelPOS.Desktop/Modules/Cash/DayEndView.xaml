<UserControl x:Class="HotelPOS.Desktop.Modules.Cash.DayEndView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cash="clr-namespace:HotelPOS.Desktop.Modules.Cash"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance cash:DayEndViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <UserControl.Resources>
    <DataTemplate x:Key="Line" DataType="{x:Type cash:ReportLine}">
      <Grid Margin="0,4">
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,120,0" />
        <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" Style="{StaticResource Text.Amount}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Title="{Binding DayText}" Description="{Binding StepText}" Margin="0,0,0,12">
      <Button Content="Check again" Command="{Binding RecheckCommand}" Visibility="{Binding IsChecks, Converter={StaticResource BoolToVisibility}}" />
    </controls:PageHeader>

    <StackPanel Grid.Row="1">
      <Border Style="{StaticResource Banner.Error}" Margin="0,0,0,12" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
      </Border>
      <Border Style="{StaticResource Banner.Warning}" Margin="0,0,0,12" Visibility="{Binding IsAlreadyClosed, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <TextBlock Text="This business day is already closed. Reopen it from Day End history to change it." TextWrapping="Wrap" Margin="0,0,140,0" VerticalAlignment="Center" />
          <Button Content="Day End history" Command="{Binding OpenHistoryCommand}" Style="{StaticResource Button.Link}" HorizontalAlignment="Right" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- Step 1: checks -->
    <DockPanel Grid.Row="2" Visibility="{Binding IsChecks, Converter={StaticResource BoolToVisibility}}">
      <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <TextBlock Text="Settle each item, or override it with a reason; the overrides are kept with the close and audited."
                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,220,0" />
        <Button Content="CONTINUE" Command="{Binding ContinueCommand}" IsEnabled="{Binding CanContinue}" Style="{StaticResource Button.Primary}"
                HorizontalAlignment="Right" MinWidth="180" MinHeight="52" />
      </Grid>
      <Grid>
        <controls:EmptyState Glyph="&#xE73E;" Title="Nothing is open" Message="All orders, bills, shifts and kitchen tickets of the day are finished."
                             Visibility="{Binding HasNoBlockingItems, Converter={StaticResource BoolToVisibility}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
          <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type cash:DayEndCheckItemViewModel}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" />
                        <Border Style="{StaticResource Pill.Success}" Margin="12,0,0,0" Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Text="Overridden" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                      <StackPanel Margin="0,10,0,0" Visibility="{Binding IsEditingOverride, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Reason for the override" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding OverrideReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Reason for the override" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                      <Button Content="Open" MinHeight="{DynamicResource Size.Control}" Margin="0,0,8,0"
                              Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                      <Button Content="Override…" MinHeight="{DynamicResource Size.Control}"
                              Command="{Binding DataContext.EditOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </DockPanel>

    <!-- Step 2: summary -->
    <DockPanel Grid.Row="2" Visibility="{Binding IsSummary, Converter={StaticResource BoolToVisibility}}">
      <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <Button Content="Back" Command="{Binding BackCommand}" MinWidth="120" MinHeight="52" HorizontalAlignment="Left" />
        <TextBlock Text="Day End takes a verified backup first, then locks the day and saves the report pack."
                   Style="{StaticResource Text.Caption}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <Button Content="RUN DAY END" Command="{Binding RunCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right" MinWidth="180" MinHeight="52" />
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Sales" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Totals}" ItemTemplate="{StaticResource Line}" Focusable="False" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <StackPanel>
                <TextBlock Text="Payments by method" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Payments}" ItemTemplate="{StaticResource Line}" Focusable="False" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Shifts and variances" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Shifts}" ItemTemplate="{StaticResource Line}" Focusable="False" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <StackPanel>
                <TextBlock Text="Non-till collections" Style="{StaticResource Text.Subtitle}" />
                <TextBlock Text="Money for the day taken outside the tills, such as the owner's UPI or a cheque." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,8" />
                <ItemsControl ItemsSource="{Binding Collections}" ItemTemplate="{StaticResource Line}" Focusable="False" />
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding CollectionMethod, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Received as" />
                  <TextBox Grid.Column="1" Text="{Binding CollectionAmount, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" Margin="8,0" AutomationProperties.Name="Amount" />
                  <TextBox Grid.Column="2" Text="{Binding CollectionReference, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Reference" />
                  <Button Grid.Column="3" Content="Add" Command="{Binding AddCollectionCommand}" Margin="8,0,0,0" MinHeight="{DynamicResource Size.Control}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>

    <!-- Step 3: running -->
    <controls:BusyOverlay Grid.Row="2" IsBusy="{Binding IsRunning}" Message="Taking the backup, locking the day and saving the report pack…"
                          Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

    <!-- Step 4: done -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top"
            Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="{DynamicResource Brush.Success}" Margin="0,0,12,0" />
          <TextBlock Text="The day is closed" Style="{StaticResource Text.Title}" />
        </StackPanel>
        <TextBlock Text="Bills and payments of this business day are locked. A manager can reopen it from Day End history." Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,8,0,16" />
        <TextBlock Text="BACKUP" Style="{StaticResource Text.Label}" />
        <TextBlock Text="{Binding Result.BackupFile}" Style="{StaticResource Text.Body}" Margin="0,0,0,12" />
        <TextBlock Text="REPORT PACK" Style="{StaticResource Text.Label}" />
        <TextBlock Text="{Binding Result.PackFolder}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ResultFiles}" Style="{StaticResource Text.Caption}" Margin="0,4,0,16" />
        <Button Content="Day End history" Command="{Binding OpenHistoryCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" MinHeight="52" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
