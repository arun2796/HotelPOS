<UserControl x:Class="HotelPOS.Desktop.Modules.Cash.ShiftCountPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cash="clr-namespace:HotelPOS.Desktop.Modules.Cash"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance cash:ShiftCountPanelViewModel}"
             d:DesignWidth="820" d:DesignHeight="640">

  <Border Style="{StaticResource Dialog.Frame}" Width="820" MaxWidth="820" MaxHeight="660">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
        <TextBlock Text="{Binding CountCaption}" Style="{StaticResource Text.Body}" Margin="0,12,0,12" />
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding IsHandOver, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="Next cashier" Style="{StaticResource Text.Label}" />
        <ComboBox ItemsSource="{Binding Cashiers}" SelectedItem="{Binding SelectedCashier}" DisplayMemberPath="DisplayName"
                  MinHeight="{DynamicResource Size.Control}" AutomationProperties.Name="Next cashier" />
      </StackPanel>

      <cash:DenominationSheetView Grid.Row="2" DataContext="{Binding Sheet}" />

      <StackPanel Grid.Row="3" Margin="0,12,0,0" Visibility="{Binding NeedsReason, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding ReasonLabel}" Style="{StaticResource Text.Label}" />
        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="{Binding ReasonLabel}" />
      </StackPanel>

      <Border Grid.Row="4" Style="{StaticResource Banner.Error}" Margin="0,12,0,0"
              Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
      </Border>

      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="120" MinHeight="52" Margin="0,0,12,0" />
        <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Style="{StaticResource Button.Primary}"
                MinWidth="180" MinHeight="52" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
