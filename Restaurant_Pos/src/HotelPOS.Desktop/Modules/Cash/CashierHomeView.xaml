<UserControl x:Class="HotelPOS.Desktop.Modules.Cash.CashierHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cash="clr-namespace:HotelPOS.Desktop.Modules.Cash"
             xmlns:billing="clr-namespace:HotelPOS.Desktop.Modules.Billing"
             xmlns:dashboard="clr-namespace:HotelPOS.Desktop.Modules.Dashboard"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance cash:CashierHomeViewModel}"
             d:DesignWidth="1100" d:DesignHeight="720">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <controls:PageHeader Title="Cashier home" Description="{Binding UpdatedText}" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
          <ProgressBar IsIndeterminate="True" Width="80" Margin="0,0,12,0" VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <Button Style="{StaticResource Button.Icon}" Command="{Binding RefreshNowCommand}" ToolTip="Reload from the server" AutomationProperties.Name="Reload">
            <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="16" />
          </Button>
        </StackPanel>
      </controls:PageHeader>

      <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
              Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
      </Border>

      <controls:KpiStrip Grid.Row="2" ItemsSource="{Binding Tiles}" Columns="4">
        <controls:KpiStrip.ItemTemplate>
          <DataTemplate DataType="{x:Type dashboard:KpiTile}">
            <controls:KpiTile Title="{Binding Title}" Value="{Binding Value}" Detail="{Binding Detail}" Glyph="{Binding Glyph}"
                              Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}" />
          </DataTemplate>
        </controls:KpiStrip.ItemTemplate>
      </controls:KpiStrip>

      <Border Grid.Row="3" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Waiting for payment" Style="{StaticResource Text.Subtitle}" />
          <TextBlock Text="Oldest first. Open the Billing screen to take a bill." Style="{StaticResource Text.Caption}" />
          <controls:EmptyState Glyph="&#xE8C7;" Title="No bills waiting" Message="New bill requests from waiters appear here instantly."
                               Margin="0,24,0,0" Visibility="{Binding HasWaitingBills, Converter={StaticResource InverseBoolToVisibility}}" />
          <ItemsControl ItemsSource="{Binding WaitingBills}" Focusable="False" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type billing:BillQueueItemViewModel}">
                <Grid Margin="0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding TableCode}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding OrderText}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding WaitingText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0" />
                  <TextBlock Grid.Column="3" Text="{Binding TotalText}" TextAlignment="Right" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
