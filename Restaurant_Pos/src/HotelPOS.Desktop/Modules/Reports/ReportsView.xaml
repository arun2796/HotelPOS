<UserControl x:Class="HotelPOS.Desktop.Modules.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:reports="clr-namespace:HotelPOS.Desktop.Modules.Reports"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance reports:ReportsViewModel}"
             d:DesignWidth="1100" d:DesignHeight="720">

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,20,0">
      <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" AutomationProperties.Name="Reports">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type reports:ReportDefinition}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <controls:PageHeader Title="{Binding SelectedReport.Title}" Description="{Binding Description}">
        <StackPanel Orientation="Horizontal">
        <Button Command="{Binding ExportCsvCommand}" MinWidth="140">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74E;" Style="{StaticResource Text.Icon}" FontSize="14" />
            <TextBlock Text="Export CSV" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ExportExcelCommand}" MinWidth="140" Margin="8,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE9F9;" Style="{StaticResource Text.Icon}" FontSize="14" />
            <TextBlock Text="Export Excel" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <Button Command="{Binding SavePdfCommand}" MinWidth="120" Margin="8,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE749;" Style="{StaticResource Text.Icon}" FontSize="14" />
            <TextBlock Text="Save PDF" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        </StackPanel>
      </controls:PageHeader>

      <controls:ReportFilterBar Grid.Row="1" Presets="{Binding Presets}" SelectedPreset="{Binding Preset}"
                                FromDate="{Binding FromDate}" ToDate="{Binding ToDate}" IsCustomRange="{Binding IsCustom}"
                                ShowRange="{Binding IsRange}" RunCommand="{Binding RunCommand}">
        <controls:ReportFilterBar.Filters>
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Year" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" Width="110" AutomationProperties.Name="Year" />
          </StackPanel>
        </controls:ReportFilterBar.Filters>
      </controls:ReportFilterBar>

      <Border Grid.Row="2" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
              Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
      </Border>

      <controls:BusyOverlay Grid.Row="3" IsBusy="{Binding IsBusy}" Message="Running the report…">
        <Grid>
          <DataGrid ItemsSource="{Binding Table}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                    HorizontalScrollBarVisibility="Auto" AutoGeneratingColumn="OnAutoGeneratingColumn" />
          <controls:EmptyState Glyph="&#xE9D2;" Title="No rows for this period"
                               Message="Nothing was recorded in the selected period. Choose another period or report."
                               Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </controls:BusyOverlay>

      <Grid Grid.Row="4" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" Margin="0,6,16,0" TextWrapping="Wrap" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Totals}" HorizontalAlignment="Right" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="8" Padding="12,6" Margin="8,0,0,0">
                <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"
                           Typography.NumeralAlignment="Tabular" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
