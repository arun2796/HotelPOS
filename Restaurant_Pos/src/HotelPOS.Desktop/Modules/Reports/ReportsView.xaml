<UserControl x:Class="HotelPOS.Desktop.Modules.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:reports="clr-namespace:HotelPOS.Desktop.Modules.Reports"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance reports:ReportsViewModel}"
             d:DesignWidth="1100" d:DesignHeight="720">

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,20,0">
      <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" BorderThickness="0" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type reports:ReportDefinition}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Padding="8,10" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Margin="0,0,0,12">
        <TextBlock Text="{Binding SelectedReport.Title}" Style="{StaticResource Text.Title}" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" />
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRange, Converter={StaticResource BoolToVisibility}}">
          <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" Width="150" />
          <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsCustom}" Margin="12,0,0,0">
            <DatePicker SelectedDate="{Binding FromDate}" Width="150" VerticalAlignment="Center" />
            <TextBlock Text="to" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="8,0" />
            <DatePicker SelectedDate="{Binding ToDate}" Width="150" VerticalAlignment="Center" />
            <Button Content="Run" Command="{Binding RunCommand}" Style="{StaticResource Button.Primary}" Margin="12,0,0,0" MinWidth="90" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Year" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" Width="110" />
        </StackPanel>
        <Button Command="{Binding ExportCsvCommand}" HorizontalAlignment="Right" MinWidth="150">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74E;" Style="{StaticResource Text.Icon}" FontSize="14" />
            <TextBlock Text="EXPORT CSV" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </Grid>

      <Border Grid.Row="2" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
              Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
      </Border>

      <Grid Grid.Row="3">
        <DataGrid ItemsSource="{Binding Table}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                  HorizontalScrollBarVisibility="Auto" />
        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      </Grid>

      <Grid Grid.Row="4" Margin="0,12,0,0">
        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
        <ItemsControl ItemsSource="{Binding Totals}" HorizontalAlignment="Right" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="10,4" Margin="8,0,0,0">
                <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
