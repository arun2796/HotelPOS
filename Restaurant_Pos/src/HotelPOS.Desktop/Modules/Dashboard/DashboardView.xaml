<UserControl x:Class="HotelPOS.Desktop.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dashboard="clr-namespace:HotelPOS.Desktop.Modules.Dashboard"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dashboard:DashboardViewModel}"
             d:DesignWidth="1100" d:DesignHeight="720">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <controls:PageHeader Title="{Binding BusinessDayText}" Description="{Binding UpdatedText}" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
          <ProgressBar IsIndeterminate="True" Width="80" Margin="0,0,12,0" VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <Button Style="{StaticResource Button.Icon}" Command="{Binding RefreshNowCommand}" ToolTip="Reload from the server">
            <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="16" />
          </Button>
        </StackPanel>
      </controls:PageHeader>

      <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
              Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
      </Border>

      <controls:KpiStrip Grid.Row="2" ItemsSource="{Binding Tiles}" Columns="3">
        <controls:KpiStrip.ItemTemplate>
          <DataTemplate DataType="{x:Type dashboard:KpiTile}">
            <controls:KpiTile Title="{Binding Title}" Value="{Binding Value}" Detail="{Binding Detail}" Glyph="{Binding Glyph}"
                              Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}" />
          </DataTemplate>
        </controls:KpiStrip.ItemTemplate>
      </controls:KpiStrip>

      <!-- Charts (managers): plain WPF shapes in the token colours, see Controls/ChartGeometry. -->
      <Grid Grid.Row="3" Visibility="{Binding IsManagerView, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5*" />
          <ColumnDefinition Width="4*" />
          <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <!-- Net sales trend -->
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,16,16">
          <StackPanel>
            <TextBlock Text="Net sales · last 7 days" Style="{StaticResource Text.Subtitle}" />
            <TextBlock Text="Today in blue; hover a bar for the exact amount." Style="{StaticResource Text.Caption}" />
            <ItemsControl ItemsSource="{Binding DayBars}" Focusable="False" Height="210" Margin="0,16,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dashboard:DayBar}">
                  <Grid Background="Transparent" ToolTip="{Binding Amount}">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Bottom" Margin="5,0">
                      <TextBlock Text="{Binding CompactAmount}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" Margin="0,0,0,4" />
                      <Border CornerRadius="6,6,2,2" MinHeight="3"
                              Height="{Binding Height, Converter={StaticResource BarHeight}, ConverterParameter=150}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                    </StackPanel>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Border}" />
                    <TextBlock Grid.Row="2" Text="{Binding Label}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Payment split -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,16,16">
          <StackPanel>
            <TextBlock Text="Payments today" Style="{StaticResource Text.Subtitle}" />
            <TextBlock Text="Net takings by payment method." Style="{StaticResource Text.Caption}" />
            <controls:EmptyState Glyph="&#xE8C7;" Title="No payments yet" Message="The split appears with the first settled bill."
                                 Margin="0,24,0,0" Visibility="{Binding HasPayments, Converter={StaticResource InverseBoolToVisibility}}" />
            <StackPanel Margin="0,16,0,0" Visibility="{Binding HasPayments, Converter={StaticResource BoolToVisibility}}">
              <Grid Width="144" Height="144" HorizontalAlignment="Center">
                <ItemsControl ItemsSource="{Binding PaymentSlices}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Grid />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dashboard:ChartSlice}">
                      <Path Data="{Binding Shape}" Style="{StaticResource Chart.Swatch}" Stretch="None" ToolTip="{Binding Label}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding PaymentTotal}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                  <TextBlock Text="net" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding PaymentSlices}" Focusable="False" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type dashboard:ChartSlice}">
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="48" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Width="10" Height="10" Style="{StaticResource Chart.Swatch}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="Medium" Margin="8,0" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding AmountText}" Typography.NumeralAlignment="Tabular" />
                      <TextBlock Grid.Column="3" Text="{Binding PercentText}" FontWeight="SemiBold" TextAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Top items -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" Margin="0,0,16,16">
          <StackPanel>
            <TextBlock Text="Top items today" Style="{StaticResource Text.Subtitle}" />
            <TextBlock Text="Best sellers on settled bills." Style="{StaticResource Text.Caption}" />
            <controls:EmptyState Glyph="&#xE719;" Title="Nothing settled yet" Message="Best sellers appear as bills are settled."
                                 Margin="0,24,0,0" Visibility="{Binding HasTopItems, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding TopItems}" Focusable="False" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dashboard:TopItemRow}">
                  <StackPanel Margin="0,8,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Medium" />
                        <Run Text="{Binding Quantity, Mode=OneWay, StringFormat=' · {0} sold'}" Foreground="{DynamicResource Brush.TextSecondary}" />
                      </TextBlock>
                      <TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold" Margin="8,0,0,0" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <ProgressBar Value="{Binding Share, Mode=OneWay}" Style="{StaticResource Chart.ShareBar}" Margin="0,6,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
