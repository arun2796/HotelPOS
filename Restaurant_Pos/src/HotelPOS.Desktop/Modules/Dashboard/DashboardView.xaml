<UserControl x:Class="HotelPOS.Desktop.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dashboard="clr-namespace:HotelPOS.Desktop.Modules.Dashboard"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dashboard:DashboardViewModel}"
             d:DesignWidth="1100" d:DesignHeight="720">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding BusinessDayText}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
          <ProgressBar IsIndeterminate="True" Width="80" Height="3" Margin="16,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <Button Command="{Binding RefreshNowCommand}" HorizontalAlignment="Right" ToolTip="Reload from the server">
          <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
        </Button>
      </Grid>

      <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
              Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
      </Border>

      <ItemsControl Grid.Row="2" ItemsSource="{Binding Tiles}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type dashboard:KpiTile}">
            <Button Style="{StaticResource Button.Ghost}" Padding="0" Margin="0,0,16,16" HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
              <Border Style="{StaticResource Card}" Padding="20" MinHeight="120">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding Value}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4,0,2" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="28"
                             Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Top" Opacity="0.7" />
                </Grid>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid Grid.Row="3" Visibility="{Binding IsManagerView, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,16,16">
          <StackPanel>
            <TextBlock Text="NET SALES · LAST 7 DAYS" Style="{StaticResource Text.Label}" />
            <ItemsControl ItemsSource="{Binding DayBars}" Focusable="False" Height="200" Margin="0,12,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dashboard:DayBar}">
                  <Grid Margin="6,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Amount}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <Grid Grid.Row="1" Margin="0,4">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Border Grid.Row="1" CornerRadius="4,4,0,0" MinHeight="2"
                              Height="{Binding Height, Converter={StaticResource BarHeight}, ConverterParameter=150}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding Label}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,16,16">
          <StackPanel>
            <TextBlock Text="TOP ITEMS TODAY" Style="{StaticResource Text.Label}" />
            <TextBlock Text="Nothing settled yet today." Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                       Visibility="{Binding HasTopItems, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding TopItems}" Focusable="False" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dashboard:TopItemRow}">
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Rank}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Quantity}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{Binding Amount}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
