<UserControl x:Class="HotelPOS.Desktop.Modules.Admin.ServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance admin:ServerViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Notice level" Style="{StaticResource Text.Caption}" />
          <ComboBox ItemsSource="{Binding NoticeLevels}" SelectedItem="{Binding NoticeLevel}" Width="120" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Message to every connected terminal (e.g. Server restarting in 2 minutes for maintenance)" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding NoticeMessage, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" />
        </StackPanel>
        <Button Grid.Column="2" Content="Send notice" Command="{Binding SendNoticeCommand}" Style="{StaticResource Button.Primary}"
                VerticalAlignment="Bottom" Margin="12,0,0,0" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Server log" Style="{StaticResource Text.Title}" FontSize="18" />
        <TextBlock Text="{Binding LogCaption}" Style="{StaticResource Text.Caption}" />
      </StackPanel>
      <ComboBox Grid.Column="1" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" DisplayMemberPath="Name"
                Width="130" Margin="0,0,8,0" VerticalAlignment="Center" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding LineCounts}" SelectedItem="{Binding LineCount}" ItemStringFormat="Last {0} entries"
                Width="150" Margin="0,0,8,0" VerticalAlignment="Center" />
      <Button Grid.Column="3" Command="{Binding RefreshCommand}" ToolTip="Reload" VerticalAlignment="Center">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Banner.Error}" Margin="0,0,0,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
      <ListBox ItemsSource="{Binding Entries}" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontFamily="Consolas, Courier New, monospace" FontSize="12" TextWrapping="Wrap" Margin="4,2" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
