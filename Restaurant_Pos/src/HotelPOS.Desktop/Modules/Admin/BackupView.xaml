<UserControl x:Class="HotelPOS.Desktop.Modules.Admin.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance admin:BackupViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Database backups" Style="{StaticResource Text.Title}" FontSize="20" />
        <TextBlock Text="A verified copy of the database and the menu pictures, taken daily on the server. Copy the folder to a USB drive or NAS regularly."
                   Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Command="{Binding RefreshCommand}" ToolTip="Reload from the server">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>
      <Button Grid.Column="2" Content="BACKUP NOW" Command="{Binding BackupNowCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" />
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding FailureText}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
      <WrapPanel>
        <StackPanel Margin="0,0,16,8">
          <TextBlock Text="Folder on the server (empty = default)" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" Width="360" />
        </StackPanel>
        <StackPanel Margin="0,0,16,8">
          <TextBlock Text="Daily at (HH:mm)" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" Width="90" />
        </StackPanel>
        <StackPanel Margin="0,0,16,8">
          <TextBlock Text="Keep for (days)" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="90" />
        </StackPanel>
        <CheckBox Content="Daily backup enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Bottom" Margin="0,0,16,12" />
        <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
      </WrapPanel>
    </Border>

    <Grid Grid.Row="4">
      <DataGrid ItemsSource="{Binding Backups}" HorizontalScrollBarVisibility="Disabled">
        <DataGrid.Columns>
          <DataGridTextColumn Header="STARTED" Binding="{Binding Started}" Width="1.2*" MinWidth="140" />
          <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="0.6*" MinWidth="70" />
          <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="0.6*" MinWidth="70" />
          <DataGridTextColumn Header="DURATION" Binding="{Binding Duration}" Width="0.7*" MinWidth="95" />
          <DataGridTextColumn Header="TRIGGER" Binding="{Binding Trigger}" Width="1*" MinWidth="110" />
          <DataGridTextColumn Header="FILE" Binding="{Binding Backup.FileName}" Width="2*" MinWidth="240" ElementStyle="{StaticResource Text.GridTrim}" />
          <DataGridTextColumn Header="ERROR" Binding="{Binding Backup.Error}" Width="1.6*" MinWidth="120" ElementStyle="{StaticResource Text.GridTrim}" />
        </DataGrid.Columns>
      </DataGrid>
      <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
