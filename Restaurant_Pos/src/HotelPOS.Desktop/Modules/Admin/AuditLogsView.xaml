<UserControl x:Class="HotelPOS.Desktop.Modules.Admin.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance admin:AuditLogsViewModel}"
             d:DesignWidth="1200" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top Filter Bar -->
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="180" MaxWidth="280" />
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="130" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by user or details" Margin="0,0,8,0">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
        </TextBox.InputBindings>
      </TextBox>

      <TextBox Grid.Column="1" Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by action (e.g. Order, Bill)" Margin="0,0,8,0">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
        </TextBox.InputBindings>
      </TextBox>

      <ComboBox Grid.Column="2" SelectedValue="{Binding DateRange, Mode=TwoWay}" SelectedValuePath="Content" Margin="0,0,8,0">
        <ComboBoxItem Content="Today" />
        <ComboBoxItem Content="Last 7 Days" />
        <ComboBoxItem Content="All Time" />
      </ComboBox>

      <Button Grid.Column="3" Command="{Binding SearchCommand}" ToolTip="Search">
        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" />
      </Button>

      <Button Grid.Column="5" Command="{Binding RefreshCommand}" ToolTip="Reload">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>

      <Button Grid.Column="6" Content="Export CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" />
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <!-- Content: Grid & Details side by side -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="450" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="2*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <!-- Grid -->
      <Grid>
        <DataGrid ItemsSource="{Binding AuditEntries}" SelectedItem="{Binding SelectedEntry}" HorizontalScrollBarVisibility="Disabled">
          <DataGrid.Columns>
            <DataGridTextColumn Header="TIME" Binding="{Binding TimestampUtc, Converter={StaticResource UtcToLocal}}" Width="120" />
            <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="1.4*" MinWidth="120" />
            <DataGridTextColumn Header="USER" Binding="{Binding UserName}" Width="1*" MinWidth="80" />
            <DataGridTextColumn Header="TERMINAL" Binding="{Binding DeviceName}" Width="1*" MinWidth="80" />
            <DataGridTextColumn Header="ENTITY" Binding="{Binding EntityType}" Width="0.9*" MinWidth="70" />
            <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="60" />
          </DataGrid.Columns>
        </DataGrid>

        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      </Grid>

      <!-- Details Panel -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"
              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="{Binding SelectedEntry.Action}" Style="{StaticResource Text.Subtitle}" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
              <Run Text="By: " />
              <Run Text="{Binding SelectedEntry.UserName, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text="  on: " />
              <Run Text="{Binding SelectedEntry.DeviceName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
              <Run Text="Target: " />
              <Run Text="{Binding SelectedEntry.EntityType, Mode=OneWay}" />
              <Run Text=" #" />
              <Run Text="{Binding SelectedEntry.EntityId, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>

          <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,10,0,10" />

          <!-- JSON Values -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Values / Changes:" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding FormattedNewValues, Mode=OneWay}" IsReadOnly="True"
                       FontFamily="Consolas, Courier New, monospace" FontSize="11" Margin="0,4,0,12"
                       TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource Brush.SurfaceSubtle}" />

              <TextBlock Text="Previous Values:" Style="{StaticResource Text.Label}"
                         Visibility="{Binding SelectedEntry.OldValues, Converter={StaticResource StringToVisibility}}" />
              <TextBox Text="{Binding FormattedOldValues, Mode=OneWay}" IsReadOnly="True"
                       FontFamily="Consolas, Courier New, monospace" FontSize="11" Margin="0,4,0,0"
                       TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource Brush.SurfaceSubtle}"
                       Visibility="{Binding SelectedEntry.OldValues, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Pagination -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Command="{Binding PreviousPageCommand}" ToolTip="Previous page">
          <TextBlock Text="&#xE76B;" Style="{StaticResource Text.Icon}" />
        </Button>
        <TextBlock Text="{Binding PageText}" Style="{StaticResource Text.Caption}" FontSize="14" VerticalAlignment="Center" Margin="14,0" />
        <Button Command="{Binding NextPageCommand}" ToolTip="Next page">
          <TextBlock Text="&#xE76C;" Style="{StaticResource Text.Icon}" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
