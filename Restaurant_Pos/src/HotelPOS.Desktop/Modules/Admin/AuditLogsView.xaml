<UserControl x:Class="HotelPOS.Desktop.Modules.Admin.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance admin:AuditLogsViewModel}"
             d:DesignWidth="1200" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <controls:ReportFilterBar Margin="0,0,0,16" Presets="{Binding DateRanges}" SelectedPreset="{Binding DateRange}"
                              FromDate="{Binding CustomFrom}" ToDate="{Binding CustomTo}" IsCustomRange="{Binding IsCustomRange}"
                              ShowSearch="True" SearchText="{Binding Search}" SearchHint="User, action or terminal contains"
                              RunCommand="{Binding SearchCommand}" RunText="Search">
      <controls:ReportFilterBar.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
      </controls:ReportFilterBar.InputBindings>
      <controls:ReportFilterBar.Filters>
        <StackPanel Orientation="Horizontal">
          <TextBox Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"
                   md:HintAssist.Hint="User" AutomationProperties.Name="User" />
          <TextBox Text="{Binding DeviceFilter, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"
                   md:HintAssist.Hint="Terminal" AutomationProperties.Name="Terminal" />
          <TextBox Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged}" Width="200"
                   md:HintAssist.Hint="Action, e.g. Order.Cancelled" AutomationProperties.Name="Action (exact)" />
        </StackPanel>
      </controls:ReportFilterBar.Filters>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Button.Icon}" Command="{Binding RefreshCommand}" ToolTip="Reload">
          <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="16" />
        </Button>
        <Button Command="{Binding ExportCsvCommand}" Margin="8,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74E;" Style="{StaticResource Text.Icon}" FontSize="14" />
            <TextBlock Text="Export CSV" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ExportExcelCommand}" Margin="8,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE9F9;" Style="{StaticResource Text.Icon}" FontSize="14" />
            <TextBlock Text="Export Excel" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <Button Command="{Binding SavePdfCommand}" Margin="8,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="14" />
            <TextBlock Text="Save PDF" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>
    </controls:ReportFilterBar>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <!-- Content: Grid & Details side by side -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="450" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="2*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <!-- Grid -->
      <controls:BusyOverlay IsBusy="{Binding IsBusy}" Message="Loading the audit log…">
        <DataGrid ItemsSource="{Binding AuditEntries}" SelectedItem="{Binding SelectedEntry}" HorizontalScrollBarVisibility="Disabled">
          <DataGrid.Columns>
            <DataGridTextColumn Header="TIME" Binding="{Binding TimestampUtc, Converter={StaticResource UtcToLocal}}" Width="136" MinWidth="136" />
            <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="1.4*" MinWidth="132" ElementStyle="{StaticResource Text.GridTrim}" />
            <DataGridTextColumn Header="USER" Binding="{Binding UserName}" Width="1*" MinWidth="96" ElementStyle="{StaticResource Text.GridTrim}" />
            <DataGridTextColumn Header="TERMINAL" Binding="{Binding DeviceName}" Width="1.1*" MinWidth="104" ElementStyle="{StaticResource Text.GridTrim}" />
            <DataGridTextColumn Header="ENTITY" Binding="{Binding EntityType}" Width="0.9*" MinWidth="84" ElementStyle="{StaticResource Text.GridTrim}" />
            <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="52" MinWidth="52" ElementStyle="{StaticResource Text.GridTrim}" />
          </DataGrid.Columns>
        </DataGrid>
      </controls:BusyOverlay>

      <!-- Details Panel -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"
              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="{Binding SelectedEntry.Action}" Style="{StaticResource Text.Subtitle}" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
              <Run Text="By: " />
              <Run Text="{Binding SelectedEntry.UserName, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <!-- An entry made without a terminal (the server, a browser) has no "on" line at all. -->
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                       Visibility="{Binding SelectedEntry.DeviceName, Converter={StaticResource StringToVisibility}}">
              <Run Text="On terminal: " />
              <Run Text="{Binding SelectedEntry.DeviceName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
              <Run Text="Target: " />
              <Run Text="{Binding SelectedEntry.EntityType, Mode=OneWay}" />
              <Run Text=" #" />
              <Run Text="{Binding SelectedEntry.EntityId, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>

          <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,10,0,10" />

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Before" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding FormattedOldValues, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas, Courier New, monospace" FontSize="11" Margin="0,4,0,0"
                         TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource Brush.SurfaceSubtle}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="After" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding FormattedNewValues, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas, Courier New, monospace" FontSize="11" Margin="0,4,0,0"
                         TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource Brush.SurfaceSubtle}" />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Pagination -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Command="{Binding PreviousPageCommand}" ToolTip="Previous page">
          <TextBlock Text="&#xE76B;" Style="{StaticResource Text.Icon}" />
        </Button>
        <TextBlock Text="{Binding PageText}" Style="{StaticResource Text.Caption}" FontSize="14" VerticalAlignment="Center" Margin="14,0" />
        <Button Command="{Binding NextPageCommand}" ToolTip="Next page">
          <TextBlock Text="&#xE76C;" Style="{StaticResource Text.Icon}" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
