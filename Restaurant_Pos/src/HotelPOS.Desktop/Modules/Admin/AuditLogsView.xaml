<UserControl x:Class="HotelPOS.Desktop.Modules.Admin.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance admin:AuditLogsViewModel}"
             d:DesignWidth="1200" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <WrapPanel>
        <WrapPanel.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
        </WrapPanel.InputBindings>
        <StackPanel Margin="0,0,8,8">
          <TextBlock Text="Search" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="180" ToolTip="User, action or terminal contains" />
        </StackPanel>
        <StackPanel Margin="0,0,8,8">
          <TextBlock Text="User" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" Width="130" />
        </StackPanel>
        <StackPanel Margin="0,0,8,8">
          <TextBlock Text="Terminal" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding DeviceFilter, UpdateSourceTrigger=PropertyChanged}" Width="130" />
        </StackPanel>
        <StackPanel Margin="0,0,8,8">
          <TextBlock Text="Action (exact)" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged}" Width="160" ToolTip="e.g. Order.Cancelled" />
        </StackPanel>
        <StackPanel Margin="0,0,8,8">
          <TextBlock Text="Period" Style="{StaticResource Text.Caption}" />
          <ComboBox SelectedValue="{Binding DateRange, Mode=TwoWay}" SelectedValuePath="Content" Width="130">
            <ComboBoxItem Content="Today" />
            <ComboBoxItem Content="Last 7 Days" />
            <ComboBoxItem Content="Custom" />
            <ComboBoxItem Content="All Time" />
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,8,8"
                    Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="From" Style="{StaticResource Text.Caption}" />
            <DatePicker SelectedDate="{Binding CustomFrom}" Width="130" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="To" Style="{StaticResource Text.Caption}" />
            <DatePicker SelectedDate="{Binding CustomTo}" Width="130" />
          </StackPanel>
        </StackPanel>
        <Button Command="{Binding SearchCommand}" ToolTip="Apply filters" VerticalAlignment="Bottom" Margin="0,0,8,8">
          <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" />
        </Button>
      </WrapPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
        <Button Command="{Binding RefreshCommand}" ToolTip="Reload">
          <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
        </Button>
        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <!-- Content: Grid & Details side by side -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="450" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="2*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <!-- Grid -->
      <Grid>
        <DataGrid ItemsSource="{Binding AuditEntries}" SelectedItem="{Binding SelectedEntry}" HorizontalScrollBarVisibility="Disabled">
          <DataGrid.Columns>
            <DataGridTextColumn Header="TIME" Binding="{Binding TimestampUtc, Converter={StaticResource UtcToLocal}}" Width="120" />
            <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="1.4*" MinWidth="120" />
            <DataGridTextColumn Header="USER" Binding="{Binding UserName}" Width="1*" MinWidth="80" />
            <DataGridTextColumn Header="TERMINAL" Binding="{Binding DeviceName}" Width="1*" MinWidth="80" />
            <DataGridTextColumn Header="ENTITY" Binding="{Binding EntityType}" Width="0.9*" MinWidth="70" />
            <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="60" />
          </DataGrid.Columns>
        </DataGrid>

        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      </Grid>

      <!-- Details Panel -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"
              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="{Binding SelectedEntry.Action}" Style="{StaticResource Text.Subtitle}" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
              <Run Text="By: " />
              <Run Text="{Binding SelectedEntry.UserName, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text="  on: " />
              <Run Text="{Binding SelectedEntry.DeviceName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
              <Run Text="Target: " />
              <Run Text="{Binding SelectedEntry.EntityType, Mode=OneWay}" />
              <Run Text=" #" />
              <Run Text="{Binding SelectedEntry.EntityId, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>

          <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,10,0,10" />

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Before" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding FormattedOldValues, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas, Courier New, monospace" FontSize="11" Margin="0,4,0,0"
                         TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource Brush.SurfaceSubtle}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="After" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding FormattedNewValues, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas, Courier New, monospace" FontSize="11" Margin="0,4,0,0"
                         TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource Brush.SurfaceSubtle}" />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Pagination -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Command="{Binding PreviousPageCommand}" ToolTip="Previous page">
          <TextBlock Text="&#xE76B;" Style="{StaticResource Text.Icon}" />
        </Button>
        <TextBlock Text="{Binding PageText}" Style="{StaticResource Text.Caption}" FontSize="14" VerticalAlignment="Center" Margin="14,0" />
        <Button Command="{Binding NextPageCommand}" ToolTip="Next page">
          <TextBlock Text="&#xE76C;" Style="{StaticResource Text.Icon}" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
