<UserControl x:Class="HotelPOS.Desktop.Modules.Admin.TablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance admin:TablesViewModel}"
             d:DesignWidth="1100" d:DesignHeight="640">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="160" MaxWidth="300" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox ItemsSource="{Binding SectionFilters}" SelectedItem="{Binding SectionFilter}" DisplayMemberPath="Name"
                ToolTip="Show the tables of one section" />
      <CheckBox Grid.Column="1" Content="Show inactive" IsChecked="{Binding ShowInactive}" Margin="16,0,16,0" />
      <Button Grid.Column="3" Command="{Binding RefreshListCommand}" ToolTip="Reload from the server">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>
      <Button Grid.Column="4" Command="{Binding NewTableCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="14" />
          <TextBlock Text="New table" Margin="8,0,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <Grid Grid.Row="2">
      <DataGrid ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedRow}" HorizontalScrollBarVisibility="Disabled">
        <DataGrid.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
        </DataGrid.InputBindings>
        <DataGrid.Columns>
          <DataGridTextColumn Header="CODE" Binding="{Binding Table.Code}" Width="0.7*" MinWidth="70" />
          <DataGridTextColumn Header="NAME" Binding="{Binding Table.Name}" Width="1.3*" MinWidth="100" />
          <DataGridTextColumn Header="SECTION" Binding="{Binding Table.SectionName}" Width="1.2*" MinWidth="100" />
          <DataGridTextColumn Header="SEATS" Binding="{Binding Table.Capacity}" Width="0.6*" MinWidth="60" />
          <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="1*" MinWidth="100" />
          <DataGridTextColumn Header="ACTIVE" Binding="{Binding Table.IsActive, Converter={StaticResource ActiveText}}" Width="0.8*" MinWidth="70" />
        </DataGrid.Columns>
      </DataGrid>
      <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Edit" Command="{Binding EditCommand}" MinWidth="90" />
      <Button Content="{Binding ServiceToggleText}" Command="{Binding ToggleServiceCommand}" Margin="8,0,0,0" MinWidth="170" />
    </StackPanel>

    <Border Grid.Column="1" Grid.RowSpan="4" Style="{StaticResource Card}" Width="360" Margin="20,0,0,0"
            DataContext="{Binding Editor}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,20" />

            <TextBlock Text="Code (e.g. T05)" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="10" Margin="0,0,0,14" />

            <TextBlock Text="Name (optional)" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,0,0,14" />

            <TextBlock Text="Section" Style="{StaticResource Text.Label}" />
            <ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding Section}" DisplayMemberPath="Name" Margin="0,0,0,14" />

            <TextBlock Text="Seats" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" Margin="0,0,0,14" />

            <CheckBox Content="Active (shown on the table map)" IsChecked="{Binding IsActive}"
                      Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />

            <Border Style="{StaticResource Banner.Error}" Margin="0,16,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
              <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="Cancel"
                  Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <Button Grid.Column="2" Content="{Binding SaveText}" Style="{StaticResource Button.Primary}"
                  Command="{Binding DataContext.SaveTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
