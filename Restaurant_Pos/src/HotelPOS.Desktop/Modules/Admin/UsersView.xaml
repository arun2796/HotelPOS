<UserControl x:Class="HotelPOS.Desktop.Modules.Admin.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance admin:UsersViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="160" MaxWidth="340" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by username or name">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
        </TextBox.InputBindings>
      </TextBox>
      <Button Grid.Column="1" Command="{Binding SearchCommand}" Margin="8,0,0,0" ToolTip="Search">
        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" />
      </Button>
      <CheckBox Grid.Column="2" Content="Show inactive" IsChecked="{Binding ShowInactive}" Margin="16,0,16,0" />
      <Button Grid.Column="4" Command="{Binding RefreshListCommand}" ToolTip="Reload from the server">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>
      <Button Grid.Column="5" Command="{Binding NewUserCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="14" />
          <TextBlock Text="New user" Margin="8,0,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <Grid Grid.Row="2">
      <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" controls:SelectorBehaviors.ScrollSelectedIntoView="True" HorizontalScrollBarVisibility="Disabled">
        <DataGrid.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
        </DataGrid.InputBindings>
        <DataGrid.Columns>
          <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="1*" MinWidth="90" />
          <DataGridTextColumn Header="NAME" Binding="{Binding DisplayName}" Width="1.5*" MinWidth="120" />
          <DataGridTextColumn Header="ROLES" Binding="{Binding Roles, Converter={StaticResource ListJoin}}" Width="1.2*" MinWidth="90" />
          <!-- Status and lockout as badges, like every other status in the app: colour plus a word, never colour alone. -->
          <DataGridTemplateColumn Header="STATUS" Width="0.9*" MinWidth="112">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <controls:StatusBadge>
                  <controls:StatusBadge.Style>
                    <Style TargetType="controls:StatusBadge" BasedOn="{StaticResource {x:Type controls:StatusBadge}}">
                      <Setter Property="Tone" Value="Success" />
                      <Setter Property="Label" Value="Active" />
                      <Setter Property="Icon" Value="check" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                          <Setter Property="Tone" Value="Neutral" />
                          <Setter Property="Label" Value="Inactive" />
                          <Setter Property="Icon" Value="ban" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:StatusBadge.Style>
                </controls:StatusBadge>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="LOCKOUT" Width="0.8*" MinWidth="96">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid>
                  <TextBlock Text="—" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                             Visibility="{Binding IsLockedOut, Converter={StaticResource InverseBoolToVisibility}}" />
                  <controls:StatusBadge Tone="Danger" Label="Locked" Icon="lock"
                                        Visibility="{Binding IsLockedOut, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="LAST SIGN-IN" Binding="{Binding LastLoginAtUtc, Converter={StaticResource UtcToLocal}}" Width="1.2*" MinWidth="140" />
        </DataGrid.Columns>
      </DataGrid>
      <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <!-- An empty grid says why it is empty instead of showing a blank box. -->
      <controls:EmptyState Icon="users" Title="No users to show" Message="Change the search or the inactive filter, or add the first staff account with New user."
                           VerticalAlignment="Center" IsHitTestVisible="False">
        <controls:EmptyState.Style>
          <Style TargetType="controls:EmptyState" BasedOn="{StaticResource {x:Type controls:EmptyState}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Users.Count}" Value="0" />
                  <Condition Binding="{Binding IsBusy}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </controls:EmptyState.Style>
      </controls:EmptyState>
    </Grid>

    <!-- Actions wrap onto a second line when the editor panel narrows the page, instead of being cut off. -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- One emphasised action (Edit); the rest are quiet, so the row reads as a toolbar for the selected user, not six
           equal buttons. -->
      <WrapPanel Margin="0,0,0,-8" VerticalAlignment="Center">
        <Button Content="Edit" Command="{Binding EditCommand}" Style="{StaticResource Button.Secondary}" MinWidth="90" Margin="0,0,8,8" />
        <Button Content="Reset password" Command="{Binding ResetPasswordCommand}" Style="{StaticResource Button.Ghost}" Margin="0,0,4,8" />
        <Button Content="{Binding ToggleActiveText}" Command="{Binding ToggleActiveCommand}" Style="{StaticResource Button.Ghost}" Margin="0,0,4,8" />
        <Button Content="Unlock" Command="{Binding UnlockCommand}" Style="{StaticResource Button.Ghost}" Margin="0,0,4,8" />
        <Button Content="Sessions" Command="{Binding ViewSessionsCommand}" Style="{StaticResource Button.Ghost}" Margin="0,0,4,8" />
        <Button Content="Log out everywhere" Command="{Binding LogoutAllCommand}" Style="{StaticResource Button.Ghost}"
                Foreground="{DynamicResource Brush.DangerText}" Margin="0,0,4,8" />
      </WrapPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button Command="{Binding PreviousPageCommand}" ToolTip="Previous page">
          <TextBlock Text="&#xE76B;" Style="{StaticResource Text.Icon}" />
        </Button>
        <TextBlock Text="{Binding PageText}" Style="{StaticResource Text.Caption}" FontSize="14" VerticalAlignment="Center" Margin="14,0" />
        <Button Command="{Binding NextPageCommand}" ToolTip="Next page">
          <TextBlock Text="&#xE76C;" Style="{StaticResource Text.Icon}" />
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Column="1" Grid.RowSpan="4" Style="{StaticResource Card.Elevated}" Width="380" Margin="20,0,0,0"
            DataContext="{Binding Editor}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,20" />

            <TextBlock Text="Username" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" Margin="0,0,0,14" />

            <TextBlock Text="Display name" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

            <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Initial password" Style="{StaticResource Text.Label}" />
              <PasswordBox controls:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay}" Margin="0,0,0,4" />
              <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource Text.Caption}"
                         TextWrapping="Wrap" Margin="0,0,0,8" />
              <CheckBox Content="Must change password at first sign-in" IsChecked="{Binding MustChangePassword}" Margin="0,0,0,14" />
            </StackPanel>

            <TextBlock Text="Roles" Style="{StaticResource Text.Label}" />
            <ItemsControl ItemsSource="{Binding Roles}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type admin:RoleOptionViewModel}">
                  <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Banner.Error}" Margin="0,16,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
              <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="Cancel"
                  Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <Button Grid.Column="2" Content="{Binding SaveText}" Style="{StaticResource Button.Primary}"
                  Command="{Binding DataContext.SaveUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
