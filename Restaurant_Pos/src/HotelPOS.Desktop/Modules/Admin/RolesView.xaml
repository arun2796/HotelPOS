<UserControl x:Class="HotelPOS.Desktop.Modules.Admin.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance admin:RolesViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Roles &amp; Permissions Matrix" Style="{StaticResource Text.Title}" FontSize="20" />
        <TextBlock Text="Configure fine-grained access policies per role. Admin permissions are fixed; locked permissions are the core of each system role."
                   Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,4,0,0" />
      </StackPanel>
      <Button Grid.Column="1" Command="{Binding RefreshCommand}" ToolTip="Reload from server">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Roles list -->
      <Border Style="{StaticResource Card}" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <TextBlock Text="ROLES" Style="{StaticResource Text.Label}" />
          </Border>
          <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="8,10">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding RoleName}" Style="{StaticResource Text.Subtitle}" />
                      <Border Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="3" Padding="4,1" Margin="8,0,0,0"
                              Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="System" FontSize="10" Foreground="{DynamicResource Brush.Primary}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" FontSize="11" Margin="0,2,0,0" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Permissions Panel -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"
              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Header -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedRole.RoleName}" Style="{StaticResource Text.Title}" FontSize="18" />
                <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="4" Padding="8,2" Margin="12,0,0,0"
                        Visibility="{Binding IsAdminRole, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="Protected: System Administrator has all permissions" FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding SelectedRole.Description}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,12" />

          <!-- Permissions Items -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding PermissionItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Group}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                  ToolTip="{Binding LockTooltip}" ToolTipService.ShowOnDisabled="True">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Visibility="{Binding IsCore, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox IsChecked="{Binding IsGranted}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                                  VerticalAlignment="Center" Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Footer Actions -->
          <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0"
                  Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <CheckBox Content="Force re-login for active users with this role" IsChecked="{Binding ForceRelogin}"
                        VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Save permissions" Command="{Binding SavePermissionsCommand}"
                      Style="{StaticResource Button.Primary}" MinWidth="140" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

