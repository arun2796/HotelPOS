<UserControl x:Class="HotelPOS.Desktop.Modules.Admin.FloorEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance admin:FloorEditorViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <UserControl.Resources>
    <Style x:Key="ResizeHandle" TargetType="Thumb">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="2" CornerRadius="2" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DrawingBrush x:Key="GridDots" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <GeometryDrawing Brush="{DynamicResource Brush.Border}">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="0,0" RadiusX="1.2" RadiusY="1.2" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </UserControl.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Title="Floor plan" Description="{Binding DirtyText}" Margin="0,0,0,12">
      <Button Content="Save layout" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" />
    </controls:PageHeader>

    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" DisplayMemberPath="Name"
                MinWidth="160" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="Section" />
      <CheckBox Content="Snap to 8-unit grid" IsChecked="{Binding SnapEnabled}" Margin="0,0,12,0" VerticalAlignment="Center" />
      <Button Content="Rotate 90°" Command="{Binding RotateCommand}" Margin="0,0,6,0" ToolTip="Rotate the selected table by 90 degrees" />
      <Button Content="Round / Rect" Command="{Binding ToggleShapeCommand}" Margin="0,0,12,0" ToolTip="Switch the selected table's shape" />
      <Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,6,0" ToolTip="Ctrl+Z" />
      <Button Content="Redo" Command="{Binding RedoCommand}" Margin="0,0,12,0" ToolTip="Ctrl+Y" />
      <Button Content="Reset to grid" Command="{Binding ResetToGridCommand}" Margin="0,0,12,0" ToolTip="Lay every table out in rows of six" />
      <StackPanel Orientation="Horizontal"><TextBlock Text="Zoom" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Slider Minimum="0.25" Maximum="2" Width="100" Value="{Binding Zoom}" VerticalAlignment="Center" AutomationProperties.Name="Zoom" />
      <Button Content="Fit" Click="OnFitClick" Margin="8,0,0,0" ToolTip="Fit the plan to the window width" /></StackPanel>
    </WrapPanel>

    <Border Grid.Row="2" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource Brush.Surface}">
        <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="Surface" ItemsSource="{Binding Placed}" Focusable="True" FocusVisualStyle="{x:Null}"
                        Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="{StaticResource GridDots}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        MouseLeftButtonDown="OnSurfaceMouseDown" KeyDown="OnSurfaceKeyDown" AutomationProperties.Name="Floor plan canvas">
            <ItemsControl.LayoutTransform>
              <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
            </ItemsControl.LayoutTransform>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding X}" />
                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                <EventSetter Event="MouseLeftButtonDown" Handler="OnTileMouseDown" />
                <EventSetter Event="MouseMove" Handler="OnTileMouseMove" />
                <EventSetter Event="MouseLeftButtonUp" Handler="OnTileMouseUp" />
                <EventSetter Event="Thumb.DragStarted" Handler="OnHandleDragStarted" />
                <EventSetter Event="Thumb.DragDelta" Handler="OnHandleDragDelta" />
                <EventSetter Event="Thumb.DragCompleted" Handler="OnHandleDragCompleted" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type admin:FloorEditorItem}">
                <Grid Width="{Binding Width}" Height="{Binding Height}" controls:FloorTile.Angle="{Binding Rotation}" Cursor="SizeAll"
                      AutomationProperties.Name="{Binding Code}">
                  <Border Style="{StaticResource FloorTileSurface}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding Code}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding SeatsText}" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Grid Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                    <Thumb Style="{StaticResource ResizeHandle}" Tag="NW" Cursor="SizeNWSE" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0" />
                    <Thumb Style="{StaticResource ResizeHandle}" Tag="N" Cursor="SizeNS" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-5,0,0" />
                    <Thumb Style="{StaticResource ResizeHandle}" Tag="NE" Cursor="SizeNESW" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" />
                    <Thumb Style="{StaticResource ResizeHandle}" Tag="E" Cursor="SizeWE" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-5,0" />
                    <Thumb Style="{StaticResource ResizeHandle}" Tag="SE" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5" />
                    <Thumb Style="{StaticResource ResizeHandle}" Tag="S" Cursor="SizeNS" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-5" />
                    <Thumb Style="{StaticResource ResizeHandle}" Tag="SW" Cursor="SizeNESW" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,-5" />
                    <Thumb Style="{StaticResource ResizeHandle}" Tag="W" Cursor="SizeWE" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0" />
                  </Grid>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1" Width="240" Margin="16,0,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8"
              Background="{DynamicResource Brush.Surface}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Unplaced tables" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
          <TextBlock DockPanel.Dock="Top" Text="All tables of this section are on the plan." Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                     Visibility="{Binding HasUnplaced, Converter={StaticResource InverseBoolToVisibility}}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Unplaced}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type admin:FloorEditorItem}">
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding SeatsText}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Place" VerticalAlignment="Center"
                            Command="{Binding DataContext.PlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="Put this table on the next free spot of the plan" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <ProgressBar Grid.ColumnSpan="2" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
