<UserControl x:Class="HotelPOS.Desktop.Modules.Admin.TemplateStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance admin:TemplateStudioViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <Grid Margin="24,12,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="400" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Toolbar -->
    <Grid Grid.ColumnSpan="3" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Document" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label" Width="170"
                  AutomationProperties.Name="Document type" />
        <TextBlock Text="Preview with" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="20,0,8,0" />
        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Label" Width="240"
                  AutomationProperties.Name="Preview data" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Print test" Command="{Binding PrintTestCommand}" MinWidth="110" />
        <Button Content="Save version" Command="{Binding SaveCommand}" MinWidth="120" Margin="8,0,0,0" />
        <Button Content="Save and activate" Command="{Binding SaveAndActivateCommand}" Style="{StaticResource Button.Primary}" MinWidth="150" Margin="8,0,0,0" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" />
    </Border>

    <!-- Options -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
          <TextBlock Text="Versions" Style="{StaticResource Text.Subtitle}" />
          <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" MaxHeight="150" Margin="0,6,0,0"
                   AutomationProperties.Name="Template versions">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type admin:TemplateVersionRow}">
                <StackPanel Margin="0,2">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                    <Border Style="{StaticResource Pill.Success}" Margin="8,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="Active" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding VersionName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Version name" ToolTip="Name of the next saved version" />
            <Button Grid.Column="1" Content="Activate" Command="{Binding ActivateCommand}" Margin="8,0,0,0"
                    ToolTip="Make the selected version active (roll back to an older one)" />
          </Grid>

          <TextBlock Text="Paper and header" Style="{StaticResource Text.Subtitle}" Margin="0,20,0,6" />
          <ComboBox ItemsSource="{Binding Papers}" SelectedItem="{Binding Paper}" DisplayMemberPath="Label" AutomationProperties.Name="Paper" />
          <CheckBox Content="Large text on thermal paper" IsChecked="{Binding LargeText}" Margin="0,8,0,0" />
          <CheckBox Content="Logo" IsChecked="{Binding ShowLogo}" Margin="0,6,0,0" Visibility="{Binding IsBillDocument, Converter={StaticResource BoolToVisibility}}" />
          <StackPanel Orientation="Horizontal" Margin="24,4,0,0" Visibility="{Binding IsBillDocument, Converter={StaticResource BoolToVisibility}}">
            <Button Content="Upload logo…" Command="{Binding UploadLogoCommand}" Style="{StaticResource Button.Link}" />
            <Button Content="Remove logo" Command="{Binding RemoveLogoCommand}" Style="{StaticResource Button.Link}" Margin="16,0,0,0" />
          </StackPanel>
          <StackPanel Visibility="{Binding IsInvoice, Converter={StaticResource BoolToVisibility}}">
            <CheckBox Content="Address" IsChecked="{Binding ShowAddress}" Margin="0,6,0,0" />
            <CheckBox Content="Phone" IsChecked="{Binding ShowPhone}" Margin="0,6,0,0" />
            <CheckBox Content="GSTIN (required on a GST invoice)" IsChecked="{Binding ShowGstin}" Margin="0,6,0,0" />
          </StackPanel>
          <TextBlock Text="Header lines (one per line)" Style="{StaticResource Text.Label}" Margin="0,10,0,4" />
          <TextBox Text="{Binding HeaderText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="54" TextWrapping="Wrap"
                   AutomationProperties.Name="Header lines" />

          <StackPanel Visibility="{Binding IsInvoice, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Columns" Style="{StaticResource Text.Subtitle}" Margin="0,20,0,6" />
            <TextBlock Text="Item, quantity and amount are required on a GST invoice." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Columns}" Margin="0,6,0,0" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type admin:TemplateColumnOption}">
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsIncluded}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource Button.Icon}" ToolTip="Move up"
                            Command="{Binding DataContext.MoveColumnUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                      <TextBlock Text="&#xE70E;" Style="{StaticResource Text.Icon}" FontSize="12" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource Button.Icon}" ToolTip="Move down"
                            Command="{Binding DataContext.MoveColumnDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                      <TextBlock Text="&#xE70D;" Style="{StaticResource Text.Icon}" FontSize="12" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Tax and payment" Style="{StaticResource Text.Subtitle}" Margin="0,20,0,6" />
            <ComboBox ItemsSource="{Binding GstStyles}" SelectedItem="{Binding GstStyle}" DisplayMemberPath="Label" AutomationProperties.Name="GST breakup" />
            <CheckBox Content="UPI payment QR (UPI ID in Restaurant settings)" IsChecked="{Binding ShowUpiQr}" Margin="0,8,0,0" />
            <CheckBox Content="Waiter" IsChecked="{Binding ShowWaiter}" Margin="0,6,0,0" />
            <CheckBox Content="Guests" IsChecked="{Binding ShowGuests}" Margin="0,6,0,0" />
            <CheckBox Content="Customer" IsChecked="{Binding ShowCustomer}" Margin="0,6,0,0" />
            <CheckBox Content="Payments" IsChecked="{Binding ShowPayments}" Margin="0,6,0,0" />
          </StackPanel>

          <StackPanel Visibility="{Binding IsKot, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Kitchen ticket" Style="{StaticResource Text.Subtitle}" Margin="0,20,0,6" />
            <ComboBox ItemsSource="{Binding KotPriceChoices}" SelectedItem="{Binding KotPrices}" DisplayMemberPath="Label" AutomationProperties.Name="Prices" />
            <CheckBox Content="Notes in bold" IsChecked="{Binding KotNotesBold}" Margin="0,8,0,0" />
            <CheckBox Content="Station heading" IsChecked="{Binding KotStationHeading}" Margin="0,6,0,0" />
            <CheckBox Content="Waiter" IsChecked="{Binding ShowWaiter}" Margin="0,6,0,0" />
            <CheckBox Content="Guests" IsChecked="{Binding ShowGuests}" Margin="0,6,0,0" />
          </StackPanel>

          <TextBlock Text="Footer" Style="{StaticResource Text.Subtitle}" Margin="0,20,0,6" />
          <TextBlock Text="Footer lines (one per line)" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
          <TextBox Text="{Binding FooterText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="54" TextWrapping="Wrap"
                   AutomationProperties.Name="Footer lines" />
          <TextBlock Text="Terms (one per line)" Style="{StaticResource Text.Label}" Margin="0,10,0,4" />
          <TextBox Text="{Binding TermsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="54" TextWrapping="Wrap"
                   AutomationProperties.Name="Terms" />
          <CheckBox Content="Printed date and time" IsChecked="{Binding ShowPrintedAt}" Margin="0,10,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Live preview -->
    <Grid Grid.Row="2" Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="{Binding PreviewCaption}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" HorizontalAlignment="Center" MinWidth="420">
        <FlowDocumentScrollViewer x:Name="PreviewViewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" Background="White" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
