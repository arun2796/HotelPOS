<UserControl x:Class="HotelPOS.Desktop.Modules.Admin.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance admin:SettingsViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Settings shared by every terminal. Changes are audited."
                 Style="{StaticResource Text.Caption}" FontSize="14" VerticalAlignment="Center" />
      <Button Grid.Column="1" Command="{Binding LoadCommand}" ToolTip="Reload from the server (discards unsaved edits)">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>
      <Button Grid.Column="2" Content="Save changes" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" />
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type admin:SettingItemViewModel}">
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="24,14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Subtitle}" />
                        <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0"
                                VerticalAlignment="Center" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Text="Edited" FontSize="11" Foreground="{DynamicResource Brush.TextPrimary}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                               Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                      <CheckBox Content="Enabled" IsChecked="{Binding BoolValue}"
                                Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                 Visibility="{Binding Hint, Converter={StaticResource StringToVisibility}}" />
                      <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Error}" Margin="0,4,0,0"
                                 Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
