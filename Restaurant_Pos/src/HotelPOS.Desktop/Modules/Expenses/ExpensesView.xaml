<UserControl x:Class="HotelPOS.Desktop.Modules.Expenses.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:expenses="clr-namespace:HotelPOS.Desktop.Modules.Expenses"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance expenses:ExpensesViewModel}"
             d:DesignWidth="1200" d:DesignHeight="720">

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Filter bar: wraps onto a second line when the window is narrow (1366 px with the sidebar open) instead of
         cutting the search off at the right edge (Phase 25). The summary and reload stay pinned right. -->
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <WrapPanel VerticalAlignment="Center" Margin="0,0,0,-8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,8">
          <DatePicker SelectedDate="{Binding FromDate}" Width="136" ToolTip="From date"
                      AutomationProperties.Name="Filter from date" />
          <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center" />
          <DatePicker SelectedDate="{Binding ToDate}" Width="136" ToolTip="To date"
                      AutomationProperties.Name="Filter to date" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,8">
          <Button Content="Today" Command="{Binding QuickFilterTodayCommand}" Style="{StaticResource Button.Secondary}" />
          <Button Content="This month" Command="{Binding QuickFilterThisMonthCommand}" Style="{StaticResource Button.Secondary}" Margin="6,0,0,0" />
          <Button Content="Last 30 days" Command="{Binding QuickFilterLast30DaysCommand}" Style="{StaticResource Button.Secondary}" Margin="6,0,0,0" />
        </StackPanel>
        <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}"
                  DisplayMemberPath="Name" Width="150" VerticalAlignment="Center" Margin="0,0,14,8"
                  ToolTip="Filter by category" AutomationProperties.Name="Category filter" />
        <CheckBox Content="Include void" IsChecked="{Binding IncludeVoid}" VerticalAlignment="Center" Margin="0,0,14,8" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220"
                   ToolTip="Search payee, notes, category, amount" md:HintAssist.Hint="Search expenses..."
                   VerticalAlignment="Center" AutomationProperties.Name="Search expenses">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Command="{Binding SearchCommand}" Margin="6,0,0,0" ToolTip="Search" VerticalAlignment="Center">
            <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" />
          </Button>
        </StackPanel>
      </WrapPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" FontSize="13" VerticalAlignment="Center"
                   Margin="0,0,12,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <Button Command="{Binding LoadCommand}" ToolTip="Reload from server" VerticalAlignment="Center">
          <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
        </Button>
      </StackPanel>
    </Grid>


    <!-- Error Banner -->
    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <!-- Expenses DataGrid -->
    <Grid Grid.Row="2">
      <DataGrid ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}"
                controls:SelectorBehaviors.ScrollSelectedIntoView="True" HorizontalScrollBarVisibility="Disabled">
        <DataGrid.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
        </DataGrid.InputBindings>
        <DataGrid.Columns>
          <DataGridTextColumn Header="DATE" Binding="{Binding DateText}" Width="1*" MinWidth="95" />
          <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="1.3*" MinWidth="120" />
          <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountText}" Width="1.1*" MinWidth="110" />
          <DataGridTextColumn Header="PAYEE" Binding="{Binding PayeeText}" Width="1.2*" MinWidth="110" />
          <DataGridTextColumn Header="SOURCE" Binding="{Binding PaymentSourceDisplay}" Width="1.1*" MinWidth="100" />
          <DataGridTextColumn Header="TILL LINK" Binding="{Binding CashMovementDisplay}" Width="1.1*" MinWidth="95" />
          <DataGridTextColumn Header="NOTES" Binding="{Binding NotesText}" Width="1.8*" MinWidth="130" />
          <DataGridTemplateColumn Header="STATUS" Width="1*" MinWidth="104">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <controls:StatusBadge ToolTip="{Binding StatusText}">
                  <controls:StatusBadge.Style>
                    <Style TargetType="controls:StatusBadge" BasedOn="{StaticResource {x:Type controls:StatusBadge}}">
                      <Setter Property="Tone" Value="Success" />
                      <Setter Property="Label" Value="Active" />
                      <Setter Property="Icon" Value="check" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVoid}" Value="True">
                          <Setter Property="Tone" Value="Neutral" />
                          <Setter Property="Label" Value="Voided" />
                          <Setter Property="Icon" Value="ban" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:StatusBadge.Style>
                </controls:StatusBadge>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <!-- Bottom Action Bar -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <WrapPanel Margin="0,0,0,-8">
        <Button Content="Edit" Command="{Binding EditCommand}" MinWidth="90" Margin="0,0,8,8"
                Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="Void" Command="{Binding VoidCommand}" MinWidth="90" Margin="0,0,8,8"
                Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
      </WrapPanel>
    </Grid>

    <!-- Expense Editor Sidebar -->
    <Border Grid.Column="1" Grid.RowSpan="4" Style="{StaticResource Card}" Width="400" Margin="20,0,0,0"
            DataContext="{Binding Editor}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,20" />

            <TextBlock Text="Date *" Style="{StaticResource Text.Label}" />
            <DatePicker SelectedDate="{Binding ExpenseDate}" Margin="0,0,0,14" />

            <TextBlock Text="Category *" Style="{StaticResource Text.Label}" />
            <ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding SelectedCategory}"
                      DisplayMemberPath="Name" Margin="0,0,0,14" />

            <TextBlock Text="Amount (₹) *" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" Margin="0,0,0,14" />

            <TextBlock Text="Payment source *" Style="{StaticResource Text.Label}" />
            <ComboBox ItemsSource="{Binding PaymentSources}" SelectedItem="{Binding SelectedPaymentSource}"
                      DisplayMemberPath="DisplayName" Margin="0,0,0,14" />

            <!-- Cash Movement Link (Visible when Cash drawer selected) -->
            <StackPanel Visibility="{Binding IsCashDrawerSource, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14">
              <TextBlock Text="Till Cash Movement # (Optional)" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding CashMovementIdText, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" />
              <TextBlock Text="Enter the shift pay-out movement ID if taken from the till drawer."
                         Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="Payee / Recipient" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Payee, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" Margin="0,0,0,14" />

            <TextBlock Text="Notes" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="512"
                     TextWrapping="Wrap" AcceptsReturn="True" Height="70" Margin="0,0,0,14" />

            <Border Style="{StaticResource Banner.Error}" Margin="0,8,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
              <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="Cancel" Command="{Binding DataContext.CancelEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <Button Grid.Column="2" Content="{Binding SaveText}" Style="{StaticResource Button.Primary}"
                  Command="{Binding DataContext.SaveEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
      </Grid>
    </Border>

    <!-- Categories Drawer Modal/Overlay -->
    <Border Grid.Column="1" Grid.RowSpan="4" Style="{StaticResource Card}" Width="520" Margin="20,0,0,0"
            Visibility="{Binding IsCategoriesDrawerOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="12,12,12,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Expense Categories" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Command="{Binding CloseCategoriesDrawerCommand}" ToolTip="Close categories">
            <TextBlock Text="&#xE711;" Style="{StaticResource Text.Icon}" />
          </Button>
        </Grid>

        <expenses:ExpenseCategoriesView Grid.Row="1" DataContext="{Binding CategoriesViewModel}" Margin="0" />
      </Grid>
    </Border>

  </Grid>
</UserControl>

