<UserControl x:Class="HotelPOS.Desktop.Modules.Expenses.ExpenseCategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:expenses="clr-namespace:HotelPOS.Desktop.Modules.Expenses"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance expenses:ExpenseCategoriesViewModel}"
             d:DesignWidth="1100" d:DesignHeight="640">

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top Action Bar -->
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Text="Manage expense categories for cost accounting and P&amp;L reporting."
                 Style="{StaticResource Text.Caption}" FontSize="14" VerticalAlignment="Center" />

      <Button Grid.Column="1" Command="{Binding LoadCommand}" ToolTip="Reload from server" VerticalAlignment="Center">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>

      <Button Grid.Column="2" Command="{Binding NewCategoryCommand}" Style="{StaticResource Button.Primary}"
              Margin="8,0,0,0" VerticalAlignment="Center"
              Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="14" />
          <TextBlock Text="New category" Margin="8,0,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Error Banner -->
    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <!-- Categories DataGrid -->
    <Grid Grid.Row="2">
      <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                controls:SelectorBehaviors.ScrollSelectedIntoView="True" HorizontalScrollBarVisibility="Disabled">
        <DataGrid.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
        </DataGrid.InputBindings>
        <DataGrid.Columns>
          <DataGridTextColumn Header="ORDER" Binding="{Binding SortOrder}" Width="0.5*" MinWidth="70" />
          <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.5*" MinWidth="150" />
          <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="2*" MinWidth="200" />
          <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="0.8*" MinWidth="90" />
        </DataGrid.Columns>
      </DataGrid>

      <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <!-- Bottom Actions -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0"
                Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
      <Button Content="Edit" Command="{Binding EditCommand}" MinWidth="90" Margin="0,0,8,0" />
      <Button Content="{Binding SelectedCategory.ToggleActionText, FallbackValue='Deactivate'}"
              Command="{Binding ToggleActiveCommand}" MinWidth="110" />
    </StackPanel>

    <!-- Editor Drawer -->
    <Border Grid.Column="1" Grid.RowSpan="4" Style="{StaticResource Card}" Width="360" Margin="20,0,0,0"
            Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource Text.Title}" Margin="0,0,0,20" />

            <TextBlock Text="Category name *" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Margin="0,0,0,14" />

            <TextBlock Text="Description" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"
                     TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,0,0,14" />

            <TextBlock Text="Sort order" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" Margin="0,0,0,14" />

            <Border Style="{StaticResource Banner.Error}" Margin="0,16,0,0"
                    Visibility="{Binding EditorError, Converter={StaticResource StringToVisibility}}">
              <TextBlock Text="{Binding EditorError}" Style="{StaticResource Text.Error}" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="Cancel" Command="{Binding CloseEditorCommand}" />
          <Button Grid.Column="2" Content="{Binding SaveText}" Style="{StaticResource Button.Primary}"
                  Command="{Binding SaveCommand}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>

