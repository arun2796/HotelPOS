<UserControl x:Class="HotelPOS.Desktop.Modules.MenuAdmin.MenuItemsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="clr-namespace:HotelPOS.Desktop.Modules.MenuAdmin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance m:MenuItemsPageViewModel}"
             d:DesignWidth="1100" d:DesignHeight="640">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="70" MaxWidth="260" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="152" MaxWidth="220" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by name or code">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchItemsCommand}" />
        </TextBox.InputBindings>
      </TextBox>
      <Button Grid.Column="1" Command="{Binding SearchItemsCommand}" Margin="6,0,8,0" ToolTip="Search">
        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" />
      </Button>
      <ComboBox Grid.Column="2" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}" DisplayMemberPath="Name" />
      <CheckBox Grid.Column="3" Content="Inactive" IsChecked="{Binding ShowInactive}" Margin="12,0,8,0" ToolTip="Also show inactive items (in grey)" />
      <Button Grid.Column="5" Command="{Binding RefreshListCommand}" ToolTip="Reload from the server">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>
      <Button Grid.Column="6" Command="{Binding NewItemCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="14" />
          <TextBlock Text="New item" Margin="8,0,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <!-- List -->
    <Grid Grid.Row="2">
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" HorizontalScrollBarVisibility="Disabled">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsActive}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                <Setter Property="FontStyle" Value="Italic" />
                <Setter Property="ToolTip" Value="Inactive: not on the menu" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
        </DataGrid.InputBindings>
        <DataGrid.Columns>
          <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="0.55*" MinWidth="58" />
          <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.8*" MinWidth="120" />
          <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="0.9*" MinWidth="90" />
          <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat=N2}" Width="0.7*" MinWidth="72" />
          <DataGridTextColumn Header="TAX" Binding="{Binding TaxRatePercent, StringFormat={}{0:0.##}%}" Width="0.45*" MinWidth="52" />
          <DataGridTextColumn Header="STATION" Binding="{Binding StationName}" Width="1.1*" MinWidth="100" />
          <DataGridCheckBoxColumn Header="IN STOCK" Binding="{Binding IsAvailable, Mode=OneWay}" Width="0.6*" MinWidth="88" />
        </DataGrid.Columns>
      </DataGrid>
      <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Edit" Command="{Binding EditCommand}" MinWidth="90" />
      <Button Content="{Binding SoldOutText}" Command="{Binding ToggleSoldOutCommand}" Margin="8,0,0,0" MinWidth="150" />
    </StackPanel>

    <!-- Editor panel -->
    <Border Grid.Column="1" Grid.RowSpan="4" Style="{StaticResource Card}" Width="380" Margin="16,0,0,0" Padding="20"
            DataContext="{Binding Editor}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

            <!-- Picture -->
            <Grid Margin="0,0,0,14" Visibility="{Binding CanEditPicture, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="96" Height="96" CornerRadius="8" Background="{DynamicResource Brush.SurfaceAlt}"
                      BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                  <TextBlock Text="&#xEB9F;" Style="{StaticResource Text.Icon}" FontSize="30" HorizontalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}" />
                  <Image Source="{Binding ImageFile, Converter={StaticResource ImageFile}}" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <Button Content="Choose picture…" HorizontalAlignment="Left"
                        Command="{Binding DataContext.ChoosePictureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Button Content="Remove picture" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Visibility="{Binding HasPicture, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding DataContext.RemovePictureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Text="JPEG or PNG, up to 2 MB" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,0,0,12" />

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Price" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Code (optional)" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="20" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Category" Style="{StaticResource Text.Label}" />
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" Margin="0,0,0,12" />

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Tax" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding Taxes}" SelectedItem="{Binding Tax}" DisplayMemberPath="Name" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Prepared at" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding Stations}" SelectedItem="{Binding Station}" DisplayMemberPath="Name" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Description (optional)" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap"
                     AcceptsReturn="False" MinHeight="60" VerticalContentAlignment="Top" Margin="0,0,0,12" />

            <TextBlock Text="Sort order in its category" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Margin="0,0,0,12" />

            <CheckBox Content="Available (untick when sold out)" IsChecked="{Binding IsAvailable}" Margin="0,0,0,6" />
            <CheckBox Content="Active (on the menu)" IsChecked="{Binding IsActive}" Margin="0,0,0,14"
                      Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />

            <TextBlock Text="Modifier groups offered with this item" Style="{StaticResource Text.Label}" />
            <ItemsControl ItemsSource="{Binding ModifierGroups}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type m:ModifierChoiceViewModel}">
                  <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Banner.Error}" Margin="0,16,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
              <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="Close"
                  Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <Button Grid.Column="2" Content="{Binding SaveText}" Style="{StaticResource Button.Primary}"
                  Command="{Binding DataContext.SaveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
