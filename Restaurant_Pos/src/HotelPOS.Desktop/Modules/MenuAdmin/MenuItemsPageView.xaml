<UserControl x:Class="HotelPOS.Desktop.Modules.MenuAdmin.MenuItemsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="clr-namespace:HotelPOS.Desktop.Modules.MenuAdmin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance m:MenuItemsPageViewModel}"
             d:DesignWidth="1100" d:DesignHeight="640">

  <UserControl.Resources>
    <m:MenuItemStockTextConverter x:Key="StockText" />
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="70" MaxWidth="260" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="152" MaxWidth="220" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by name or code">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchItemsCommand}" />
        </TextBox.InputBindings>
      </TextBox>
      <Button Grid.Column="1" Command="{Binding SearchItemsCommand}" Margin="6,0,8,0" ToolTip="Search">
        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" />
      </Button>
      <ComboBox Grid.Column="2" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}" DisplayMemberPath="Name" />
      <CheckBox Grid.Column="3" Content="Inactive" IsChecked="{Binding ShowInactive}" Margin="12,0,8,0" ToolTip="Also show inactive items (in grey)" />
      <Button Grid.Column="5" Command="{Binding RefreshListCommand}" ToolTip="Reload from the server">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>
      <Button Grid.Column="6" Command="{Binding NewItemCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="14" />
          <TextBlock Text="New item" Margin="8,0,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <Grid Grid.Row="2">
      <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" controls:SelectorBehaviors.ScrollSelectedIntoView="True" HorizontalScrollBarVisibility="Disabled">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Item.IsActive}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                <Setter Property="FontStyle" Value="Italic" />
                <Setter Property="ToolTip" Value="Inactive: not on the menu" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
        </DataGrid.InputBindings>
        <DataGrid.Columns>
          <!-- The picture (or the initials tile while there is none), the name and the code. -->
          <DataGridTemplateColumn Header="ITEM" Width="2.2*" MinWidth="190">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type m:MenuItemRowViewModel}">
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Brush.PrimarySoft}" ClipToBounds="True">
                    <Grid>
                      <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Source="{Binding ImageFile, Converter={StaticResource ImageFile}}" Stretch="UniformToFill" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Item.Code}" Style="{StaticResource Text.Caption}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="CATEGORY" Binding="{Binding Item.CategoryName}" Width="0.9*" MinWidth="90" />
          <!-- Each portion with its price: the default is green, a switched-off portion is struck through. -->
          <DataGridTemplateColumn Header="PORTIONS" Width="2*" MinWidth="170">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type m:MenuItemRowViewModel}">
                <ItemsControl ItemsSource="{Binding PortionChips}" Focusable="False" Margin="0,4">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:PortionChip}">
                      <Border CornerRadius="10" BorderThickness="1" Padding="8,1" Margin="0,2,4,2" BorderBrush="{DynamicResource Brush.Border}">
                        <TextBlock Text="{Binding Text}" FontSize="12">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOff}" Value="True">
                                  <Setter Property="TextDecorations" Value="Strikethrough" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="PACKING" Binding="{Binding Item.PackagingCharge, StringFormat=N2}" Width="0.6*" MinWidth="84"
                              ElementStyle="{StaticResource Text.GridNumber}" HeaderStyle="{StaticResource DataGrid.NumberHeader}" />
          <DataGridTextColumn Header="TAX" Binding="{Binding Item.TaxRatePercent, StringFormat={}{0:0.##}%}" Width="0.45*" MinWidth="52" />
          <DataGridTextColumn Header="SOURCE" Binding="{Binding Item.StationName}" Width="1.1*" MinWidth="100" />
          <DataGridTextColumn Header="STOCK" Binding="{Binding Item, Converter={StaticResource StockText}, Mode=OneWay}" Width="0.8*" MinWidth="96" />
          <!-- A template column so the themed CheckBox is used (DataGridCheckBoxColumn draws the plain WPF one). -->
          <DataGridTemplateColumn Header="IN STOCK" Width="0.6*" MinWidth="88">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Item.IsAvailable, Mode=OneWay}" IsHitTestVisible="False" Focusable="False"
                          VerticalAlignment="Center" Margin="4,0,0,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Edit" Command="{Binding EditCommand}" MinWidth="90" />
      <Button Content="{Binding SoldOutText}" Command="{Binding ToggleSoldOutCommand}" Margin="8,0,0,0" MinWidth="150" />
    </StackPanel>

    <Border Grid.Column="1" Grid.RowSpan="4" Style="{StaticResource Card}" Width="380" Margin="16,0,0,0" Padding="20"
            DataContext="{Binding Editor}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

            <Grid Margin="0,0,0,14" Visibility="{Binding CanEditPicture, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="96" Height="96" CornerRadius="8" Background="{DynamicResource Brush.SurfaceAlt}"
                      BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                  <TextBlock Text="&#xEB9F;" Style="{StaticResource Text.Icon}" FontSize="30" HorizontalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}" />
                  <Image Source="{Binding ImageFile, Converter={StaticResource ImageFile}}" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <Button Content="Choose picture…" HorizontalAlignment="Left"
                        Command="{Binding DataContext.ChoosePictureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Button Content="Remove picture" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Visibility="{Binding HasPicture, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding DataContext.RemovePictureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Text="JPEG or PNG, up to 2 MB. Without a picture the menu shows the item's initials." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,0,0,12" />

            <TextBlock Text="Code (optional)" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="20" Margin="0,0,0,12" />

            <!-- Portions & prices: Quarter, Half, Full, 1 KG... Each has its own price; exactly one is the default (the one a
                 waiter sees selected); a portion can be switched off without deleting it. -->
            <TextBlock Text="Portions &amp; prices" Style="{StaticResource Text.Label}" />
            <TextBlock Text="An item with one price keeps the single &quot;Regular&quot; row. Quantity and unit are only a label."
                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Portions}" Focusable="False" AutomationProperties.Name="Portions and prices">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type m:PortionRowViewModel}">
                  <Border BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RadioButton GroupName="PortionDefault" IsChecked="{Binding IsDefault, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0"
                                     ToolTip="Default portion: the one selected first when an item is ordered"
                                     AutomationProperties.Name="Default portion"
                                     Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding}" />
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                 ToolTip="Portion name, for example Quarter, Half, Full or 1 KG" AutomationProperties.Name="Portion name" />
                        <Button Grid.Column="2" Content="&#x2715;" Margin="8,0,0,0" MinWidth="36" ToolTip="Remove this portion"
                                AutomationProperties.Name="Remove portion"
                                Command="{Binding DataContext.RemovePortionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                      </Grid>
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="84" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" ToolTip="Quantity (optional), for example 500"
                                 AutomationProperties.Name="Portion quantity" />
                        <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{x:Static m:PortionRowViewModel.UnitChoices}" SelectedItem="{Binding Unit}"
                                  ToolTip="Unit (optional)" AutomationProperties.Name="Portion unit" />
                        <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                                 ToolTip="Price of this portion" AutomationProperties.Name="Portion price" />
                        <CheckBox Grid.Column="3" Content="On" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding IsActive}"
                                  ToolTip="Switched off: not offered on the menu, kept for history" />
                      </Grid>
                      <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,6,0,0"
                                 Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Add portion" HorizontalAlignment="Left" Margin="0,0,0,14" Command="{Binding AddPortionCommand}" IsEnabled="{Binding CanAddPortion}" />

            <TextBlock Text="Category" Style="{StaticResource Text.Label}" />
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" Margin="0,0,0,12" />

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Tax" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding Taxes}" SelectedItem="{Binding Tax}" DisplayMemberPath="Name" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Source (kitchen)" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding Stations}" SelectedItem="{Binding Station}" DisplayMemberPath="Name" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Packing charge for parcel (0 = use the default in Settings)" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding PackagingCharge, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,0,0,12"
                     ToolTip="Added per unit when the item is packed as a parcel. 0 uses the restaurant-wide default from Admin > Settings > Orders and billing." />

            <TextBlock Text="Description (optional)" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap"
                     AcceptsReturn="False" MinHeight="60" VerticalContentAlignment="Top" Margin="0,0,0,12" />

            <TextBlock Text="HSN/SAC code (optional)" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding HsnSac, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" Margin="0,0,0,4" AutomationProperties.Name="HSN or SAC code" />
            <TextBlock Text="4 to 8 digits. Empty uses the restaurant default (996331 for restaurant service)." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="Sort order in its category" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Margin="0,0,0,12" />

            <CheckBox Content="Available (untick when sold out)" IsChecked="{Binding IsAvailable}" Margin="0,0,0,6" />
            <CheckBox Content="Active (on the menu)" IsChecked="{Binding IsActive}" Margin="0,0,0,14"
                      Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />

            <TextBlock Text="Modifier groups offered with this item" Style="{StaticResource Text.Label}" />
            <ItemsControl ItemsSource="{Binding ModifierGroups}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type m:ModifierChoiceViewModel}">
                  <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Banner.Error}" Margin="0,16,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
              <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="Close"
                  Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <Button Grid.Column="2" Content="{Binding SaveText}" Style="{StaticResource Button.Primary}"
                  Command="{Binding DataContext.SaveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
