<UserControl x:Class="HotelPOS.Desktop.Modules.MenuAdmin.StationsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="clr-namespace:HotelPOS.Desktop.Modules.MenuAdmin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance m:StationsPageViewModel}"
             d:DesignWidth="1100" d:DesignHeight="640">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,16">
      <TextBlock Text="Kitchen tickets are routed to the station that prepares each item."
                 Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,280,0" />
      <Button Command="{Binding NewStationCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="14" />
          <TextBlock Text="New station" Margin="8,0,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <Grid Grid.Row="2">
      <DataGrid ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" HorizontalScrollBarVisibility="Disabled">
        <DataGrid.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
        </DataGrid.InputBindings>
        <DataGrid.Columns>
          <DataGridTextColumn Header="ORDER" Binding="{Binding SortOrder}" Width="0.5*" MinWidth="70" />
          <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*" MinWidth="140" />
          <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="1*" MinWidth="90" />
          <DataGridTextColumn Header="STATUS" Binding="{Binding IsActive, Converter={StaticResource ActiveText}}" Width="0.8*" MinWidth="80" />
        </DataGrid.Columns>
      </DataGrid>
      <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Edit" Command="{Binding EditCommand}" MinWidth="90" />
    </StackPanel>

    <Border Grid.Column="1" Grid.RowSpan="4" Style="{StaticResource Card}" Width="360" Margin="20,0,0,0"
            Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource Text.Title}" Margin="0,0,0,20" />
          <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,0,0,14" />
          <TextBlock Text="Code (shown on kitchen tickets)" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="20" Margin="0,0,0,14" />
          <TextBlock Text="Sort order" Style="{StaticResource Text.Label}" />
          <TextBox Text="{Binding EditSortOrder, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Margin="0,0,0,14" />
          <CheckBox Content="Active" IsChecked="{Binding EditIsActive}" />
          <Border Style="{StaticResource Banner.Error}" Margin="0,16,0,0"
                  Visibility="{Binding EditorError, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding EditorError}" Style="{StaticResource Text.Error}" />
          </Border>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
          <Button Grid.Column="2" Content="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
