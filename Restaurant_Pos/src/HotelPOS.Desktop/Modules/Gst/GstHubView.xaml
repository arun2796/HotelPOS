<UserControl x:Class="HotelPOS.Desktop.Modules.Gst.GstHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:gst="clr-namespace:HotelPOS.Desktop.Modules.Gst"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance gst:GstHubViewModel}"
             d:DesignWidth="1100" d:DesignHeight="720">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <controls:PageHeader Title="GST returns" Description="GSTR-1, GSTR-3B and the HSN/SAC summary from settled bills; export the GSTR-1 JSON for the GST portal.">
      <StackPanel Orientation="Horizontal">
        <Button Command="{Binding ExportJsonCommand}" MinWidth="140" AutomationProperties.Name="Export JSON">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74E;" Style="{StaticResource Text.Icon}" FontSize="14" />
            <TextBlock Text="Export JSON" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ExportExcelCommand}" MinWidth="140" Margin="8,0,0,0" AutomationProperties.Name="Export Excel">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE9F9;" Style="{StaticResource Text.Icon}" FontSize="14" />
            <TextBlock Text="Export Excel" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <Button Command="{Binding SavePdfCommand}" MinWidth="120" Margin="8,0,0,0" AutomationProperties.Name="Save PDF">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE749;" Style="{StaticResource Text.Icon}" FontSize="14" />
            <TextBlock Text="Save PDF" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>
    </controls:PageHeader>

    <controls:ReportFilterBar Grid.Row="1" ShowRange="False" RunCommand="{Binding RunCommand}" RunText="Show">
      <controls:ReportFilterBar.Filters>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Month" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding MonthNames}" SelectedIndex="{Binding MonthIndex}" Width="140" AutomationProperties.Name="Month" />
          <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" Width="100" Margin="8,0,0,0" AutomationProperties.Name="Year" />
          <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Visibility="{Binding IsGstr1Tab, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Section" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Sections}" SelectedIndex="{Binding SelectedSection}" Width="170" AutomationProperties.Name="GSTR-1 section" />
          </StackPanel>
        </StackPanel>
      </controls:ReportFilterBar.Filters>
    </controls:ReportFilterBar>

    <ListBox Grid.Row="2" Style="{StaticResource Hub.Tabs}" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTab}"
             Margin="0,4,0,8" AutomationProperties.Name="GST reports" />

    <StackPanel Grid.Row="3">
      <Border Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
              Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
      </Border>
      <Border Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
              Visibility="{Binding ValidationBanner, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ValidationBanner}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <controls:BusyOverlay Grid.Row="4" IsBusy="{Binding IsBusy}" Message="Preparing the return…">
      <Grid>
        <DataGrid ItemsSource="{Binding Table}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                  HorizontalScrollBarVisibility="Auto" AutoGeneratingColumn="OnAutoGeneratingColumn" />
        <controls:EmptyState Glyph="&#xE9D2;" Title="Nothing to show" Message="This section has no rows for the selected month."
                             Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </controls:BusyOverlay>

    <TextBlock Grid.Row="5" Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
  </Grid>
</UserControl>
