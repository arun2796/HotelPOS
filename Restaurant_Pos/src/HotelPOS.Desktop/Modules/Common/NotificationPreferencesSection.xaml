<UserControl x:Class="HotelPOS.Desktop.Modules.Common.NotificationPreferencesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:admin="clr-namespace:HotelPOS.Desktop.Modules.Admin">

  <!-- Per-kind Pop-up / Sound switches for this terminal. The DataContext only needs a "Notifications" collection of
       NotificationPreferenceItemViewModel (SettingsViewModel and NotificationPreferencesViewModel both have one). -->
  <StackPanel>
    <StackPanel Margin="24,18,24,6">
      <TextBlock Text="Notifications on this terminal" Style="{StaticResource Text.Subtitle}" />
      <TextBlock Text="Saved on this PC only. Tick Pop-up to show a message, Sound to play a sound when it arrives." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Notifications}" Focusable="False" AutomationProperties.AutomationId="NotificationPreferences">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type admin:NotificationPreferenceItemViewModel}">
          <Grid Margin="24,0" MinHeight="36">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" Content="Pop-up" IsChecked="{Binding Toast}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="2" Content="Sound" IsChecked="{Binding Sound}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
