<UserControl x:Class="HotelPOS.Desktop.Modules.Orders.OrderBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:orders="clr-namespace:HotelPOS.Desktop.Modules.Orders"
             xmlns:contracts="clr-namespace:HotelPOS.Contracts.Menu;assembly=HotelPOS.Contracts"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance orders:OrderBuilderViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <UserControl.Resources>
    <Style x:Key="SquareKey" TargetType="Button" BasedOn="{StaticResource Button.Base}">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="OptionButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
          <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="380" />
    </Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="3" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button Command="{Binding BackCommand}" ToolTip="Back to the tables">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72B;" Style="{StaticResource Text.Icon}" FontSize="14" />
            <TextBlock Text="Tables" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" Margin="16,0,0,0" />
      </StackPanel>

      <!-- Channel chips (only when creating new order) -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0"
                  Visibility="{Binding CanSaveDraft, Converter={StaticResource BoolToVisibility}}">
        <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Content="Dine-In" Margin="0,0,6,0"
                     IsChecked="{Binding IsDineIn, Mode=OneWay}" Command="{Binding SelectOrderTypeCommand}" CommandParameter="DineIn" />
        <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Content="Takeaway" Margin="0,0,6,0"
                     IsChecked="{Binding IsTakeaway, Mode=OneWay}" Command="{Binding SelectOrderTypeCommand}" CommandParameter="Takeaway" />
        <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Content="Delivery" Margin="0,0,6,0"
                     IsChecked="{Binding IsDelivery, Mode=OneWay}" Command="{Binding SelectOrderTypeCommand}" CommandParameter="Delivery" />
        <Button Style="{StaticResource Button.Base}" Height="34" Padding="10,0" Margin="10,0,0,0"
                Visibility="{Binding IsDelivery, Converter={StaticResource BoolToVisibility}}"
                Command="{Binding OpenDeliveryDetailsCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7ED;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,6,0" />
            <TextBlock Text="{Binding DeliverySummaryText}" />
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                  Visibility="{Binding CanChangeGuests, Converter={StaticResource BoolToVisibility}}">
        <Button Style="{StaticResource SquareKey}" Content="−" FontSize="20" Command="{Binding DecreaseGuestsCommand}" ToolTip="Fewer guests" />
        <TextBlock Text="{Binding GuestText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" MinWidth="80"
                   TextAlignment="Center" />
        <Button Style="{StaticResource SquareKey}" Content="+" FontSize="20" Command="{Binding IncreaseGuestsCommand}" ToolTip="More guests" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
      <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
              Visibility="{Binding ConnectionBanner, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ConnectionBanner}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap" />
      </Border>
      <Border Style="{StaticResource Banner.Error}" Margin="0,0,0,10"
              Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
      </Border>
    </StackPanel>

    <ListBox Grid.Row="2" Style="{StaticResource ChipList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type contracts:MenuCategoryDto}">
          <TextBlock Text="{Binding Name}" Width="140" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid Grid.Row="2" Grid.Column="1" Margin="8,0,16,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- Search-as-you-type over item name and code across the whole menu (Phase 20.7). -->
    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" Margin="0,0,0,10" VerticalContentAlignment="Center"
             md:HintAssist.Hint="Search name or code" AutomationProperties.Name="Search items" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
      <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type orders:MenuTileViewModel}">
            <!-- Food-image card (Phase 17): picture on top (neutral placeholder when the item has none), name,
                 price and the options hint below. Same command, parameter and sold-out rule as before. -->
            <Button Width="172" Margin="0,0,12,12" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Background="{DynamicResource Brush.Surface}"
                    IsEnabled="{Binding IsSoldOut, Converter={StaticResource InverseBool}}"
                    Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="112" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource Brush.SurfaceSubtle}" CornerRadius="8,8,0,0" ClipToBounds="True">
                  <!-- ClipToBounds ignores CornerRadius in WPF; the mask rounds the picture's top corners to match. -->
                  <Border.OpacityMask>
                    <VisualBrush>
                      <VisualBrush.Visual>
                        <Border Width="170" Height="112" CornerRadius="8,8,0,0" Background="Black" />
                      </VisualBrush.Visual>
                    </VisualBrush>
                  </Border.OpacityMask>
                  <Grid>
                    <TextBlock Text="&#xEB9F;" Style="{StaticResource Text.Icon}" FontSize="30" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}" />
                    <Image Source="{Binding ImageFile, Converter={StaticResource ImageFile}}" Stretch="UniformToFill" />
                    <Border Style="{StaticResource Chip.Danger}" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="{Binding IsSoldOut, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="SOLD OUT" />
                    </Border>
                    <!-- Pin to the Favourites chip (Phase 20.7): a corner star, 40 x 40 touch area, clicks do not add the item. -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="40" Height="40" Padding="0" Margin="2" Background="Transparent" BorderThickness="0"
                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            ToolTip="Pin to Favourites" AutomationProperties.Name="Pin to Favourites">
                      <TextBlock FontSize="22" Text="&#x2606;" Foreground="{DynamicResource Brush.Primary}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter Property="Text" Value="&#x2605;" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Button>
                  </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="12,8,12,10">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxHeight="40" FontSize="14" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}" />
                  <Grid Margin="0,4,0,0">
                    <TextBlock Text="{Binding PriceText}" Foreground="{DynamicResource Brush.Primary}" FontWeight="SemiBold" />
                    <TextBlock Text="+ options" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                               Visibility="{Binding HasModifiers, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Order" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />

        <Grid Grid.Row="1">
          <TextBlock Text="Tap an item to add it." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding IsCartEmpty, Converter={StaticResource BoolToVisibility}}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <ItemsControl ItemsSource="{Binding Cart}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type orders:CartItemViewModel}">
                  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                    <StackPanel>
                      <Grid>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextWrapping="Wrap" Margin="0,0,80,0" />
                        <TextBlock Text="{Binding LineTotalText}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextPrimary}" />
                      </Grid>
                      <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                 Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Style="{StaticResource SquareKey}" Content="−" FontSize="20" ToolTip="One less"
                                Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding Quantity}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="36" TextAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <Button Style="{StaticResource SquareKey}" Content="+" FontSize="20" ToolTip="One more"
                                Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button Style="{StaticResource SquareKey}" Margin="16,0,0,0" ToolTip="Note for the kitchen"
                                Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                          <TextBlock Text="&#xE70F;" Style="{StaticResource Text.Icon}" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource SquareKey}" Margin="8,0,0,0" ToolTip="Remove"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                          <TextBlock Text="&#xE74D;" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Danger}" />
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="SAVE DRAFT" MinHeight="56" Margin="0,0,10,0" Command="{Binding SaveDraftCommand}"
                    Visibility="{Binding CanSaveDraft, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="1" Content="{Binding SendText}" Style="{StaticResource Button.Primary}" MinHeight="56" FontSize="17"
                    Command="{Binding SendCommand}" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.RowSpan="3" Grid.ColumnSpan="3" Background="{DynamicResource Brush.Overlay}" Margin="-16"
          Visibility="{Binding Picker, Converter={StaticResource NullToVisibility}}">
      <Border Style="{StaticResource Dialog.Frame}" Width="560" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center"
              DataContext="{Binding Picker}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Item.Name}" Style="{StaticResource Text.Title}" Margin="0,0,0,12" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type orders:PickerGroupViewModel}">
                  <StackPanel Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Brush.TextPrimary}" />
                      <TextBlock Text="{Binding RuleText}" Style="{StaticResource Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type orders:PickerOptionViewModel}">
                          <Button Style="{StaticResource OptionButton}" CommandParameter="{Binding}"
                                  Command="{Binding DataContext.ToggleOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" />
                              <TextBlock Text="{Binding PriceText}" FontSize="12" HorizontalAlignment="Center"
                                         Visibility="{Binding PriceText, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Border Style="{StaticResource Banner.Error}" Margin="0,0,0,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
              <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
            </Border>
            <Grid>
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SquareKey}" Content="−" FontSize="20" CommandParameter="-1"
                        Command="{Binding DataContext.PickerQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Text="{Binding Quantity}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="40" TextAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <Button Style="{StaticResource SquareKey}" Content="+" FontSize="20" CommandParameter="1"
                        Command="{Binding DataContext.PickerQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="110"
                        Command="{Binding DataContext.CancelPickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Button Content="Add to order" Style="{StaticResource Button.Primary}" MinWidth="150" Margin="10,0,0,0"
                        Command="{Binding DataContext.ConfirmPickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.RowSpan="3" Grid.ColumnSpan="3" Background="{DynamicResource Brush.Overlay}" Margin="-16"
          Visibility="{Binding NoteTarget, Converter={StaticResource NullToVisibility}}">
      <Border Style="{StaticResource Dialog.Frame}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding NoteTarget.Name, StringFormat=Note for {0}}" Style="{StaticResource Text.Title}" Margin="0,0,0,12" />
          <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding}" Margin="0,0,8,8" CommandParameter="{Binding}"
                        Command="{Binding DataContext.AddQuickNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Margin="0,8,0,16" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" MinWidth="110" Command="{Binding CancelNoteCommand}" />
            <Button Content="Save note" Style="{StaticResource Button.Primary}" MinWidth="140" Margin="10,0,0,0" Command="{Binding ApplyNoteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Delivery details dialog overlay -->
    <Grid Grid.RowSpan="3" Grid.ColumnSpan="3" Background="{DynamicResource Brush.Overlay}" Margin="-16"
          Visibility="{Binding IsDeliveryDetailsOpen, Converter={StaticResource BoolToVisibility}}">
      <Border Style="{StaticResource Dialog.Frame}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Delivery details" Style="{StaticResource Text.Title}" Margin="0,0,0,14" />
          <TextBlock Text="Customer name *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
          <TextBlock Text="Phone number *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
          <TextBlock Text="Delivery address *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <TextBox Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="64" Margin="0,0,0,12" />
          <TextBlock Text="Delivery notes" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <TextBox Text="{Binding DeliveryNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Done" Style="{StaticResource Button.Primary}" MinWidth="120" Command="{Binding CloseDeliveryDetailsCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
