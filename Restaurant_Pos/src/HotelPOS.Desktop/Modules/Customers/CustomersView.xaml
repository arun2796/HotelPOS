<UserControl x:Class="HotelPOS.Desktop.Modules.Customers.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:customers="clr-namespace:HotelPOS.Desktop.Modules.Customers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance customers:CustomersViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="160" MaxWidth="340" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by name, phone or GSTIN"
               AutomationProperties.Name="Search customers">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding RunSearchCommand}" />
        </TextBox.InputBindings>
      </TextBox>
      <Button Grid.Column="1" Command="{Binding RunSearchCommand}" Margin="8,0,0,0" ToolTip="Search">
        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" />
      </Button>
      <CheckBox Grid.Column="2" Content="Show inactive" IsChecked="{Binding ShowInactive}" Margin="16,0,16,0" />
      <Button Grid.Column="4" Command="{Binding RefreshListCommand}" ToolTip="Reload from the server">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>
      <Button Grid.Column="5" Command="{Binding NewCustomerCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="14" />
          <TextBlock Text="New customer" Margin="8,0,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <Grid Grid.Row="2">
      <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" controls:SelectorBehaviors.ScrollSelectedIntoView="True" HorizontalScrollBarVisibility="Disabled">
        <DataGrid.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
        </DataGrid.InputBindings>
        <DataGrid.Columns>
          <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.6*" MinWidth="140" />
          <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="1*" MinWidth="100" />
          <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="1.3*" MinWidth="140" />
          <DataGridTextColumn Header="LEGAL NAME" Binding="{Binding LegalName}" Width="1.4*" MinWidth="120" />
          <DataGridTextColumn Header="STATUS" Binding="{Binding IsActive, Converter={StaticResource ActiveText}}" Width="0.7*" MinWidth="80" />
        </DataGrid.Columns>
      </DataGrid>
      <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <WrapPanel Margin="0,0,0,-8">
        <Button Content="Edit" Command="{Binding EditCommand}" MinWidth="90" Margin="0,0,8,8" />
        <Button Content="{Binding ToggleActiveText}" Command="{Binding ToggleActiveCommand}" Margin="0,0,8,8" MinWidth="100" />
      </WrapPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button Command="{Binding PreviousPageCommand}" ToolTip="Previous page">
          <TextBlock Text="&#xE76B;" Style="{StaticResource Text.Icon}" />
        </Button>
        <TextBlock Text="{Binding PageText}" Style="{StaticResource Text.Caption}" FontSize="14" VerticalAlignment="Center" Margin="14,0" />
        <Button Command="{Binding NextPageCommand}" ToolTip="Next page">
          <TextBlock Text="&#xE76C;" Style="{StaticResource Text.Icon}" />
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Column="1" Grid.RowSpan="4" Style="{StaticResource Card}" Width="380" Margin="20,0,0,0"
            DataContext="{Binding Editor}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,20" />

            <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,0,0,14" AutomationProperties.Name="Customer name" />

            <TextBlock Text="Phone" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,0,0,14" AutomationProperties.Name="Phone" />

            <TextBlock Text="Email" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,14" AutomationProperties.Name="Email" />

            <TextBlock Text="GSTIN" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" CharacterCasing="Upper" AutomationProperties.Name="GSTIN" />
            <TextBlock Text="{Binding GstinHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,14" />

            <TextBlock Text="Legal name (as registered)" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,14" AutomationProperties.Name="Legal name" />

            <TextBlock Text="State" Style="{StaticResource Text.Label}" />
            <ComboBox ItemsSource="{Binding StateChoices}" SelectedValuePath="Code" DisplayMemberPath="Name"
                      SelectedValue="{Binding StateCode}" Margin="0,0,0,14" AutomationProperties.Name="State" />

            <TextBlock Text="Address" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True"
                     MinHeight="64" AutomationProperties.Name="Address" />

            <Border Style="{StaticResource Banner.Error}" Margin="0,16,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
              <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="Cancel"
                  Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <Button Grid.Column="2" Content="{Binding SaveText}" Style="{StaticResource Button.Primary}"
                  Command="{Binding DataContext.SaveCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
