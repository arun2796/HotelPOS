<UserControl x:Class="HotelPOS.Desktop.Modules.Billing.BillDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:billing="clr-namespace:HotelPOS.Desktop.Modules.Billing"
             xmlns:contracts="clr-namespace:HotelPOS.Contracts.Billing;assembly=HotelPOS.Contracts"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance billing:BillDetailViewModel}"
             d:DesignWidth="1200" d:DesignHeight="720"
             Focusable="True" Loaded="OnLoaded">

  <UserControl.InputBindings>
    <KeyBinding Key="F2" Command="{Binding PayCashCommand}" />
    <KeyBinding Key="F3" Command="{Binding PayCardCommand}" />
    <KeyBinding Key="F4" Command="{Binding PayUpiCommand}" />
    <KeyBinding Key="F9" Command="{Binding PaySplitCommand}" />
    <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <DataTemplate x:Key="AmountRowTemplate" DataType="{x:Type billing:AmountRow}">
      <Grid Margin="0,3,0,0">
        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}"
                   TextTrimming="CharacterEllipsis" Margin="0,0,100,0" />
        <TextBlock Text="{Binding Amount}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" />
      </Grid>
    </DataTemplate>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style x:Key="PayButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="420" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.ColumnSpan="2" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Button Command="{Binding BackCommand}" Style="{StaticResource Button.Ghost}" ToolTip="Back to the queue (Esc)" Margin="0,0,8,0">
          <TextBlock Text="&#xE72B;" Style="{StaticResource Text.Icon}" />
        </Button>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="{Binding InvoiceTitle}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Border Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="10" Padding="12,3">
          <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
        </Border>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
      <Border Style="{StaticResource Banner.Info}" Margin="0,0,0,12"
              Visibility="{Binding IsHeldByOther, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <TextBlock Text="{Binding HeldByText}" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"
                     Margin="0,0,140,0" />
          <Button Content="Take over" Command="{Binding TakeOverCommand}" HorizontalAlignment="Right"
                  Visibility="{Binding CanTakeOver, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
              Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
      </Border>
    </StackPanel>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,20,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="20,14,20,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="110" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="ITEM" Style="{StaticResource Text.Label}" />
          <TextBlock Grid.Column="1" Text="QTY" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="2" Text="PRICE" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Text="AMOUNT" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
          <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" Margin="20,0,20,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type billing:BillLineRow}">
                <Grid Margin="0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="110" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Quantity}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{Binding Price}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="{Binding Total}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,10">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE77B;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.TextSecondary}" />
              <TextBlock Text="{Binding CustomerText}" Style="{StaticResource Text.Body}" Margin="8,0,0,0" />
            </StackPanel>
            <Button Content="Customer…" Command="{Binding ShowCustomerCommand}" HorizontalAlignment="Right" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid>
              <TextBlock Text="Subtotal" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" />
              <TextBlock Text="{Binding SubtotalText}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DiscountLabel}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center" MaxWidth="230" TextTrimming="CharacterEllipsis" />
                <Button Content="DISCOUNT" Command="{Binding ShowDiscountCommand}" Style="{StaticResource Button.Link}" Margin="8,0,0,0"
                        IsEnabled="{Binding CanEdit}" />
              </StackPanel>
              <TextBlock Text="{Binding DiscountText}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.Success}"
                         Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding TaxRows}" ItemTemplate="{StaticResource AmountRowTemplate}" Focusable="False" Margin="0,4,0,0" />
            <Grid Margin="0,3,0,0" Visibility="{Binding HasRoundOff, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Round off" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" />
              <TextBlock Text="{Binding RoundOffText}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" />
            </Grid>
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
              <Grid>
                <TextBlock Text="TOTAL" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GrandTotalText}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Right"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
              </Grid>
            </Border>
            <StackPanel Visibility="{Binding HasPayments, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
              <ItemsControl ItemsSource="{Binding PaymentRows}" ItemTemplate="{StaticResource AmountRowTemplate}" Focusable="False" />
              <Grid Margin="0,6,0,0">
                <TextBlock Text="Balance due" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding BalanceText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Row="1" Margin="0,16,0,0">
        <UniformGrid Columns="2">
          <Button Content="CASH  F2" Command="{Binding PayCashCommand}" Style="{StaticResource PayButton}" IsEnabled="{Binding CanPay}" />
          <Button Content="CARD  F3" Command="{Binding PayCardCommand}" Style="{StaticResource PayButton}" IsEnabled="{Binding CanPay}" />
          <Button Content="UPI  F4" Command="{Binding PayUpiCommand}" Style="{StaticResource PayButton}" IsEnabled="{Binding CanPay}" />
          <Button Content="SPLIT  F9" Command="{Binding PaySplitCommand}" Style="{StaticResource PayButton}" IsEnabled="{Binding CanPay}" />
        </UniformGrid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Button Content="{Binding FinalizeText}" Command="{Binding FinalizeCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanFinalize}" />
          <Button Grid.Column="1" Content="REOPEN" Command="{Binding ReopenCommand}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanReopen}" />
          <Button Grid.Column="2" Content="VOID" Command="{Binding VoidCommand}" Style="{StaticResource ActionButton}" Foreground="{DynamicResource Brush.Danger}"
                  IsEnabled="{Binding CanVoid}" />
        </Grid>
      </StackPanel>
    </Grid>

    <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Margin="-24" Background="{DynamicResource Brush.Overlay}"
          Visibility="{Binding IsPanelOpen, Converter={StaticResource BoolToVisibility}}">
      <Border Style="{StaticResource Card}" Width="620" MaxHeight="660" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

              <StackPanel Visibility="{Binding IsDiscountPanel, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Discount" Style="{StaticResource Text.Title}" />
                <TextBlock Text="Choose a predefined discount, or enter one with a reason. Large discounts need a manager." Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap" Margin="0,4,0,12" />
                <ItemsControl ItemsSource="{Binding Discounts}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type billing:DiscountRow}">
                      <Button MinHeight="52" MinWidth="130" Margin="0,0,8,8"
                              Command="{Binding DataContext.ApplyPredefinedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <StackPanel>
                          <TextBlock Text="{Binding Discount.Name}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                          <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Manual discount" Style="{StaticResource Text.Label}" Margin="0,10,0,0" />
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ComboBox SelectedIndex="{Binding ManualKind}">
                    <ComboBoxItem Content="Percent %" />
                    <ComboBoxItem Content="Amount" />
                  </ComboBox>
                  <TextBox Grid.Column="2" Text="{Binding ManualValue, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" ToolTip="Value" />
                  <TextBox Grid.Column="4" Text="{Binding ManualReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" ToolTip="Reason" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="APPLY" Command="{Binding ApplyManualCommand}" Style="{StaticResource Button.Primary}" MinWidth="120" />
                  <Button Content="REMOVE DISCOUNT" Command="{Binding RemoveDiscountCommand}" Margin="12,0,0,0"
                          Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </StackPanel>

              <StackPanel Visibility="{Binding IsCustomerPanel, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Customer details" Style="{StaticResource Text.Title}" />
                <TextBlock Text="Printed on the invoice. A GSTIN is needed for a business (B2B) invoice." Style="{StaticResource Text.Caption}" Margin="0,4,0,12" />
                <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,0,0,12" />
                <TextBlock Text="Phone" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,0,0,12" />
                <TextBlock Text="GSTIN" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding CustomerGstin, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" CharacterCasing="Upper" />
                <Button Content="SAVE" Command="{Binding SaveCustomerCommand}" Style="{StaticResource Button.Primary}" MinWidth="120"
                        HorizontalAlignment="Left" Margin="0,16,0,0" />
              </StackPanel>

              <StackPanel Visibility="{Binding IsPaymentPanel, Converter={StaticResource BoolToVisibility}}">
                <ContentControl Content="{Binding Payment}" Focusable="False">
                  <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type billing:PaymentViewModel}">
                      <StackPanel>
                        <Grid>
                          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
                          <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Text.Body}">
                            <Run Text="Balance" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <Run Text="{Binding BalanceText, Mode=OneWay}" FontWeight="Bold" FontSize="20" />
                          </TextBlock>
                        </Grid>

                        <Grid Margin="0,16,0,0" Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="230" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="Amount" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" FontSize="22" MaxLength="12"
                                     GotKeyboardFocus="OnAmountFocus" />
                            <StackPanel Visibility="{Binding IsCash, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Text="Cash received" Style="{StaticResource Text.Label}" Margin="0,12,0,0" />
                              <TextBox Text="{Binding TenderedText, UpdateSourceTrigger=PropertyChanged}" FontSize="22" MaxLength="12"
                                       GotKeyboardFocus="OnTenderedFocus" />
                              <ItemsControl ItemsSource="{Binding QuickTenders}" Focusable="False" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="{x:Type billing:QuickTenderOption}">
                                    <Button Content="{Binding Label}" MinWidth="76" MinHeight="44" Margin="0,0,6,6"
                                            Command="{Binding DataContext.QuickTenderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Border Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="8" Padding="12,8" Margin="0,6,0,0">
                                <Grid>
                                  <TextBlock Text="Change" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding ChangeText}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"
                                             Foreground="{DynamicResource Brush.TextPrimary}" />
                                </Grid>
                              </Border>
                            </StackPanel>
                            <StackPanel Visibility="{Binding NeedsReference, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Text="Reference / approval code" Style="{StaticResource Text.Label}" Margin="0,12,0,0" />
                              <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <UniformGrid Columns="3">
                              <Button Style="{StaticResource NumPadKey}" Content="1" Command="{Binding DigitCommand}" CommandParameter="1" />
                              <Button Style="{StaticResource NumPadKey}" Content="2" Command="{Binding DigitCommand}" CommandParameter="2" />
                              <Button Style="{StaticResource NumPadKey}" Content="3" Command="{Binding DigitCommand}" CommandParameter="3" />
                              <Button Style="{StaticResource NumPadKey}" Content="4" Command="{Binding DigitCommand}" CommandParameter="4" />
                              <Button Style="{StaticResource NumPadKey}" Content="5" Command="{Binding DigitCommand}" CommandParameter="5" />
                              <Button Style="{StaticResource NumPadKey}" Content="6" Command="{Binding DigitCommand}" CommandParameter="6" />
                              <Button Style="{StaticResource NumPadKey}" Content="7" Command="{Binding DigitCommand}" CommandParameter="7" />
                              <Button Style="{StaticResource NumPadKey}" Content="8" Command="{Binding DigitCommand}" CommandParameter="8" />
                              <Button Style="{StaticResource NumPadKey}" Content="9" Command="{Binding DigitCommand}" CommandParameter="9" />
                              <Button Style="{StaticResource NumPadKey}" Content="C" Command="{Binding ClearFieldCommand}" ToolTip="Clear" />
                              <Button Style="{StaticResource NumPadKey}" Content="0" Command="{Binding DigitCommand}" CommandParameter="0" />
                              <Button Style="{StaticResource NumPadKey}" Command="{Binding BackspaceCommand}" ToolTip="Delete last digit">
                                <TextBlock Text="&#xE750;" Style="{StaticResource Text.Icon}" />
                              </Button>
                            </UniformGrid>
                          </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibility}}">
                          <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type billing:PaymentLineViewModel}">
                                <Grid Margin="0,0,0,8">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding Method.Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                  <TextBox Grid.Column="1" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" IsReadOnly="{Binding IsPaid}" />
                                  <TextBox Grid.Column="2" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="8,0,0,0"
                                           ToolTip="Reference" IsReadOnly="{Binding IsPaid}"
                                           Visibility="{Binding NeedsReference, Converter={StaticResource BoolToVisibility}}" />
                                  <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Margin="4,0,0,0" ToolTip="Remove"
                                          Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource Text.Icon}" FontSize="12" />
                                  </Button>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Add:" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ItemsControl ItemsSource="{Binding Methods}" Focusable="False">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type contracts:PaymentMethodDto}">
                                  <Button Content="{Binding Name}" MinWidth="80" Margin="0,0,6,0"
                                          Command="{Binding DataContext.AddLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                          <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Body}">
                            <Run Text="Remaining" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <Run Text="{Binding RemainingText, Mode=OneWay}" FontWeight="Bold" />
                          </TextBlock>
                        </StackPanel>

                        <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                                   Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibility}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </StackPanel>

              <StackPanel Visibility="{Binding IsPreviewPanel, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                  <TextBlock Text="Invoice preview" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="PRINT PREVIEW" Command="{Binding PreviewInvoiceCommand}" MinHeight="40" />
                    <Button Content="PRINT" Command="{Binding PrintInvoiceCommand}" Style="{StaticResource Button.Primary}" MinHeight="40" MinWidth="110" Margin="8,0,0,0" />
                  </StackPanel>
                </Grid>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,8,0,0"
                        Background="{DynamicResource Brush.SurfaceAlt}" TextElement.FontFamily="Consolas">
                  <StackPanel>
                    <TextBlock Text="{Binding RestaurantName}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding RestaurantAddress}" HorizontalAlignment="Center"
                               Visibility="{Binding RestaurantAddress, Converter={StaticResource StringToVisibility}}" />
                    <TextBlock HorizontalAlignment="Center" Visibility="{Binding RestaurantGstin, Converter={StaticResource StringToVisibility}}">
                      <Run Text="GSTIN" />
                      <Run Text="{Binding RestaurantGstin, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="TAX INVOICE" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding InvoiceTitle}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Text="{Binding CustomerText}" />
                    <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type billing:BillLineRow}">
                          <Grid>
                            <TextBlock Margin="0,0,90,0" TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding Quantity, Mode=OneWay}" />
                              <Run Text="x" />
                              <Run Text="{Binding Name, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Total}" HorizontalAlignment="Right" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,8,0,0">
                      <TextBlock Text="Subtotal" />
                      <TextBlock Text="{Binding SubtotalText}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="Discount" />
                      <TextBlock Text="{Binding DiscountText}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TaxRows}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type billing:AmountRow}">
                          <Grid>
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Text="{Binding Amount}" HorizontalAlignment="Right" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Visibility="{Binding HasRoundOff, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="Round off" />
                      <TextBlock Text="{Binding RoundOffText}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <TextBlock Text="TOTAL" FontWeight="Bold" />
                      <TextBlock Text="{Binding GrandTotalText}" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding ReceiptFooter}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Visibility="{Binding IsDonePanel, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Success}" />
                <TextBlock Text="PAID" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock Text="{Binding InvoiceTitle}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" />
                <TextBlock Text="Change to give back" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock Text="{Binding ChangeDueText}" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <ItemsControl ItemsSource="{Binding PaymentRows}" ItemTemplate="{StaticResource AmountRowTemplate}" Focusable="False"
                              Width="360" Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                  <Button Content="PRINT RECEIPT" Command="{Binding PrintReceiptCommand}" MinHeight="44" MinWidth="150" />
                  <Button Content="PRINT INVOICE" Command="{Binding PrintInvoiceCommand}" MinHeight="44" MinWidth="150" Margin="8,0,0,0" />
                </StackPanel>
              </StackPanel>

              <Border Style="{StaticResource Banner.Error}" Margin="0,14,0,0"
                      Visibility="{Binding PanelError, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding PanelError}" Style="{StaticResource Text.Error}" />
              </Border>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Close" Command="{Binding ClosePanelCommand}" MinWidth="110" MinHeight="52"
                    Visibility="{Binding IsDonePanel, Converter={StaticResource InverseBoolToVisibility}}" />
            <Button Content="CONFIRM" Command="{Binding ConfirmPaymentCommand}" Style="{StaticResource Button.Primary}"
                    MinWidth="160" MinHeight="52" Margin="12,0,0,0" IsEnabled="{Binding Payment.IsValid, FallbackValue=False}"
                    Visibility="{Binding IsPaymentPanel, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="NEXT BILL" Command="{Binding NextBillCommand}" Style="{StaticResource Button.Primary}"
                    MinWidth="160" MinHeight="52"
                    Visibility="{Binding IsDonePanel, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
