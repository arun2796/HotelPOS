<UserControl x:Class="HotelPOS.Desktop.Modules.Billing.CashierWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             xmlns:billing="clr-namespace:HotelPOS.Desktop.Modules.Billing"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance billing:CashierWorkspaceViewModel}"
             d:DesignWidth="1300" d:DesignHeight="720"
             Focusable="True" Loaded="OnLoaded" SizeChanged="OnSizeChanged">

  <!-- Phase 21.3: queue 400 px · bill · payment 340 px. Below 1440 px the shell collapses the sidebar so the three panes fit at
       1366; should the page still be narrower than 1180 px (sidebar expanded by hand) the queue drops to 340 px, never a horizontal scroll. -->
  <UserControl.InputBindings>
    <!-- D6: F2 = the cash method, F3… the other configured methods in sort order (PaymentMethodButton.Build), F9 = split. -->
    <KeyBinding Key="F2" Command="{Binding Detail.PayHotkeyCommand}" CommandParameter="F2" />
    <KeyBinding Key="F3" Command="{Binding Detail.PayHotkeyCommand}" CommandParameter="F3" />
    <KeyBinding Key="F4" Command="{Binding Detail.PayHotkeyCommand}" CommandParameter="F4" />
    <KeyBinding Key="F5" Command="{Binding Detail.PayHotkeyCommand}" CommandParameter="F5" />
    <KeyBinding Key="F6" Command="{Binding Detail.PayHotkeyCommand}" CommandParameter="F6" />
    <KeyBinding Key="F7" Command="{Binding Detail.PayHotkeyCommand}" CommandParameter="F7" />
    <KeyBinding Key="F8" Command="{Binding Detail.PayHotkeyCommand}" CommandParameter="F8" />
    <KeyBinding Key="F9" Command="{Binding Detail.PaySplitCommand}" />
    <KeyBinding Key="Escape" Command="{Binding Detail.BackCommand}" />
  </UserControl.InputBindings>

  <Grid Margin="16,12,16,12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="QueueColumn" Width="400" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition x:Name="BillColumn" Width="*" MinWidth="420" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="340" />
    </Grid.ColumnDefinitions>

    <!-- ============ Queue ============ -->
    <Border Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="16,14,12,0">
          <StackPanel>
            <TextBlock Text="Bills" Style="{StaticResource Text.Subtitle}" />
            <TextBlock Text="{Binding Header}" Style="{StaticResource Text.Caption}" />
          </StackPanel>
          <Button Command="{Binding RefreshListCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right" VerticalAlignment="Top"
                  ToolTip="Reload from the server" AutomationProperties.Name="Reload bills">
            <controls:Icon Kind="refresh" Width="18" Height="18" />
          </Button>
        </Grid>

        <controls:SearchBox Grid.Row="1" Margin="16,12,16,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Placeholder="Search order, table or bill number" AutomationProperties.Name="Search bills" />

        <ItemsControl Grid.Row="2" ItemsSource="{Binding ChannelChips}" Margin="16,8,8,0" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type billing:ChannelFilterChip}">
              <ToggleButton Style="{StaticResource Cashier.FilterChip}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                            Command="{Binding DataContext.SelectChannelFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Channel}" AutomationProperties.Name="{Binding Label}">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Grid.Row="3" ItemsSource="{Binding Chips}" Margin="16,4,8,0" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type billing:QueueFilterChip}">
              <ToggleButton Style="{StaticResource Cashier.FilterChip}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                            Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Filter}" AutomationProperties.Name="{Binding Label}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <Border Style="{StaticResource Cashier.FilterChip.Count}" Visibility="{Binding HasCount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Count}" />
                  </Border>
                </StackPanel>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ListBox Grid.Row="4" Style="{StaticResource Segmented}" SelectedIndex="{Binding SortIndex}" Margin="16,8,16,10"
                 Visibility="{Binding IsPaidFilter, Converter={StaticResource InverseBoolToVisibility}}" AutomationProperties.Name="Sort bills">
          <ListBoxItem Content="Oldest first" />
          <ListBoxItem Content="Highest amount" />
        </ListBox>

        <Border Grid.Row="5" Style="{StaticResource Banner.Error}" Margin="16,0,16,8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
          <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" />
        </Border>

        <controls:EmptyState Grid.Row="6" Icon="receipt" Title="{Binding EmptyTitle}" Message="{Binding EmptyMessage}" Margin="16"
                             Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <ListBox Grid.Row="6" ItemsSource="{Binding Bills}" SelectedItem="{Binding SelectedBill, Mode=TwoWay}"
                 Style="{StaticResource Cashier.Queue}" ItemContainerStyle="{StaticResource Cashier.QueueItem}"
                 ItemTemplate="{StaticResource Cashier.BillCard}" AutomationProperties.Name="Bill queue" />
      </Grid>
    </Border>

    <!-- ============ Bill ============ -->
    <Grid Grid.Column="2">
      <Border Style="{StaticResource Card}" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
        <controls:EmptyState Icon="receipt" Title="Select a bill" Message="Pick a bill from the queue to see its items, totals and payment." />
      </Border>
      <ContentControl Content="{Binding Detail}" ContentTemplate="{StaticResource Cashier.BillTemplate}" Focusable="False"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <!-- ============ Payment ============ -->
    <Grid Grid.Column="4">
      <Border Style="{StaticResource PaymentPanel}" VerticalAlignment="Top" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="Payment" Style="{StaticResource Text.Subtitle}" />
          <TextBlock Text="Amount due" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
          <TextBlock Text="—" Style="{StaticResource PaymentPanel.Due}" Foreground="{DynamicResource Brush.TextTertiary}" />
          <TextBlock Text="The payment form opens with the selected bill." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <ContentControl Content="{Binding Detail}" ContentTemplate="{StaticResource Cashier.PaymentTemplate}" Focusable="False"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <!-- Discount, customer and invoice preview stay overlays; payment and the paid state are inline (right column). -->
    <Grid Grid.ColumnSpan="5" Margin="-16,-12" Background="{DynamicResource Brush.Overlay}"
          Visibility="{Binding Detail.IsOverlayOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
      <ContentControl Content="{Binding Detail}" ContentTemplate="{StaticResource Cashier.PanelsTemplate}" Focusable="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
