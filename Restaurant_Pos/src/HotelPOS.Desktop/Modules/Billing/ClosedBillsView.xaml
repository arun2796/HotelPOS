<UserControl x:Class="HotelPOS.Desktop.Modules.Billing.ClosedBillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:billing="clr-namespace:HotelPOS.Desktop.Modules.Billing"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance billing:ClosedBillsViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="400" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.ColumnSpan="2" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" VerticalAlignment="Center" ToolTip="Business day (empty = today)" />
        <Button Content="Today" Command="{Binding TodayCommand}" Margin="8,0,0,0" />
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="16,0,0,0" MaxLength="50"
                 VerticalContentAlignment="Center" ToolTip="Table, invoice or order number">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <Button Command="{Binding SearchCommand}" Margin="8,0,0,0" ToolTip="Search">
          <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" />
        </Button>
      </StackPanel>
      <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <DataGrid Grid.Row="2" ItemsSource="{Binding Bills}" SelectedItem="{Binding SelectedBill}" HorizontalScrollBarVisibility="Disabled">
      <DataGrid.Columns>
        <DataGridTextColumn Header="INVOICE" Binding="{Binding Invoice}" Width="1.5*" MinWidth="150" />
        <DataGridTextColumn Header="TABLE" Binding="{Binding Bill.TableCode}" Width="0.6*" MinWidth="70" />
        <DataGridTextColumn Header="ORDER" Binding="{Binding Bill.OrderNumber}" Width="0.6*" MinWidth="70" />
        <DataGridTextColumn Header="TIME" Binding="{Binding TimeText}" Width="0.6*" MinWidth="60" />
        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalText}" Width="0.8*" MinWidth="90" />
        <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="1.9*" MinWidth="160" />
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Margin="20,0,0,0" Padding="20">
      <Grid>
        <TextBlock Text="Select a bill to see its payments and refund them." Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                   Visibility="{Binding HasDetail, Converter={StaticResource InverseBoolToVisibility}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DetailTotals}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,10" />
            <ItemsControl ItemsSource="{Binding DetailLines}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="PAYMENTS" Style="{StaticResource Text.Label}" Margin="0,14,0,4" />
            <ItemsControl ItemsSource="{Binding Payments}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type billing:PaymentRow}">
                  <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding AmountText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <Button Content="Refund…" Style="{StaticResource Button.Link}" HorizontalAlignment="Right"
                                Command="{Binding DataContext.RefundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanRefund, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Reprint (Phase 7)" IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
