<UserControl x:Class="HotelPOS.Desktop.Modules.Billing.BillingQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:billing="clr-namespace:HotelPOS.Desktop.Modules.Billing"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance billing:BillingQueueViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,12">
      <TextBlock Text="{Binding Header}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
      <Button Command="{Binding RefreshListCommand}" HorizontalAlignment="Right" ToolTip="Reload from the server">
        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
      </Button>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="&#xE8C7;" Style="{StaticResource Text.Icon}" FontSize="48" HorizontalAlignment="Center"
                 Foreground="{DynamicResource Brush.TextSecondary}" />
      <TextBlock Text="No bills waiting. New requests appear here instantly." Style="{StaticResource Text.Body}"
                 Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,12,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
      <ItemsControl ItemsSource="{Binding Bills}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type billing:BillQueueItemViewModel}">
            <Border Style="{StaticResource Card}" Width="300" Margin="0,0,16,16" Padding="18">
              <StackPanel>
                <Grid>
                  <TextBlock Text="{Binding TableCode}" Style="{StaticResource Text.Display}" />
                  <TextBlock Text="{Binding WaitingText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <TextBlock Text="{Binding OrderText}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding TotalText}" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <Border CornerRadius="10" Padding="10,3" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Visibility="{Binding IsClaimed, Converter={StaticResource BoolToVisibility}}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold">
                    <Run Text="&#x25CF;" />
                    <Run Text="{Binding ClaimBadge, Mode=OneWay}" />
                  </TextBlock>
                </Border>
                <Button Content="OPEN" Style="{StaticResource Button.Primary}" MinHeight="52" Margin="0,14,0,0"
                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
