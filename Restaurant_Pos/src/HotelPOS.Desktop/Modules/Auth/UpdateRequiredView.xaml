<UserControl x:Class="HotelPOS.Desktop.Modules.Auth.UpdateRequiredView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:auth="clr-namespace:HotelPOS.Desktop.Modules.Auth"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance auth:UpdateRequiredViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <Grid Background="{DynamicResource Brush.Background}">
    <Border Style="{StaticResource Card}" Padding="32" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="Update required" Style="{StaticResource Text.Title}" FontSize="24" />
        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="The server was upgraded and needs a newer version of HotelPOS on this terminal before anyone can sign in." />

        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Installed on this terminal" Style="{StaticResource Text.Caption}" Margin="0,0,16,6" />
          <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" FontWeight="SemiBold" />
          <TextBlock Grid.Row="1" Text="Needed by the server" Style="{StaticResource Text.Caption}" Margin="0,0,16,6" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RequiredVersion}" FontWeight="SemiBold" />
          <TextBlock Grid.Row="2" Text="Server version" Style="{StaticResource Text.Caption}" Margin="0,0,16,0" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ServerVersion}" />
        </Grid>

        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,20,0,0"
                   Text="Run the HotelPOS client installer from the server's installation folder (or ask your administrator), then start HotelPOS again. Orders already sent are safe on the server." />

        <StackPanel Margin="0,16,0,0" Visibility="{Binding Offer, Converter={StaticResource NullToVisibility}}">
          <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                     Text="This server has the new version ready. UPDATE NOW downloads it from the server and installs it; HotelPOS restarts by itself." />
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" Margin="0,10,0,0"
                       Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Border Style="{StaticResource Banner.Error}" Margin="0,16,0,0"
                Visibility="{Binding Message, Converter={StaticResource StringToVisibility}}">
          <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Error}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
          <Button Content="Server settings" Command="{Binding OpenServerSettingsCommand}" Margin="0,0,8,0" />
          <Button Content="UPDATE NOW" Command="{Binding UpdateNowCommand}" IsEnabled="{Binding CanUpdate}" Margin="0,0,8,0"
                  Style="{StaticResource Button.Primary}" Visibility="{Binding Offer, Converter={StaticResource NullToVisibility}}" />
          <Button Content="CHECK AGAIN" Command="{Binding CheckAgainCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
