<UserControl x:Class="HotelPOS.Desktop.Modules.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:auth="clr-namespace:HotelPOS.Desktop.Modules.Auth"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance auth:LoginViewModel}"
             d:DesignWidth="1200" d:DesignHeight="760"
             Loaded="OnLoaded">

  <Grid Background="{DynamicResource Brush.Background}">
    <Border Style="{StaticResource Card}" Width="440" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="{Binding RestaurantName}" Style="{StaticResource Text.Caption}" FontSize="15" />
        <TextBlock Text="Sign in" Style="{StaticResource Text.Display}" Margin="0,4,0,24" />

        <Border Style="{StaticResource Banner.Info}" Margin="0,0,0,18"
                Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisibility}}">
          <TextBlock Text="{Binding InfoMessage}" Style="{StaticResource Text.Body}" />
        </Border>

        <TextBlock Text="Username" Style="{StaticResource Text.Label}" />
        <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

        <TextBlock Text="Password" Style="{StaticResource Text.Label}" />
        <PasswordBox x:Name="PasswordInput" Margin="0,0,0,16"
                     controls:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay}" />

        <Border Style="{StaticResource Banner.Error}" Margin="0,0,0,16"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
          <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
        </Border>

        <Button Content="Sign in" Command="{Binding LoginCommand}" Style="{StaticResource Button.Primary}"
                IsDefault="True" MinHeight="52" FontSize="17" />
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,16,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,10,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource Brush.TextSecondary}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ServerState}" Value="Reachable">
                      <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ServerState}" Value="Unreachable">
                      <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ServerState}" Value="Checking">
                      <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <StackPanel Grid.Column="1">
              <TextBlock FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Server status unknown" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ServerState}" Value="Reachable">
                        <Setter Property="Text" Value="Server online" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ServerState}" Value="Unreachable">
                        <Setter Property="Text" Value="Server unreachable" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ServerState}" Value="Checking">
                        <Setter Property="Text" Value="Checking server…" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding ServerAddress}" Style="{StaticResource Text.Caption}" />
              <TextBlock Text="{Binding TerminalDescription}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
              <Button Content="Retry" Command="{Binding CheckServerCommand}" Style="{StaticResource Button.Link}" HorizontalAlignment="Right" />
              <Button Content="Server settings" Command="{Binding OpenServerSettingsCommand}" Style="{StaticResource Button.Link}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
