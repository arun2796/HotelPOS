<UserControl x:Class="HotelPOS.Desktop.Modules.Kitchen.KitchenDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:kitchen="clr-namespace:HotelPOS.Desktop.Modules.Kitchen"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance kitchen:KitchenDisplayViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

  <UserControl.Resources>
    <Style x:Key="TicketButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="16,6" />
    </Style>

    <DataTemplate x:Key="TicketCard" DataType="{x:Type kitchen:TicketCardViewModel}">
      <Border x:Name="Card" Margin="0,0,0,12" CornerRadius="12" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="2" Padding="14,12">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Ticket.TableCode}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
              <Border Background="{DynamicResource Brush.Primary}" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding IsAddBatch, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="+ADD" Foreground="{DynamicResource Brush.PrimaryText}" FontWeight="Bold" FontSize="12" />
              </Border>
            </StackPanel>
            <Border x:Name="Timer" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Padding="10,3"
                    Background="{DynamicResource Brush.SurfaceAlt}">
              <TextBlock x:Name="TimerText" Text="{Binding ElapsedText}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Brush.TextPrimary}" />
            </Border>
          </Grid>
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,8">
            <Run Text="{Binding Ticket.TicketNumber, Mode=OneWay}" />
            <Run Text="·" />
            <Run Text="{Binding Ticket.WaiterName, Mode=OneWay}" />
            <Run Text="·" />
            <Run Text="{Binding StatusText, Mode=OneWay}" />
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type kitchen:TicketLine}">
                <StackPanel Margin="0,2">
                  <TextBlock x:Name="LineText" Text="{Binding Text}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                             Foreground="{DynamicResource Brush.TextPrimary}" />
                  <TextBlock Text="{Binding Modifiers}" Margin="18,0,0,0" FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                             Visibility="{Binding HasModifiers, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock Text="{Binding Notes}" Margin="18,0,0,0" FontSize="14" FontStyle="Italic" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"
                             Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                    <Setter TargetName="LineText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
            <Button Style="{StaticResource TicketButton}" Content="ACCEPT" CommandParameter="{Binding}"
                    Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Visibility="{Binding ShowAccept, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource TicketButton}" Content="START" CommandParameter="{Binding}"
                    Background="{DynamicResource Brush.Primary}" BorderBrush="{DynamicResource Brush.Primary}" Foreground="{DynamicResource Brush.PrimaryText}"
                    Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Visibility="{Binding ShowStart, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource TicketButton}" Content="READY" CommandParameter="{Binding}"
                    Background="{DynamicResource Brush.Success}" BorderBrush="{DynamicResource Brush.Success}" Foreground="{DynamicResource Brush.PrimaryText}"
                    Command="{Binding DataContext.ReadyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Visibility="{Binding ShowReady, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource TicketButton}" Content="DONE" CommandParameter="{Binding}"
                    Background="{DynamicResource Brush.Success}" BorderBrush="{DynamicResource Brush.Success}" Foreground="{DynamicResource Brush.PrimaryText}"
                    Command="{Binding DataContext.DoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Visibility="{Binding ShowDone, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource TicketButton}" Content="RECALL" CommandParameter="{Binding}"
                    Command="{Binding DataContext.RecallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Visibility="{Binding ShowRecall, Converter={StaticResource BoolToVisibility}}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Urgency}" Value="Warn">
          <Setter TargetName="Timer" Property="Background" Value="{DynamicResource Brush.Warning}" />
          <Setter TargetName="TimerText" Property="Foreground" Value="#FFFFFF" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Urgency}" Value="Late">
          <Setter TargetName="Timer" Property="Background" Value="{DynamicResource Brush.Danger}" />
          <Setter TargetName="TimerText" Property="Foreground" Value="#FFFFFF" />
          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
          <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="TicketColumn" TargetType="ItemsControl">
      <Setter Property="ItemTemplate" Value="{StaticResource TicketCard}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ItemsControl">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" CanContentScroll="True">
              <ItemsPresenter />
            </ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="5" Margin="0,0,0,12">
      <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" Margin="0,0,280,0">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type kitchen:StationFilter}">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Content="Sold out…" Command="{Binding OpenSoldOutCommand}" MinWidth="120" />
        <Button Command="{Binding RefreshListCommand}" Margin="8,0,0,0" ToolTip="Reload from the server">
          <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Grid.ColumnSpan="5" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <DockPanel Grid.Row="2" Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Text="{Binding NewHeader}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
      <ItemsControl Style="{StaticResource TicketColumn}" ItemsSource="{Binding NewTickets}" />
    </DockPanel>
    <DockPanel Grid.Row="2" Grid.Column="2">
      <TextBlock DockPanel.Dock="Top" Text="{Binding PreparingHeader}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
      <ItemsControl Style="{StaticResource TicketColumn}" ItemsSource="{Binding PreparingTickets}" />
    </DockPanel>
    <DockPanel Grid.Row="2" Grid.Column="4">
      <TextBlock DockPanel.Dock="Top" Text="{Binding ReadyHeader}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
      <ItemsControl Style="{StaticResource TicketColumn}" ItemsSource="{Binding ReadyTickets}" />
    </DockPanel>

    <Grid Grid.RowSpan="3" Grid.ColumnSpan="5" Background="{DynamicResource Brush.Overlay}" Margin="-16"
          Visibility="{Binding IsSoldOutOpen, Converter={StaticResource BoolToVisibility}}">
      <Border Style="{StaticResource Card}" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Item availability" Style="{StaticResource Text.Title}" Margin="0,0,0,12" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <ItemsControl ItemsSource="{Binding MenuItems}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type kitchen:SoldOutItemViewModel}">
                  <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <Button HorizontalAlignment="Right" MinWidth="170" Content="{Binding ActionText}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.ToggleAvailabilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                      <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                      <Setter TargetName="Name" Property="TextDecorations" Value="Strikethrough" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" MinWidth="120" Margin="0,12,0,0" Command="{Binding CloseSoldOutCommand}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
