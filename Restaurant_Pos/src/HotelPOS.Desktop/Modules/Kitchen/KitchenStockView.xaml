<UserControl x:Class="HotelPOS.Desktop.Modules.Kitchen.KitchenStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:kitchen="clr-namespace:HotelPOS.Desktop.Modules.Kitchen"
             xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance kitchen:KitchenStockViewModel}"
             d:DesignWidth="1200" d:DesignHeight="700">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Title="Kitchen stock"
                         Description="What the kitchen has prepared, what is promised to open orders, what was sold, refilled and wasted today, and what is left. Every screen shows these same numbers.">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBlock Text="{Binding LastSyncedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Command="{Binding RefreshCommand}" ToolTip="Reload from the server">
          <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" />
        </Button>
      </StackPanel>
    </controls:PageHeader>

    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Margin="0,0,16,0"
               Visibility="{Binding ShowStock, Converter={StaticResource BoolToVisibility}}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding MovementFilters}" SelectedItem="{Binding SelectedMovementKind}" Margin="0,0,16,0"
               Visibility="{Binding ShowMovements, Converter={StaticResource BoolToVisibility}}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Visibility="{Binding CanSeeMovements, Converter={StaticResource BoolToVisibility}}">
        <Button Content="Stock" Command="{Binding ShowStockListCommand}" Margin="0,0,6,0"
                ToolTip="Current stock of every counted item" />
        <Button Content="Today's movements" Command="{Binding ShowMovementListCommand}"
                ToolTip="Waste, corrections, refills and order movements of today, with who did them" />
      </StackPanel>
      <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0"
                 Visibility="{Binding ShowStock, Converter={StaticResource BoolToVisibility}}" />
    </WrapPanel>

    <Border Grid.Row="2" Style="{StaticResource Banner.Error}" Margin="0,0,0,12"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" />
    </Border>

    <Grid Grid.Row="3">
      <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" HorizontalScrollBarVisibility="Auto"
                Visibility="{Binding ShowStock, Converter={StaticResource BoolToVisibility}}">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsOut}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsLow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="ITEM" Binding="{Binding ItemName}" Width="1.6*" MinWidth="140" />
          <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="1*" MinWidth="90" />
          <DataGridTextColumn Header="STATION" Binding="{Binding Station}" Width="1*" MinWidth="90" />
          <DataGridTextColumn Header="PREPARED" Binding="{Binding Opening}" Width="0.7*" MinWidth="86"
                              ElementStyle="{StaticResource Text.GridNumber}" HeaderStyle="{StaticResource DataGrid.NumberHeader}" />
          <DataGridTextColumn Header="RESERVED" Binding="{Binding Reserved}" Width="0.7*" MinWidth="86"
                              ElementStyle="{StaticResource Text.GridNumber}" HeaderStyle="{StaticResource DataGrid.NumberHeader}" />
          <DataGridTextColumn Header="SOLD" Binding="{Binding Sold}" Width="0.5*" MinWidth="64"
                              ElementStyle="{StaticResource Text.GridNumber}" HeaderStyle="{StaticResource DataGrid.NumberHeader}" />
          <DataGridTextColumn Header="REFILLED" Binding="{Binding Refilled}" Width="0.7*" MinWidth="86"
                              ElementStyle="{StaticResource Text.GridNumber}" HeaderStyle="{StaticResource DataGrid.NumberHeader}" />
          <DataGridTextColumn Header="WASTED" Binding="{Binding Wasted}" Width="0.6*" MinWidth="76"
                              ElementStyle="{StaticResource Text.GridNumber}" HeaderStyle="{StaticResource DataGrid.NumberHeader}" />
          <DataGridTextColumn Header="AVAILABLE" Binding="{Binding Available}" Width="0.8*" MinWidth="92"
                              ElementStyle="{StaticResource Text.GridNumber}" HeaderStyle="{StaticResource DataGrid.NumberHeader}" />
          <DataGridTextColumn Header="LOW AT" Binding="{Binding LowAtText}" Width="0.5*" MinWidth="70"
                              ElementStyle="{StaticResource Text.GridNumber}" HeaderStyle="{StaticResource DataGrid.NumberHeader}" />
          <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="1.2*" MinWidth="130" />
          <DataGridTextColumn Header="LAST UPDATED" Binding="{Binding UpdatedText}" Width="1.6*" MinWidth="170" />
        </DataGrid.Columns>
      </DataGrid>

      <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Visibility="{Binding ShowMovements, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl ItemsSource="{Binding Movements}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type kitchen:StockHistoryRow}">
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="60" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ItemName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding TypeText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding ChangeText}" FontWeight="Bold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="4" Text="{Binding BalanceText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding DetailText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <controls:EmptyState Glyph="&#xE7BF;" Title="No counted items" Message="{Binding SummaryText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
