<Window x:Class="HotelPOS.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:HotelPOS.Desktop.Shell"
        xmlns:ui="clr-namespace:HotelPOS.Desktop.Services.Ui"
        xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance shell:MainViewModel}"
        Title="HotelPOS"
        Width="1366" Height="800"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Body}"
        FontSize="15"
        Foreground="{DynamicResource Brush.TextPrimary}"
        Background="{DynamicResource Brush.Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Grid>
    <ContentControl Content="{Binding CurrentScreen}" Focusable="False" />

    <Grid Background="{DynamicResource Brush.Overlay}"
          Visibility="{Binding Dialogs.Current, Converter={StaticResource NullToVisibility}}">
      <Border Style="{StaticResource Card}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28"
              DataContext="{Binding Dialogs.Current}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
          <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Margin="0,12,0,0" />

          <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Margin="0,18,0,0"
                   Visibility="{Binding IsTextInput, Converter={StaticResource BoolToVisibility}}" />
          <PasswordBox controls:PasswordBoxAssistant.BoundPassword="{Binding Input, Mode=TwoWay}" Margin="0,18,0,0"
                       Visibility="{Binding IsPasswordInput, Converter={StaticResource BoolToVisibility}}" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="110"
                    Visibility="{Binding HasCancel, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="130" Margin="12,0,0,0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <ItemsControl ItemsSource="{Binding Notifications.Items}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,24,52" Width="380" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type ui:ToastViewModel}">
          <Border CornerRadius="10" Padding="16,12" Margin="0,8,0,0" BorderThickness="1">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Command="{Binding CloseCommand}"
                      MinHeight="32" MinWidth="32" Padding="6" Margin="8,-4,-8,-4" ToolTip="Dismiss">
                <TextBlock Text="&#xE711;" Style="{StaticResource Text.Icon}" FontSize="12" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
