<Window x:Class="HotelPOS.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:HotelPOS.Desktop.Shell"
        xmlns:ui="clr-namespace:HotelPOS.Desktop.Services.Ui"
        xmlns:controls="clr-namespace:HotelPOS.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance shell:MainViewModel}"
        Title="HotelPOS"
        Width="1366" Height="800"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Body}"
        FontSize="{DynamicResource Font.Size.Body}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        Background="{DynamicResource Brush.Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Grid>
    <controls:TransitioningContentControl Content="{Binding CurrentScreen}" />

    <Grid Background="{DynamicResource Brush.Overlay}"
          Visibility="{Binding Dialogs.Current, Converter={StaticResource NullToVisibility}}">
      <Grid Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
      <!-- The shadow is drawn by a separate layer so the dialog's text is not rasterised through the effect. -->
      <Border Style="{StaticResource Dialog.Frame}" DataContext="{Binding Dialogs.Current}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
          <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Margin="0,12,0,0" />

          <StackPanel Margin="0,18,0,0" Visibility="{Binding NeedsApprover, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Manager username" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding ApproverUsername, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Password" Style="{StaticResource Text.Label}" Margin="0,10,0,0" />
            <PasswordBox controls:PasswordBoxAssistant.BoundPassword="{Binding Input, Mode=TwoWay}" />
          </StackPanel>
          <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Margin="0,18,0,0"
                   Visibility="{Binding IsTextInput, Converter={StaticResource BoolToVisibility}}" />
          <PasswordBox controls:PasswordBoxAssistant.BoundPassword="{Binding Input, Mode=TwoWay}" Margin="0,18,0,0"
                       Visibility="{Binding IsPasswordInput, Converter={StaticResource BoolToVisibility}}" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="110"
                    Visibility="{Binding HasCancel, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="130" Margin="12,0,0,0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
      </Grid>
    </Grid>

    <!-- Toasts sit top-centre, under the shell's top bar: dialog buttons (centre and bottom-right of a dialog) and the
         pages' action rows (top-right and bottom) stay clear of them. -->
    <ItemsControl ItemsSource="{Binding Notifications.Items}"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Margin="0,64,0,0" Width="420" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type ui:ToastViewModel}">
          <Grid Margin="0,8,0,0">
          <Border CornerRadius="10" Background="{DynamicResource Brush.Surface}" Effect="{DynamicResource Shadow.Popup}" />
          <!-- Toast anatomy (Phase 21): a tone bar on the left, a tone icon, the message and an optional action; the tone is never
               colour alone because the icon differs (check / alert / info). -->
          <Border CornerRadius="10" Padding="0" BorderThickness="1" ClipToBounds="True">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border>
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.Info}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}" Value="Success">
                        <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="Warning">
                        <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="Error">
                        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>
              <Grid Grid.Column="1" Margin="14,12,16,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:Icon Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                  <controls:Icon.Style>
                    <Style TargetType="controls:Icon" BasedOn="{StaticResource {x:Type controls:Icon}}">
                      <Setter Property="Kind" Value="info" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.InfoText}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Success">
                          <Setter Property="Kind" Value="check" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessText}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                          <Setter Property="Kind" Value="alert" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                          <Setter Property="Kind" Value="alert" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:Icon.Style>
                </controls:Icon>
                <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding RunActionCommand}" Style="{StaticResource Button.Primary}"
                        MinHeight="36" Padding="14,4" Margin="10,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Command="{Binding CloseCommand}"
                        MinHeight="32" MinWidth="32" Padding="6" Margin="8,-4,-8,-4" ToolTip="Dismiss">
                  <TextBlock Text="&#xE711;" Style="{StaticResource Text.Icon}" FontSize="12" />
                </Button>
              </Grid>
            </Grid>          </Border>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
