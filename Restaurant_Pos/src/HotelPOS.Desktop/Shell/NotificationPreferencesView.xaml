<UserControl x:Class="HotelPOS.Desktop.Shell.NotificationPreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:HotelPOS.Desktop.Shell"
             xmlns:common="clr-namespace:HotelPOS.Desktop.Modules.Common"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance shell:NotificationPreferencesViewModel}"
             d:DesignWidth="560" d:DesignHeight="640">

  <Border Style="{StaticResource Dialog.Frame}" Width="560" MaxHeight="640" Padding="0,24,0,20">
    <DockPanel>
      <Button DockPanel.Dock="Bottom" Content="Done" Command="{Binding CloseCommand}" Style="{StaticResource Button.Primary}"
              HorizontalAlignment="Right" Margin="24,12,24,0" IsDefault="True" IsCancel="True" />
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <common:NotificationPreferencesSection />
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
