@page "/change-password"
@attribute [Authorize]
@layout EmptyLayout
@using HotelPOS.Contracts.Auth
@inject WebAuthState Auth
@inject WebApiClient Api
@inject NavigationManager Navigation

<PageTitle>Change password · HotelPOS</PageTitle>

@* A password set by an administrator (first sign-in, reset) opens nothing but this page: the server answers every
   other call with PASSWORD_CHANGE_REQUIRED until it is replaced. The same page serves a voluntary change. *@
<div class="signin">
    <div class="card signin-card">
        <div class="signin-hero" aria-hidden="true">
            <span class="signin-mark"><Icon Name="lock" Size="40" /></span>
        </div>
        <h1 class="signin-title">Change your password</h1>
        <p class="muted" data-testid="change-password-why">
            @(Required
                ? "The password you signed in with was set by an administrator. Choose your own before continuing."
                : "Choose a new password for your account.")
        </p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="banner error" role="alert" data-testid="change-password-error">@_error</div>
        }

        <EditForm Model="this" OnValidSubmit="SubmitAsync">
            <label class="field">
                <span>Current password</span>
                <input class="input" type="password" data-testid="current-password" @bind="_current" @bind:event="oninput" autocomplete="current-password" />
            </label>
            <label class="field">
                <span>New password</span>
                <input class="input" type="password" data-testid="new-password" @bind="_new" @bind:event="oninput" autocomplete="new-password" />
            </label>
            <label class="field">
                <span>Repeat new password</span>
                <input class="input" type="password" data-testid="repeat-password" @bind="_repeat" @bind:event="oninput" autocomplete="new-password" />
            </label>
            <button type="submit" class="btn primary block lg" data-testid="save-password"
                    disabled="@(_busy || string.IsNullOrWhiteSpace(_current) || string.IsNullOrWhiteSpace(_new) || string.IsNullOrWhiteSpace(_repeat))">
                @(_busy ? "Saving…" : "Save new password")
            </button>
        </EditForm>

        <div class="signin-foot">
            <span class="muted small">Signed in as <b>@Auth.User?.DisplayName</b></span>
            @if (Required)
            {
                <button type="button" class="btn ghost small" data-testid="sign-out" @onclick="SignOutAsync">Sign out</button>
            }
            else
            {
                <a class="btn ghost small" href="">Cancel</a>
            }
        </div>
    </div>
</div>

@code {
    private string _current = string.Empty;
    private string _new = string.Empty;
    private string _repeat = string.Empty;
    private string? _error;
    private bool _busy;

    private bool Required => Auth.User?.MustChangePassword == true;

    private async Task SubmitAsync()
    {
        if (_new != _repeat)
        {
            _error = "The two new passwords are different.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Api.PostAsync<object>("api/auth/change-password", new ChangePasswordRequest { CurrentPassword = _current, NewPassword = _new });
            if (!result.Success)
            {
                _error = result.Errors.Count > 0 ? string.Join(" ", result.Errors.Select(e => e.Message)) : result.Message;
                return;
            }

            // The session still carries "must change password": renew it from the server, then carry on.
            await Auth.RefreshAsync();
            Navigation.NavigateTo(string.Empty, replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignOutAsync()
    {
        await Auth.SignOutAsync();
        Navigation.NavigateTo("signin", replace: true);
    }
}
