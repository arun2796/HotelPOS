@page "/tables"
@attribute [Authorize]
@implements IDisposable
@using HotelPOS.Contracts.Floor
@using HotelPOS.Contracts.Realtime
@inject WebAuthState Auth
@inject WaiterApi Api
@inject WebRealtimeClient Realtime
@inject DraftStore Drafts
@inject ShellState Shell
@inject ToastService Toasts
@inject NavigationManager Navigation

<PageTitle>Tables · HotelPOS</PageTitle>

@if (!Auth.Has(Permissions.TablesView))
{
    <div class="banner error">You do not have access to the tables.</div>
}
else
{
    <OfflineBanner>Offline — table states may be out of date until the connection is back.</OfflineBanner>

    <div class="chip-row" data-testid="section-chips">
        <FilterChip Label="All" Count="@(_map is null ? null : AllTables.Count)" Selected="@(_sectionId is null)" OnClick="() => _sectionId = null" />
        @foreach (var sec in Sections)
        {
            var zone = sec;
            <FilterChip Label="@zone.Name" Count="@ActiveTables(zone).Count" Selected="@(_sectionId == zone.Id)" OnClick="() => _sectionId = zone.Id" />
        }
    </div>

    @if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="RefreshAsync" />
    }
    else if (_map is null)
    {
        <Skeleton Variant="Skeleton.SkeletonVariant.Card" Count="6" Label="Loading tables" />
    }
    else
    {
        <div class="tables-toolbar">
            <span class="muted small" data-testid="tables-summary">@Summary</span>
            <Segmented Items="SortItems" Selected="@_sort" SelectedChanged="s => _sort = s" />
        </div>

        @if (_sort == AvailableFirst)
        {
            <div class="table-grid" data-testid="table-grid">
                @foreach (var table in VisibleSections.SelectMany(ActiveTables).OrderBy(SortRank).ThenBy(t => t.Code, StringComparer.OrdinalIgnoreCase))
                {
                    var t = table;
                    <TableCard Table="t" Elapsed="@Elapsed(t)" HasDraft="@_draftTables.Contains(t.Id)" OnClick="() => Open(t)" />
                }
            </div>
        }
        else
        {
            @foreach (var sec in VisibleSections)
            {
                @if (_sectionId is null)
                {
                    <h2 class="section-head">@sec.Name</h2>
                }
                <div class="table-grid" data-testid="table-grid">
                    @foreach (var table in ActiveTables(sec))
                    {
                        var t = table;
                        <TableCard Table="t" Elapsed="@Elapsed(t)" HasDraft="@_draftTables.Contains(t.Id)" OnClick="() => Open(t)" />
                    }
                </div>
            }
        }

        @if (AllTables.Count == 0)
        {
            <EmptyState Icon="table" Text="No active tables in this section." />
        }
    }
}

@code {
    private const string BySection = "section";
    private const string AvailableFirst = "available";

    private static readonly IReadOnlyList<TabItem> SortItems = new[] { new TabItem(BySection, "By section"), new TabItem(AvailableFirst, "Available first") };

    private TableMapDto? _map;
    private string? _error;
    private int? _sectionId;
    private string _sort = BySection;
    private TimeSpan _clockOffset;
    private HashSet<int> _draftTables = new();
    private readonly List<IDisposable> _subscriptions = new();
    private CancellationTokenSource? _debounce;
    private Timer? _tick;

    private IEnumerable<TableMapSectionDto> Sections => (_map?.Sections ?? Array.Empty<TableMapSectionDto>()).Where(s => s.IsActive).OrderBy(s => s.SortOrder);
    private IEnumerable<TableMapSectionDto> VisibleSections => Sections.Where(s => _sectionId is null || s.Id == _sectionId);
    private static List<TableDto> ActiveTables(TableMapSectionDto section) => section.Tables.Where(t => t.IsActive).ToList();
    private List<TableDto> AllTables => Sections.SelectMany(ActiveTables).ToList();

    private string Summary
    {
        get
        {
            var tables = AllTables;
            var free = tables.Count(t => t.Status == TableStatus.Available);
            var inUse = tables.Count(t => t.Status is not TableStatus.Available and not TableStatus.OutOfService);
            return $"{free} available · {inUse} in use · {TextFormat.Count(tables.Count, "table")}";
        }
    }

    // Available first, then the tables that need a hand (ready, bill), then the rest; out of service last.
    private static int SortRank(TableDto table) => table.Status switch
    {
        TableStatus.Available => 0,
        TableStatus.Ready => 1,
        TableStatus.Billing => 2,
        TableStatus.OutOfService => 9,
        _ => 3,
    };

    protected override async Task OnInitializedAsync()
    {
        Shell.Set("Tables", "Live table map");
        await Realtime.StartAsync();
        foreach (var name in new[] { HubEvents.TableStatusChanged, HubEvents.OrderUpdated, HubEvents.OrderCancelled, HubEvents.BillUpdated,
                                     HubEvents.KitchenTicketUpdated, HubEvents.OrderReady, HubEvents.OrderAccepted, HubEvents.OrderPreparing, HubEvents.OrderServed, HubEvents.PaymentCompleted })
        {
            _subscriptions.Add(Realtime.Subscribe<System.Text.Json.JsonElement>(name, _ => ScheduleRefresh()));
        }

        Realtime.Reconnected += RefreshAsync;
        _tick = new Timer(_ => _ = InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        var result = await Api.GetTableMapAsync();
        if (result.Success && result.Data is { } map)
        {
            _map = map;
            _clockOffset = map.ServerTimeUtc - DateTime.UtcNow;
            _error = null;
        }
        else if (_map is null)
        {
            _error = result.Message;
        }
        else
        {
            Toasts.Error(result.Message);
        }

        _draftTables = (await Drafts.TablesWithDraftsAsync()).ToHashSet();
        await InvokeAsync(StateHasChanged);
    }

    // Several events arrive for one change; one refresh a quarter second later is enough.
    private void ScheduleRefresh()
    {
        _debounce?.Cancel();
        var cts = _debounce = new CancellationTokenSource();
        _ = Task.Delay(250, cts.Token).ContinueWith(t => { if (!t.IsCanceled) { _ = InvokeAsync(RefreshAsync); } }, TaskScheduler.Default);
    }

    private void Open(TableDto table) => Navigation.NavigateTo($"tables/{table.Id}");

    private string? Elapsed(TableDto table)
    {
        if (table.OccupiedAtUtc is not { } since)
        {
            return null;
        }

        var span = DateTime.UtcNow + _clockOffset - since;
        return span.TotalHours >= 1 ? $"{(int)span.TotalHours} h {span.Minutes} min" : $"{Math.Max(0, (int)span.TotalMinutes)} min";
    }

    public void Dispose()
    {
        Realtime.Reconnected -= RefreshAsync;
        _debounce?.Cancel();
        _tick?.Dispose();
        foreach (var subscription in _subscriptions)
        {
            subscription.Dispose();
        }
    }
}
