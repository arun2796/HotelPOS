@page "/tables/{TableId:int}/order"
@page "/tables/{TableId:int}/order/{OrderId:int}/add"
@page "/tables/{TableId:int}/order/{OrderId:int}/edit"
@page "/orders/new"
@page "/orders/{OrderId:int}/add"
@page "/orders/{OrderId:int}/edit"
@attribute [Authorize]
@implements IDisposable
@using HotelPOS.Contracts.Enums
@using HotelPOS.Contracts.Floor
@using HotelPOS.Contracts.Menu
@using HotelPOS.Contracts.Orders
@using HotelPOS.Contracts.Presentation
@using HotelPOS.Contracts.Realtime
@inject WebAuthState Auth
@inject WaiterApi Api
@inject WebRealtimeClient Realtime
@inject DraftStore Drafts
@inject FavouritesStore Favourites
@inject IdempotentSender Sender
@inject ShellState Shell
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject IClientHost Host

<PageTitle>Order · HotelPOS</PageTitle>

@if (!Auth.Has(Permissions.OrdersCreate))
{
    <div class="banner error">You do not have the right to take orders.</div>
}
else if (_menu is null)
{
    @if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="LoadAsync" />
    }
    else
    {
        <Skeleton Variant="Skeleton.SkeletonVariant.Card" Count="4" Label="Loading the menu" />
    }
}
else
{
    <OfflineBanner>Offline — your items are kept on this phone until you send them.</OfflineBanner>
    @if (_restoredDraft)
    {
        <div class="banner info">Unsent items from earlier were restored.</div>
    }

    @if (!IsAppend)
    {
        <div class="channel-chips" data-testid="channel-chips" style="display: flex; gap: 8px; margin-bottom: 12px; overflow-x: auto; padding: 4px;">
            <button type="button" class="filter-chip @(_orderType == OrderType.DineIn ? "on" : null)" aria-pressed="@(_orderType == OrderType.DineIn ? "true" : "false")" @onclick="() => SetOrderType(OrderType.DineIn)">
                <Icon Name="users" Size="16" /> Dine-In @(_tableCode is not null ? $"({_tableCode})" : null)
            </button>
            <button type="button" class="filter-chip @(_orderType == OrderType.Takeaway ? "on" : null)" aria-pressed="@(_orderType == OrderType.Takeaway ? "true" : "false")" @onclick="() => SetOrderType(OrderType.Takeaway)">
                <Icon Name="shopping-bag" Size="16" /> Takeaway
            </button>
            <button type="button" class="filter-chip @(_orderType == OrderType.Delivery ? "on" : null)" aria-pressed="@(_orderType == OrderType.Delivery ? "true" : "false")" @onclick="() => SetOrderType(OrderType.Delivery)">
                <Icon Name="truck" Size="16" /> Delivery
            </button>
            @if (_orderType == OrderType.Delivery)
            {
                <button type="button" class="btn small @(IsDeliveryDetailsComplete ? "outline" : "warning")" data-testid="open-delivery-details" @onclick="() => _showDeliverySheet = true">
                    <Icon Name="truck" Size="14" /> @(IsDeliveryDetailsComplete ? $"{_customerName} ({_customerPhone})" : "Add delivery details *")
                </button>
            }
        </div>
    }

    <SearchBox Id="menu-search" @bind-Value="SearchText" Placeholder="Search dishes (name or code)" AriaLabel="Search items" />

    @* While searching, the results span every category, so no chip is shown as selected. *@
    <div class="chip-row">
        @if (Favourites.Items(_menu).Count > 0)
        {
            <button id="chip-favourites" class="chip-btn @(ChipOn(FavouritesStore.CategoryId) ? "on" : null)" aria-pressed="@(ChipOn(FavouritesStore.CategoryId) ? "true" : "false")" @onclick="() => SelectCategory(FavouritesStore.CategoryId)">@FavouritesStore.CategoryName</button>
        }
        @foreach (var category in _menu.Categories.OrderBy(c => c.SortOrder))
        {
            var c = category;
            <button class="chip-btn @(ChipOn(c.Id) ? "on" : null)" aria-pressed="@(ChipOn(c.Id) ? "true" : "false")" @onclick="() => SelectCategory(c.Id)">@c.Name</button>
        }
    </div>

    @* Seat and Parcel apply to the dishes tapped next, like the desktop Order Builder; each cart line can still be changed. *@
    <div class="dish-prefs" data-testid="dish-prefs">
        @if (ShowSeatPicker)
        {
            <div class="seat-picker" role="group" aria-label="Seat for the next dishes" data-testid="seat-picker">
                <span class="seat-picker-label muted small">Seat</span>
                <div class="chip-row seat-chips">
                    <button type="button" class="chip-btn @(_seatsOn.Count == 0 ? "on" : null)" data-testid="seat-whole" aria-pressed="@(_seatsOn.Count == 0 ? "true" : "false")" @onclick="_seatsOn.Clear">Whole table</button>
                    @foreach (var code in _seatCodes)
                    {
                        var seat = code;
                        var owner = SeatOwners.GetValueOrDefault(seat);
                        <button type="button" class="chip-btn @(_seatsOn.Contains(seat) ? "on" : null) @(owner is not null ? "taken" : null)" data-testid="seat-chip" data-seat="@seat"
                                data-taken="@(owner is not null ? "true" : "false")"
                                aria-label="@(owner is null ? $"Seat {seat}, free" : owner == seat ? $"Seat {seat}, already has dishes" : $"Seat {seat}, already has dishes with the group {owner}")"
                                title="@(owner is null ? $"Seat {seat} · free" : owner == seat ? $"Seat {seat} · already has dishes. Tap to add more." : $"Seat {seat} · taken by the group {owner}. Tap to add to that group.")"
                                aria-pressed="@(_seatsOn.Contains(seat) ? "true" : "false")" @onclick="() => ToggleSeat(seat)">@seat@(owner is not null ? " ●" : null)</button>
                    }
                </div>
                <div class="muted small seat-hint">Tap seats to select one or more. Tap a selected seat again to unselect it. ● Has dishes: tap to add more.</div>
            </div>
        }
        <button type="button" class="parcel-toggle @(_parcel ? "on" : null)" data-testid="parcel-toggle" aria-pressed="@(_parcel ? "true" : "false")" @onclick="() => _parcel = !_parcel">
            <span class="switch" aria-hidden="true"><span class="switch-knob"></span></span>
            <span class="parcel-label">Parcel</span>
        </button>
    </div>

    <div class="items">
        @foreach (var item in VisibleItems())
        {
            var i = item;
            <MenuItemCard Item="i" ImageUrl="@Host.ImageUrl(i.ImageUrl)" Pinned="@Favourites.IsPinned(i.Id)" OnPick="() => Pick(i)" OnPickPortion="p => Pick(i, p)" OnTogglePin="() => TogglePinAsync(i)" />
        }
    </div>
    @if (!VisibleItems().Any())
    {
        <EmptyState Small="true" Icon="search" Text="@(IsSearching ? "No dish matches that." : "Nothing in this category.")" />
    }

    <CartBar Cart="_cart" Busy="_sending"
             ReviewLabel="@(IsAppend ? "Review added items" : "Review order")" OnReview="() => _review = true" />
}

@* Review = the confirm-before-send step: every line with its controls, order notes, then one Send button. *@
@if (_review && _menu is not null)
{
    <BottomSheet Open="true" Title="@(IsAppend ? "Added items" : IsEdit ? "Edit draft" : _tableCode is null ? "Review order" : $"Order · {_tableCode}")" OnClose="() => _review = false">
        @if (_cart.IsEmpty)
        {
            <EmptyState Small="true" Text="Nothing in the order yet." />
        }
        else
        {
            <div class="cart-lines review-lines" id="cart-lines">
                @foreach (var line in _cart.Lines)
                {
                    var l = line;
                    <CartLineRow Line="l" ImageUrl="@LineImage(l)" OnIncrease="() => Change(() => _cart.Increase(l))" OnDecrease="() => Change(() => _cart.Decrease(l))"
                                 OnEdit="() => EditLine(l)" OnDelete="() => Change(() => _cart.Remove(l))" OnToggleParcel="() => ToggleParcel(l)" />
                }
            </div>
        }
        <button type="button" class="btn block review-add" @onclick="() => _review = false"><Icon Name="plus" /> Add more items</button>

        @if (!IsAppend)
        {
            <div class="review-row">
                <span>Guests</span>
                <Stepper Value="_cart.Guests" ValueChanged="g => Guests = g" Min="FloorLimits.MinGuests" Max="FloorLimits.MaxGuests" Label="Guests" Unit="guest" />
            </div>
            <label class="field review-notes">
                <span>Order notes <span class="muted">(for the kitchen)</span></span>
                <textarea class="input" data-testid="order-notes" value="@_cart.Notes" @onchange="e => Change(() => _cart.Notes = e.Value?.ToString())"
                          maxlength="@OrderLimits.NotesMaxLength" placeholder="e.g. no onion for the whole order"></textarea>
            </label>
        }

        <div class="review-foot">
            <div class="cart-total-wrap">
                <span class="muted small">Total</span>
                <b class="cart-total num-tab">@_cart.ApproxTotal.ToString("N2")</b>
            </div>
            <div class="row">
                <button type="button" class="btn" data-testid="save-draft" @onclick="SaveDraftAndBackAsync" disabled="@_sending">Save draft</button>
                <button type="button" class="btn primary lg" data-testid="send" @onclick="SendAsync" disabled="@(_sending || _cart.IsEmpty)">
                    <Icon Name="send" /> @(_sending ? "Sending…" : IsAppend ? "Send added items" : "Send to kitchen")
                </button>
            </div>
        </div>
    </BottomSheet>
}

@if (_options is { } options)
{
    <ItemOptionsSheet Item="options.Item" Groups="options.Groups" InitialOptionIds="options.Line?.ModifierOptionIds" InitialPortionId="options.Line?.PortionId ?? options.Portion?.Id" InitialQuantity="options.Line?.Quantity ?? 1"
                      InitialNotes="@options.Line?.Notes" ConfirmLabel="@(options.Line is null ? "Add to order" : "Save changes")"
                      OnConfirm="r => ConfirmOptions(options, r)" OnClose="() => _options = null" />
}

@if (_showDeliverySheet)
{
    <BottomSheet Open="true" Title="Delivery details" OnClose="() => _showDeliverySheet = false">
        <div class="form-fields" style="display: flex; flex-direction: column; gap: 12px;">
            <label class="field">
                <span>Customer Name *</span>
                <input class="input" type="text" data-testid="delivery-name" @bind="_customerName" placeholder="Recipient's full name" required />
            </label>
            <label class="field">
                <span>Phone Number *</span>
                <input class="input" type="tel" data-testid="delivery-phone" @bind="_customerPhone" placeholder="Mobile number" required />
            </label>
            <label class="field">
                <span>Delivery Address *</span>
                <textarea class="input" data-testid="delivery-address" @bind="_deliveryAddress" placeholder="Street, building, flat number" rows="3" required></textarea>
            </label>
            <label class="field">
                <span>Delivery Notes</span>
                <input class="input" type="text" data-testid="delivery-notes" @bind="_deliveryNotes" placeholder="Landmark, gate instructions..." />
            </label>
        </div>
        <div class="sheet-actions" style="margin-top: 16px;">
            <button type="button" class="btn primary block" data-testid="save-delivery-details" @onclick="() => _showDeliverySheet = false">Save details</button>
        </div>
    </BottomSheet>
}

@code {
    [Parameter] public int? TableId { get; set; }
    [Parameter] public int? OrderId { get; set; }
    [SupplyParameterFromQuery] public string? Type { get; set; }

    private OrderType _orderType = OrderType.DineIn;
    private string? _customerName;
    private string? _customerPhone;
    private string? _deliveryAddress;
    private string? _deliveryNotes;
    private bool _showDeliverySheet;

    private bool IsDeliveryDetailsComplete =>
        !string.IsNullOrWhiteSpace(_customerName) &&
        !string.IsNullOrWhiteSpace(_customerPhone) &&
        !string.IsNullOrWhiteSpace(_deliveryAddress);

    private void SetOrderType(OrderType type)
    {
        _orderType = type;
        if (type == OrderType.Delivery && !IsDeliveryDetailsComplete)
        {
            _showDeliverySheet = true;
        }

        // Takeaway and delivery have no seats: nothing may still point at one.
        if (type != OrderType.DineIn)
        {
            _seatsOn.Clear();
            Change(_cart.ClearSeats);
        }

        SetTitle();
    }

    // Seats of the table this order is for (its own plus those of tables merged into it); empty for takeaway/delivery.
    private IReadOnlyList<string> _seatCodes = Array.Empty<string>();
    private readonly HashSet<string> _seatsOn = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<string> _serverSeatGroups = Array.Empty<string>();
    private bool _parcel;

    private bool ShowSeatPicker => _orderType == OrderType.DineIn && _seatCodes.Count > 0;

    // The dishes tapped next are for these seats together ("T01A+B"); nothing tapped means the whole table.
    private string? ActiveSeat => ShowSeatPicker && _seatsOn.Count > 0 ? SeatSelection.Join(_seatCodes.Where(_seatsOn.Contains)) : null;

    // Which seat group already has dishes for each seat: the dishes in the cart and those already on the order.
    private Dictionary<string, string> SeatOwners
    {
        get
        {
            var owner = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var raw in _serverSeatGroups.Concat(_cart.Lines.Select(l => l.SeatCode ?? string.Empty)).Where(g => !string.IsNullOrWhiteSpace(g)))
            {
                var group = SeatSelection.Join(SeatSelection.Parse(raw));
                foreach (var seat in SeatSelection.Parse(group))
                {
                    owner.TryAdd(seat, group);
                }
            }

            return owner;
        }
    }

    // Tapping a seat adds it to the selection (supports multiple seats); tapping an already selected seat toggles it off.
    // If a seat belongs to an existing group, toggling it toggles that whole group.
    private void ToggleSeat(string seat)
    {
        var owners = SeatOwners;
        var group = owners.GetValueOrDefault(seat);
        var seatsToToggle = group is not null
            ? _seatCodes.Where(s => owners.GetValueOrDefault(s) == group).ToList()
            : new List<string> { seat };

        var allOn = seatsToToggle.All(_seatsOn.Contains);
        if (allOn)
        {
            foreach (var s in seatsToToggle)
            {
                _seatsOn.Remove(s);
            }
        }
        else
        {
            foreach (var s in seatsToToggle)
            {
                _seatsOn.Add(s);
            }
        }
    }

    private void ToggleParcel(CartLine line) =>
        Change(() => _cart.SetParcel(line, !line.IsParcel, _menu?.Items.FirstOrDefault(i => i.Id == line.MenuItemId)?.PackagingCharge));

    private string AddedText(MenuEntryDto item, MenuItemPortionDto? portion = null) =>
        $"{(portion is not null && item.Portions.Count > 1 ? ItemDisplayName.Compose(item.Name, portion.Name) : item.Name)} added{(_parcel ? " (parcel)" : null)}{(ActiveSeat is { } seat ? $" for seat {seat}" : null)}.";

    private readonly OrderComposer _cart = new();
    private MenuDto? _menu;
    private string? _error;
    private string? _tableCode;
    private int _categoryId;
    private bool _restoredDraft;
    private bool _sending;
    private bool _review;
    private Guid? _pendingKey;
    private OptionsRequest? _options;
    private IDisposable? _menuSubscription;

    private string SearchText { get; set; } = string.Empty;

    private bool IsEdit => Navigation.Uri.Contains("/edit", StringComparison.OrdinalIgnoreCase);
    private bool IsAppend => OrderId is not null && !IsEdit;
    private string? _orderRowVersion;

    private bool IsSearching => SearchText.Trim().Length > 0;

    private bool ChipOn(int categoryId) => !IsSearching && _categoryId == categoryId;

    // A chip tap ends a search: the waiter asked for that category.
    private void SelectCategory(int categoryId)
    {
        _categoryId = categoryId;
        SearchText = string.Empty;
    }

    // Search-as-you-type spans the whole menu; otherwise the selected chip (a real category or Favourites).
    private IEnumerable<MenuEntryDto> VisibleItems() =>
        IsSearching
            ? FavouritesStore.Search(_menu!, SearchText)
            : _categoryId == FavouritesStore.CategoryId
                ? Favourites.Items(_menu!)
                : _menu!.Items.Where(i => i.CategoryId == _categoryId).OrderBy(i => i.SortOrder);

    private string? LineImage(CartLine line) => Host.ImageUrl(_menu?.Items.FirstOrDefault(i => i.Id == line.MenuItemId)?.ImageUrl);

    private async Task TogglePinAsync(MenuEntryDto item)
    {
        await Favourites.TogglePinAsync(item.Id);
        if (_categoryId == FavouritesStore.CategoryId && Favourites.Items(_menu!).Count == 0)
        {
            _categoryId = _menu!.Categories.OrderBy(c => c.SortOrder).FirstOrDefault()?.Id ?? 0;
        }
    }

    private int Guests
    {
        get => _cart.Guests;
        set { _cart.Guests = value; SetTitle(); _ = PersistAsync(); }
    }

    private int DraftKey => TableId ?? (_orderType == OrderType.Delivery ? -2 : -1);

    private void SetTitle()
    {
        var what = IsEdit ? "Edit draft" : IsAppend ? "Add items" : _orderType == OrderType.Takeaway ? "Takeaway" : _orderType == OrderType.Delivery ? "Delivery" : "New order";
        var title = _tableCode is null ? what : $"{_tableCode} · {what}";
        var backUrl = TableId.HasValue ? $"tables/{TableId.Value}" : "my-orders";
        Shell.Set(title, IsAppend ? null : TextFormat.Count(_cart.Guests, "guest"), backUrl);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Type))
        {
            if (Type.Equals("takeaway", StringComparison.OrdinalIgnoreCase))
            {
                _orderType = OrderType.Takeaway;
            }
            else if (Type.Equals("delivery", StringComparison.OrdinalIgnoreCase))
            {
                _orderType = OrderType.Delivery;
                _showDeliverySheet = true;
            }
        }
        else if (!TableId.HasValue)
        {
            _orderType = OrderType.Takeaway;
        }

        SetTitle();
        await Realtime.StartAsync();
        _menuSubscription = Realtime.Subscribe<MenuChangedEvent>(HubEvents.MenuChanged, changed => { Api.InvalidateMenu(); _ = InvokeAsync(LoadAsync); });

        await Favourites.LoadAsync();
        var draft = await Drafts.LoadAsync(DraftKey);
        if (draft is not null && draft.OrderId == OrderId)
        {
            _cart.LoadDraft(draft);
            _pendingKey = draft.PendingKey;
            _restoredDraft = !_cart.IsEmpty;
            if (IsEdit && OrderId is { } restoredEditId)
            {
                // A held order is saved to the server before it is sent, so the server re-checks every portion and price. That
                // needs the order's current row version even when the lines come from the draft kept on this phone.
                var current = await Api.GetOrderAsync(restoredEditId);
                if (current.Success && current.Data is { } serverOrder)
                {
                    _orderRowVersion = serverOrder.RowVersion;
                }
            }
        }
        else if (IsEdit && OrderId is { } editId)
        {
            var orderResult = await Api.GetOrderAsync(editId);
            if (orderResult.Success && orderResult.Data is { } order)
            {
                _orderRowVersion = order.RowVersion;
                _orderType = order.OrderType;
                _customerName = order.CustomerName;
                _customerPhone = order.CustomerPhone;
                _deliveryAddress = order.DeliveryAddress;
                _deliveryNotes = order.DeliveryNotes;
                _cart.LoadOrder(order);
                if (order.TableCode is not null)
                {
                    _tableCode = order.TableCode;
                }
            }
        }

        if (TableId.HasValue)
        {
            var table = await Api.GetTableAsync(TableId.Value);
            if (table.Success && table.Data is { } detail)
            {
                _tableCode = detail.Table.Code;
                if (!IsAppend && draft is null && detail.Table.GuestCount is { } guests)
                {
                    _cart.Guests = guests;
                }

                _seatCodes = await LoadSeatCodesAsync(detail.Table);
            }

            // Dishes already on the order own their seats too.
            if (IsAppend && OrderId is { } existingId)
            {
                var existing = await Api.GetOrderAsync(existingId);
                if (existing.Success && existing.Data is { } existingOrder)
                {
                    _serverSeatGroups = existingOrder.SeatGroups.Select(g => g.SeatCode).ToList();
                }
            }
        }

        SetTitle();
        await LoadAsync();
    }

    // The table's own seats, then the seats of every table merged into it (one order may use the seats of both). The table
    // map is only read when something is merged here; a failed read leaves the table's own seats.
    private async Task<IReadOnlyList<string>> LoadSeatCodesAsync(TableDto table)
    {
        var seats = table.SeatCodes.ToList();
        if (table.MergedTableCodes.Count > 0)
        {
            var map = await Api.GetTableMapAsync();
            if (map.Success && map.Data is { } data)
            {
                foreach (var companion in data.Sections.SelectMany(s => s.Tables).Where(t => t.MergedIntoTableId == table.Id).OrderBy(t => t.Code, StringComparer.OrdinalIgnoreCase))
                {
                    seats.AddRange(companion.SeatCodes.Where(code => !seats.Contains(code)));
                }
            }
        }

        return seats;
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetMenuAsync();
        if (result.Success && result.Data is { } menu)
        {
            _menu = menu;
            // A loaded draft or order is tied to today's portions (by id, then by name); one that is gone must be chosen again.
            _cart.ResolvePortions(menu);
            _error = null;
            var hasFavourites = Favourites.Items(menu).Count > 0;
            var known = menu.Categories.Any(c => c.Id == _categoryId) || (_categoryId == FavouritesStore.CategoryId && hasFavourites);
            if (_categoryId == 0 || !known)
            {
                _categoryId = hasFavourites
                    ? FavouritesStore.CategoryId
                    : menu.Categories.OrderBy(c => c.SortOrder).FirstOrDefault()?.Id ?? 0;
            }
        }
        else
        {
            _error = result.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    // portion: the one selected on the card of an item with several portions; null adds the item's default portion.
    private void Pick(MenuEntryDto item, MenuItemPortionDto? portion = null)
    {
        var groups = GroupsFor(item);
        if (groups.Count == 0)
        {
            Change(() => _cart.Add(item, Array.Empty<MenuModifierOptionDto>(), 1, null, _parcel, ActiveSeat, portion));
            Toasts.Success(AddedText(item, portion));
            return;
        }

        _options = new OptionsRequest(item, groups, null, portion);
    }

    private List<MenuModifierGroupDto> GroupsFor(MenuEntryDto item) =>
        _menu!.ModifierGroups.Where(g => item.ModifierGroupIds.Contains(g.Id)).ToList();

    // Editing a line reopens the same sheet with its options, quantity and note filled in. An item the menu no longer
    // lists keeps its options and only quantity and note can change.
    private void EditLine(CartLine line)
    {
        var item = _menu!.Items.FirstOrDefault(i => i.Id == line.MenuItemId)
                   ?? new MenuEntryDto { Id = line.MenuItemId, Name = line.Name, Price = line.UnitPrice, IsAvailable = true };
        _options = new OptionsRequest(item, GroupsFor(item), line);
    }

    private void ConfirmOptions(OptionsRequest request, ItemOptionsResult result)
    {
        _options = null;
        if (request.Line is not { } line)
        {
            var portion = result.Portion ?? request.Portion;
            Change(() => _cart.Add(request.Item, result.Options, result.Quantity, result.Notes, _parcel, ActiveSeat, portion));
            Toasts.Success(AddedText(request.Item, portion));
            return;
        }

        var sameOptions = request.Groups.Count == 0 || result.Options.Select(o => o.Id).OrderBy(i => i).SequenceEqual(line.ModifierOptionIds.OrderBy(i => i));
        // A different portion is a different dish and price: it replaces the line, like different options do.
        var samePortion = result.Portion is null || (result.Portion.Id == line.PortionId && !line.NeedsPortionChoice);
        Change(() =>
        {
            if (sameOptions)
            {
                _cart.SetQuantity(line, result.Quantity);
                _cart.SetNotes(line, result.Notes);
                if (!samePortion && result.Portion is { } chosen)
                {
                    // Only the portion changed: the line keeps its place, notes and flags and takes the new portion and price.
                    _cart.ChoosePortion(line, request.Item, chosen);
                }
            }
            else
            {
                _cart.Remove(line);
                _cart.Add(request.Item, result.Options, result.Quantity, result.Notes, line.IsParcel, line.SeatCode, result.Portion);
            }
        });
    }

    private void Change(Action action)
    {
        action();
        _ = PersistAsync();
    }

    private ValueTask PersistAsync() => _cart.IsEmpty && _pendingKey is null
        ? Drafts.RemoveAsync(DraftKey)
        : Drafts.SaveAsync(_cart.ToDraft(DraftKey, OrderId, _pendingKey));

    // A line whose portion is no longer on the menu is never saved or sent with a guessed portion: say which dish and portion.
    private string? UnresolvedPortionMessage() =>
        _cart.HasUnresolvedPortions
            ? $"Choose the portion again for {string.Join(", ", _cart.Lines.Where(l => l.NeedsPortionChoice).Select(l => l.DisplayName).Distinct())} before sending."
            : null;

    private async Task SaveDraftAndBackAsync()
    {
        if (UnresolvedPortionMessage() is { } portionMessage)
        {
            Toasts.Error(portionMessage.Replace("before sending", "before saving"));
            _review = false;
            return;
        }

        if (IsEdit && OrderId is { } editId && !string.IsNullOrEmpty(_orderRowVersion))
        {
            _sending = true;
            try
            {
                var replaceResult = await Api.ReplaceItemsAsync(editId, new ReplaceOrderItemsRequest
                {
                    Items = _cart.ToInputs(),
                    RowVersion = _orderRowVersion,
                });
                if (replaceResult.Success)
                {
                    await Drafts.RemoveAsync(DraftKey);
                    Toasts.Success("Draft saved.");
                    Navigation.NavigateTo(TableId.HasValue && _orderType == OrderType.DineIn ? $"tables/{TableId.Value}" : "my-orders");
                    return;
                }
                else
                {
                    Toasts.Error(replaceResult.Message);
                    return;
                }
            }
            finally
            {
                _sending = false;
            }
        }

        // Phase 22 O2: a held order is a server-side Draft (listed under My orders → Held on every phone and on the
        // desktop); only an empty cart, an append, or a failed call keeps the draft on this phone alone.
        if (!IsAppend && !_cart.IsEmpty && (_orderType != OrderType.Delivery || IsDeliveryDetailsComplete))
        {
            _sending = true;
            try
            {
                _pendingKey ??= IdempotentSender.NewKey();
                await PersistAsync();
                var key = _pendingKey.Value;
                var held = await Sender.SendAsync(key, (k, ct) => Api.CreateOrderAsync(new CreateOrderRequest
                {
                    OrderType = _orderType,
                    TableId = _orderType == OrderType.DineIn ? TableId : null,
                    CustomerName = _orderType == OrderType.Delivery ? _customerName : null,
                    CustomerPhone = _orderType == OrderType.Delivery ? _customerPhone : null,
                    DeliveryAddress = _orderType == OrderType.Delivery ? _deliveryAddress : null,
                    DeliveryNotes = _orderType == OrderType.Delivery ? _deliveryNotes : null,
                    GuestCount = _cart.Guests,
                    Notes = _cart.Notes,
                    Items = _cart.ToInputs(),
                    Submit = false,
                }, k, ct));
                if (held.Success && held.Data is { } draft)
                {
                    _pendingKey = null;
                    _cart.Clear();
                    await Drafts.RemoveAsync(DraftKey);
                    Toasts.Success($"Order #{draft.OrderNumber} held. Find it under My orders → Held.");
                    Navigation.NavigateTo("my-orders");
                    return;
                }

                Toasts.Info(held.IsTransient ? "Offline: draft kept on this phone until the connection is back." : held.Message);
            }
            finally
            {
                _sending = false;
            }
        }

        await PersistAsync();
        Toasts.Info(_cart.IsEmpty ? "Nothing to keep." : "Draft kept on this phone.");
        Navigation.NavigateTo(TableId.HasValue && _orderType == OrderType.DineIn ? $"tables/{TableId.Value}" : "my-orders");
    }

    private async Task SendAsync()
    {
        if (UnresolvedPortionMessage() is { } portionMessage)
        {
            Toasts.Error(portionMessage);
            _review = false;
            return;
        }

        if (_orderType == OrderType.Delivery && !IsDeliveryDetailsComplete)
        {
            Toasts.Error("Customer name, phone, and delivery address are required.");
            _showDeliverySheet = true;
            return;
        }

        _sending = true;
        try
        {
            // One key per logical send; a retry after a reload finds it in the draft and reuses it.
            _pendingKey ??= IdempotentSender.NewKey();
            await PersistAsync();
            var key = _pendingKey.Value;

            if (IsEdit && OrderId is { } editId)
            {
                if (!string.IsNullOrEmpty(_orderRowVersion))
                {
                    var replaceResult = await Api.ReplaceItemsAsync(editId, new ReplaceOrderItemsRequest
                    {
                        Items = _cart.ToInputs(),
                        RowVersion = _orderRowVersion,
                    });
                    if (!replaceResult.Success)
                    {
                        Toasts.Error(replaceResult.Message);
                        return;
                    }
                    _orderRowVersion = replaceResult.Data?.RowVersion ?? _orderRowVersion;
                }

                var submitResult = await Api.SubmitOrderAsync(editId);
                if (submitResult.Success && submitResult.Data is { } submitted)
                {
                    _pendingKey = null;
                    await Favourites.RecordOrderedAsync(_cart.Lines.Select(l => l.MenuItemId));
                    _cart.Clear();
                    _review = false;
                    await Drafts.RemoveAsync(DraftKey);
                    Toasts.Success($"Order #{submitted.OrderNumber} sent to the kitchen.");
                    Navigation.NavigateTo(TableId.HasValue && _orderType == OrderType.DineIn ? $"tables/{TableId.Value}" : "my-orders");
                    return;
                }
                else
                {
                    Toasts.Error(submitResult.Message);
                    return;
                }
            }

            var result = IsAppend
                ? await Sender.SendAsync(key, (k, ct) => Api.AppendItemsAsync(OrderId!.Value, new AppendOrderItemsRequest { Items = _cart.ToInputs() }, k, ct))
                : await Sender.SendAsync(key, (k, ct) => Api.CreateOrderAsync(new CreateOrderRequest
                {
                    OrderType = _orderType,
                    TableId = _orderType == OrderType.DineIn ? TableId : null,
                    CustomerName = _orderType == OrderType.Delivery ? _customerName : null,
                    CustomerPhone = _orderType == OrderType.Delivery ? _customerPhone : null,
                    DeliveryAddress = _orderType == OrderType.Delivery ? _deliveryAddress : null,
                    DeliveryNotes = _orderType == OrderType.Delivery ? _deliveryNotes : null,
                    GuestCount = _cart.Guests,
                    Notes = _cart.Notes,
                    Items = _cart.ToInputs(),
                    Submit = true,
                }, k, ct));

            if (result.Success && result.Data is { } order)
            {
                // Only now: the server confirmed the order exists exactly once.
                _pendingKey = null;
                await Favourites.RecordOrderedAsync(_cart.Lines.Select(l => l.MenuItemId));
                _cart.Clear();
                _review = false;
                await Drafts.RemoveAsync(DraftKey);
                Toasts.Success(IsAppend ? $"Added items sent for order #{order.OrderNumber}." : $"Order #{order.OrderNumber} sent to the kitchen.");
                Navigation.NavigateTo(TableId.HasValue && _orderType == OrderType.DineIn ? $"tables/{TableId.Value}" : "my-orders");
                return;
            }

            if (result.IsConflict)
            {
                // Another device changed the table/order. Keep the cart and the pending key (the draft is
                // already persisted), re-read the server state and let the waiter send again.
                Toasts.Error(WaiterApi.ConflictMessage);
                if (IsAppend)
                {
                    await Api.GetOrderAsync(OrderId!.Value);
                }

                if (TableId.HasValue)
                {
                    await Api.GetTableAsync(TableId.Value);
                }
                await LoadAsync();
            }
            else if (result.IsTransient)
            {
                Toasts.Error("Not confirmed by the server. Your items are kept; try again when the connection is back.");
            }
            else
            {
                // A definite refusal: the key is spent, the next attempt is a new operation.
                _pendingKey = null;
                await PersistAsync();
                Toasts.Error(result.Message);
            }
        }
        finally
        {
            _sending = false;
        }
    }

    public void Dispose() => _menuSubscription?.Dispose();

    /// <summary>What the options sheet is open for: a new pick (Line null) or an existing cart line being edited.</summary>
    private sealed record OptionsRequest(MenuEntryDto Item, IReadOnlyList<MenuModifierGroupDto> Groups, CartLine? Line, MenuItemPortionDto? Portion = null);
}
