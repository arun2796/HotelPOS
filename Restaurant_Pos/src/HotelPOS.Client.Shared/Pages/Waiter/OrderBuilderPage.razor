@page "/tables/{TableId:int}/order"
@page "/tables/{TableId:int}/order/{OrderId:int}/add"
@attribute [Authorize]
@implements IDisposable
@using HotelPOS.Contracts.Floor
@using HotelPOS.Contracts.Menu
@using HotelPOS.Contracts.Orders
@using HotelPOS.Contracts.Realtime
@inject WebAuthState Auth
@inject WaiterApi Api
@inject WebRealtimeClient Realtime
@inject DraftStore Drafts
@inject FavouritesStore Favourites
@inject IdempotentSender Sender
@inject ShellState Shell
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject IClientHost Host

<PageTitle>Order · HotelPOS</PageTitle>

@if (!Auth.Has(Permissions.OrdersCreate))
{
    <div class="banner error">You do not have the right to take orders.</div>
}
else if (_menu is null)
{
    @if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="LoadAsync" />
    }
    else
    {
        <Skeleton Variant="Skeleton.SkeletonVariant.Card" Count="4" Label="Loading the menu" />
    }
}
else
{
    <OfflineBanner>Offline — your items are kept on this phone until you send them.</OfflineBanner>
    @if (_restoredDraft)
    {
        <div class="banner info">Unsent items from earlier were restored.</div>
    }

    <SearchBox Id="menu-search" @bind-Value="SearchText" Placeholder="Search dishes (name or code)" AriaLabel="Search items" />

    @* While searching, the results span every category, so no chip is shown as selected. *@
    <div class="chip-row">
        @if (Favourites.Items(_menu).Count > 0)
        {
            <button id="chip-favourites" class="chip-btn @(ChipOn(FavouritesStore.CategoryId) ? "on" : null)" @onclick="() => SelectCategory(FavouritesStore.CategoryId)">@FavouritesStore.CategoryName</button>
        }
        @foreach (var category in _menu.Categories.OrderBy(c => c.SortOrder))
        {
            var c = category;
            <button class="chip-btn @(ChipOn(c.Id) ? "on" : null)" @onclick="() => SelectCategory(c.Id)">@c.Name</button>
        }
    </div>

    <div class="items">
        @foreach (var item in VisibleItems())
        {
            var i = item;
            <MenuItemCard Item="i" ImageUrl="@Host.ImageUrl(i.ImageUrl)" Pinned="@Favourites.IsPinned(i.Id)" OnPick="() => Pick(i)" OnTogglePin="() => TogglePinAsync(i)" />
        }
    </div>
    @if (!VisibleItems().Any())
    {
        <EmptyState Small="true" Icon="search" Text="@(IsSearching ? "No dish matches that." : "Nothing in this category.")" />
    }

    <CartBar Cart="_cart" ImageUrl="LineImage" ShowGuests="@(!IsAppend)" GuestsChanged="g => Guests = g" Busy="_sending"
             ReviewLabel="@(IsAppend ? "Review added items" : "Review order")" OnReview="() => _review = true" />
}

@* Review = the confirm-before-send step: every line with its controls, order notes, then one Send button. *@
@if (_review && _menu is not null)
{
    <BottomSheet Open="true" Title="@(IsAppend ? "Added items" : $"Order · {_tableCode ?? $"table {TableId}"}")" OnClose="() => _review = false">
        @if (_cart.IsEmpty)
        {
            <EmptyState Small="true" Text="Nothing in the order yet." />
        }
        else
        {
            <div class="cart-lines review-lines" id="cart-lines">
                @foreach (var line in _cart.Lines)
                {
                    var l = line;
                    <CartLineRow Line="l" ImageUrl="@LineImage(l)" OnIncrease="() => Change(() => _cart.Increase(l))" OnDecrease="() => Change(() => _cart.Decrease(l))"
                                 OnEdit="() => EditLine(l)" OnDelete="() => Change(() => _cart.Remove(l))" />
                }
            </div>
        }
        <button type="button" class="btn block review-add" @onclick="() => _review = false"><Icon Name="plus" /> Add more items</button>

        @if (!IsAppend)
        {
            <div class="review-row">
                <span>Guests</span>
                <Stepper Value="_cart.Guests" ValueChanged="g => Guests = g" Min="FloorLimits.MinGuests" Max="FloorLimits.MaxGuests" Label="Guests" Unit="guest" />
            </div>
            <label class="field review-notes">
                <span>Order notes <span class="muted">(for the kitchen)</span></span>
                <textarea class="input" data-testid="order-notes" value="@_cart.Notes" @onchange="e => Change(() => _cart.Notes = e.Value?.ToString())"
                          maxlength="@OrderLimits.NotesMaxLength" placeholder="e.g. no onion for the whole order"></textarea>
            </label>
        }

        <div class="review-foot">
            <div class="cart-total-wrap">
                <span class="muted small">approx. total</span>
                <b class="cart-total num-tab">@_cart.ApproxTotal.ToString("N2")</b>
            </div>
            <div class="row">
                <button type="button" class="btn" data-testid="save-draft" @onclick="SaveDraftAndBackAsync" disabled="@_sending">Save draft</button>
                <button type="button" class="btn primary lg" data-testid="send" @onclick="SendAsync" disabled="@(_sending || _cart.IsEmpty)">
                    <Icon Name="send" /> @(_sending ? "Sending…" : IsAppend ? "Send added items" : "Send to kitchen")
                </button>
            </div>
        </div>
    </BottomSheet>
}

@if (_options is { } options)
{
    <ItemOptionsSheet Item="options.Item" Groups="options.Groups" InitialOptionIds="options.Line?.ModifierOptionIds" InitialQuantity="options.Line?.Quantity ?? 1"
                      InitialNotes="@options.Line?.Notes" ConfirmLabel="@(options.Line is null ? "Add to order" : "Save changes")"
                      OnConfirm="r => ConfirmOptions(options, r)" OnClose="() => _options = null" />
}

@code {
    [Parameter] public int TableId { get; set; }
    [Parameter] public int? OrderId { get; set; }

    private readonly OrderComposer _cart = new();
    private MenuDto? _menu;
    private string? _error;
    private string? _tableCode;
    private int _categoryId;
    private bool _restoredDraft;
    private bool _sending;
    private bool _review;
    private Guid? _pendingKey;
    private OptionsRequest? _options;
    private IDisposable? _menuSubscription;

    private string SearchText { get; set; } = string.Empty;

    private bool IsAppend => OrderId is not null;

    private bool IsSearching => SearchText.Trim().Length > 0;

    private bool ChipOn(int categoryId) => !IsSearching && _categoryId == categoryId;

    // A chip tap ends a search: the waiter asked for that category.
    private void SelectCategory(int categoryId)
    {
        _categoryId = categoryId;
        SearchText = string.Empty;
    }

    // Search-as-you-type spans the whole menu; otherwise the selected chip (a real category or Favourites).
    private IEnumerable<MenuEntryDto> VisibleItems() =>
        IsSearching
            ? FavouritesStore.Search(_menu!, SearchText)
            : _categoryId == FavouritesStore.CategoryId
                ? Favourites.Items(_menu!)
                : _menu!.Items.Where(i => i.CategoryId == _categoryId).OrderBy(i => i.SortOrder);

    private string? LineImage(CartLine line) => Host.ImageUrl(_menu?.Items.FirstOrDefault(i => i.Id == line.MenuItemId)?.ImageUrl);

    private async Task TogglePinAsync(MenuEntryDto item)
    {
        await Favourites.TogglePinAsync(item.Id);
        if (_categoryId == FavouritesStore.CategoryId && Favourites.Items(_menu!).Count == 0)
        {
            _categoryId = _menu!.Categories.OrderBy(c => c.SortOrder).FirstOrDefault()?.Id ?? 0;
        }
    }

    private int Guests
    {
        get => _cart.Guests;
        set { _cart.Guests = value; SetTitle(); _ = PersistAsync(); }
    }

    private void SetTitle()
    {
        var what = IsAppend ? "Add items" : "New order";
        var title = _tableCode is null ? what : $"{_tableCode} · {what}";
        Shell.Set(title, IsAppend ? null : TextFormat.Count(_cart.Guests, "guest"), $"tables/{TableId}");
    }

    protected override async Task OnInitializedAsync()
    {
        SetTitle();
        await Realtime.StartAsync();
        _menuSubscription = Realtime.Subscribe<MenuChangedEvent>(HubEvents.MenuChanged, changed => { Api.InvalidateMenu(); _ = InvokeAsync(LoadAsync); });

        await Favourites.LoadAsync();
        var draft = await Drafts.LoadAsync(TableId);
        if (draft is not null && draft.OrderId == OrderId)
        {
            _cart.LoadDraft(draft);
            _pendingKey = draft.PendingKey;
            _restoredDraft = !_cart.IsEmpty;
        }

        var table = await Api.GetTableAsync(TableId);
        if (table.Success && table.Data is { } detail)
        {
            _tableCode = detail.Table.Code;
            if (!IsAppend && draft is null && detail.Table.GuestCount is { } guests)
            {
                _cart.Guests = guests;
            }
        }

        SetTitle();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetMenuAsync();
        if (result.Success && result.Data is { } menu)
        {
            _menu = menu;
            _error = null;
            var hasFavourites = Favourites.Items(menu).Count > 0;
            var known = menu.Categories.Any(c => c.Id == _categoryId) || (_categoryId == FavouritesStore.CategoryId && hasFavourites);
            if (_categoryId == 0 || !known)
            {
                _categoryId = hasFavourites
                    ? FavouritesStore.CategoryId
                    : menu.Categories.OrderBy(c => c.SortOrder).FirstOrDefault()?.Id ?? 0;
            }
        }
        else
        {
            _error = result.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void Pick(MenuEntryDto item)
    {
        var groups = GroupsFor(item);
        if (groups.Count == 0)
        {
            Change(() => _cart.Add(item, Array.Empty<MenuModifierOptionDto>(), 1, null));
            Toasts.Success($"{item.Name} added.");
            return;
        }

        _options = new OptionsRequest(item, groups, null);
    }

    private List<MenuModifierGroupDto> GroupsFor(MenuEntryDto item) =>
        _menu!.ModifierGroups.Where(g => item.ModifierGroupIds.Contains(g.Id)).ToList();

    // Editing a line reopens the same sheet with its options, quantity and note filled in. An item the menu no longer
    // lists keeps its options and only quantity and note can change.
    private void EditLine(CartLine line)
    {
        var item = _menu!.Items.FirstOrDefault(i => i.Id == line.MenuItemId)
                   ?? new MenuEntryDto { Id = line.MenuItemId, Name = line.Name, Price = line.UnitPrice, IsAvailable = true };
        _options = new OptionsRequest(item, GroupsFor(item), line);
    }

    private void ConfirmOptions(OptionsRequest request, ItemOptionsResult result)
    {
        _options = null;
        if (request.Line is not { } line)
        {
            Change(() => _cart.Add(request.Item, result.Options, result.Quantity, result.Notes));
            Toasts.Success($"{request.Item.Name} added.");
            return;
        }

        var sameOptions = request.Groups.Count == 0 || result.Options.Select(o => o.Id).OrderBy(i => i).SequenceEqual(line.ModifierOptionIds.OrderBy(i => i));
        Change(() =>
        {
            if (sameOptions)
            {
                _cart.SetQuantity(line, result.Quantity);
                _cart.SetNotes(line, result.Notes);
            }
            else
            {
                _cart.Remove(line);
                _cart.Add(request.Item, result.Options, result.Quantity, result.Notes);
            }
        });
    }

    private void Change(Action action)
    {
        action();
        _ = PersistAsync();
    }

    private ValueTask PersistAsync() => _cart.IsEmpty && _pendingKey is null
        ? Drafts.RemoveAsync(TableId)
        : Drafts.SaveAsync(_cart.ToDraft(TableId, OrderId, _pendingKey));

    private async Task SaveDraftAndBackAsync()
    {
        await PersistAsync();
        Toasts.Info(_cart.IsEmpty ? "Nothing to keep." : "Draft kept on this phone.");
        Navigation.NavigateTo($"tables/{TableId}");
    }

    private async Task SendAsync()
    {
        _sending = true;
        try
        {
            // One key per logical send; a retry after a reload finds it in the draft and reuses it.
            _pendingKey ??= IdempotentSender.NewKey();
            await PersistAsync();
            var key = _pendingKey.Value;

            var result = IsAppend
                ? await Sender.SendAsync(key, (k, ct) => Api.AppendItemsAsync(OrderId!.Value, new AppendOrderItemsRequest { Items = _cart.ToInputs() }, k, ct))
                : await Sender.SendAsync(key, (k, ct) => Api.CreateOrderAsync(new CreateOrderRequest
                {
                    TableId = TableId,
                    GuestCount = _cart.Guests,
                    Notes = _cart.Notes,
                    Items = _cart.ToInputs(),
                    Submit = true,
                }, k, ct));

            if (result.Success && result.Data is { } order)
            {
                // Only now: the server confirmed the order exists exactly once.
                _pendingKey = null;
                await Favourites.RecordOrderedAsync(_cart.Lines.Select(l => l.MenuItemId));
                _cart.Clear();
                _review = false;
                await Drafts.RemoveAsync(TableId);
                Toasts.Success(IsAppend ? $"Added items sent for order #{order.OrderNumber}." : $"Order #{order.OrderNumber} sent to the kitchen.");
                Navigation.NavigateTo($"tables/{TableId}");
                return;
            }

            if (result.IsConflict)
            {
                // Another device changed the table/order. Keep the cart and the pending key (the draft is
                // already persisted), re-read the server state and let the waiter send again.
                Toasts.Error(WaiterApi.ConflictMessage);
                if (IsAppend)
                {
                    await Api.GetOrderAsync(OrderId!.Value);
                }

                await Api.GetTableAsync(TableId);
                await LoadAsync();
            }
            else if (result.IsTransient)
            {
                Toasts.Error("Not confirmed by the server. Your items are kept; try again when the connection is back.");
            }
            else
            {
                // A definite refusal: the key is spent, the next attempt is a new operation.
                _pendingKey = null;
                await PersistAsync();
                Toasts.Error(result.Message);
            }
        }
        finally
        {
            _sending = false;
        }
    }

    public void Dispose() => _menuSubscription?.Dispose();

    /// <summary>What the options sheet is open for: a new pick (Line null) or an existing cart line being edited.</summary>
    private sealed record OptionsRequest(MenuEntryDto Item, IReadOnlyList<MenuModifierGroupDto> Groups, CartLine? Line);
}
