@page "/kitchen"
@attribute [Authorize]
@implements IDisposable
@using HotelPOS.Contracts.Kitchen
@using HotelPOS.Contracts.Menu
@using HotelPOS.Contracts.Realtime
@inject WebAuthState Auth
@inject KitchenApi Api
@inject WebRealtimeClient Realtime
@inject ShellState Shell
@inject ToastService Toasts

<PageTitle>Kitchen · HotelPOS</PageTitle>

@if (!Auth.Has(Permissions.KitchenOperate))
{
    <div class="banner error">You do not have access to the kitchen display.</div>
}
else
{
    <KitchenHeader Stations="_stations" StationId="_stationId" AllCount="_stationId is null ? _tickets?.Count(t => KitchenRules.ColumnOf(t.Status) is not null) : null"
                   OnStation="SetStationAsync" @bind-Search="_search" OnRefresh="RefreshAsync" />

    @if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="RefreshAsync" />
    }
    else if (_tickets is null)
    {
        <Skeleton Variant="Skeleton.SkeletonVariant.Card" Count="3" Label="Loading tickets" />
    }
    else
    {
        <div class="kds-kpis" id="kds-kpis">
            <KpiTile Compact="true" Label="New" Value="@CountIn(TicketColumn.New).ToString()" Icon="bell" Tone="StatusTone.Info" />
            <KpiTile Compact="true" Label="Preparing" Value="@CountIn(TicketColumn.Preparing).ToString()" Icon="flame" Tone="StatusTone.Warning" />
            <KpiTile Compact="true" Label="Ready" Value="@CountIn(TicketColumn.Ready).ToString()" Icon="check" Tone="StatusTone.Success" />
            <KpiTile Compact="true" Label="Delayed" Value="@DelayedCount.ToString()" Icon="alert" Tone="@(DelayedCount > 0 ? StatusTone.Danger : StatusTone.Neutral)" />
            <KpiTile Compact="true" Label="Completed today" Value="@(_completedToday?.ToString() ?? "—")" Icon="utensils" Tone="StatusTone.Neutral" />
        </div>
        <div class="kds-toolbar" id="kds-summary">
            <span id="kds-delayed-filter"><FilterChip Label="Delayed" Count="DelayedCount" Selected="_delayedOnly" OnClick="() => _delayedOnly = !_delayedOnly" /></span>
            <span id="kds-sort"><FilterChip Label="Oldest first" Selected="_oldestFirst" OnClick="() => _oldestFirst = !_oldestFirst" /></span>
            <span class="muted small grow kds-updated">Updated @_updatedAt.ToLocalTime().ToString("HH:mm:ss")</span>
        </div>
        <div class="kds">
            @foreach (var column in new[] { TicketColumn.New, TicketColumn.Preparing, TicketColumn.Ready })
            {
                var tickets = Visible(column);
                <section class="kds-col" data-column="@column">
                    <header class="kds-colhead">
                        <h2 class="kds-head">@column.ToString().ToUpperInvariant() · @tickets.Count</h2>
                        <div class="kds-sub muted small">
                            @Subtitle(column)
                            @if (tickets.Count > 0)
                            {
                                <span class="kds-timer num-tab" data-testid="column-timer"> · oldest @ColumnTimer(column, tickets)</span>
                            }
                        </div>
                    </header>
                    @if (tickets.Count == 0)
                    {
                        <div class="empty small">—</div>
                    }
                    @foreach (var ticket in tickets)
                    {
                        <TicketCard @key="ticket.Id" Ticket="ticket" Now="Now" Warn="_warn" Late="_late" ShowStation="_stationId is null" ShowPictures="_showPictures"
                                    Busy="_busyTicket == ticket.Id" Selected="_selectedId == ticket.Id" OnOpen="t => _selectedId = t.Id" OnAct="ActAsync" />
                    }
                </section>
            }
        </div>
        @if (SelectedTicket is { } selected)
        {
            <TicketDetailPane Ticket="selected" Now="Now" Late="IsLate(selected)" OnClose="() => _selectedId = null" />
        }
    }
}

@code {
    [Inject] private NotificationRouter Notifier { get; set; } = default!;

    private readonly HashSet<int> _lateSeen = new();
    private bool _lateBaselined;
    private List<KitchenTicketDto>? _tickets;
    private IReadOnlyList<StationDto> _stations = new List<StationDto>();
    private int? _stationId;
    private bool _showPictures;
    private int _warn = KitchenRules.DefaultWarnMinutes;
    private int _late = KitchenRules.DefaultLateMinutes;
    private string? _error;
    private int? _busyTicket;
    private TimeSpan _clockOffset;
    private readonly List<IDisposable> _subscriptions = new();
    private CancellationTokenSource? _debounce;
    private System.Threading.Timer? _clock;
    private string? _search;
    private bool _delayedOnly;
    private bool _oldestFirst = true;
    private int? _selectedId;
    private DateTime _updatedAt = DateTime.UtcNow;

    private DateTime Now => DateTime.UtcNow + _clockOffset;

    private int? _completedToday;

    private bool IsLate(KitchenTicketDto t) => KitchenRules.Timing(t.CreatedAtUtc, Now, _warn, _late) == TicketTiming.Late;

    private int DelayedCount => _tickets?.Count(t => KitchenRules.ColumnOf(t.Status) is not null && IsLate(t)) ?? 0;

    private int CountIn(TicketColumn column) => _tickets?.Count(t => KitchenRules.ColumnOf(t.Status) == column) ?? 0;

    private KitchenTicketDto? SelectedTicket => _selectedId is { } id ? _tickets?.FirstOrDefault(t => t.Id == id) : null;

    // The Delayed toggle and the search narrow the three columns only; the KPI strip always counts the whole station view.
    private List<KitchenTicketDto> Visible(TicketColumn column)
    {
        var query = _tickets!.Where(t => KitchenRules.ColumnOf(t.Status) == column && KitchenRules.Matches(t, _search) && (!_delayedOnly || IsLate(t)));
        return (_oldestFirst ? query.OrderBy(t => t.CreatedAtUtc) : query.OrderByDescending(t => t.CreatedAtUtc)).ToList();
    }

    private static string Subtitle(TicketColumn column) => column switch
    {
        TicketColumn.New => "Waiting to be accepted or started",
        TicketColumn.Preparing => "On the stove",
        _ => "Waiting to be served",
    };

    // Oldest ticket in the column; a Ready ticket is timed from when it became ready, the others from when they were created.
    private string ColumnTimer(TicketColumn column, List<KitchenTicketDto> tickets)
    {
        var oldest = tickets.Min(t => column == TicketColumn.Ready ? t.ReadyAtUtc ?? t.CreatedAtUtc : t.CreatedAtUtc);
        return KitchenRules.ElapsedText(oldest, Now);
    }

    protected override async Task OnInitializedAsync()
    {
        Shell.Set("Kitchen Display", "New, preparing and ready tickets");
        await Realtime.StartAsync();
        _subscriptions.Add(Realtime.Subscribe<KitchenTicketCreatedEvent>(HubEvents.KitchenTicketCreated, _ => ScheduleRefresh()));
        _subscriptions.Add(Realtime.Subscribe<KitchenTicketUpdatedEvent>(HubEvents.KitchenTicketUpdated, _ => ScheduleRefresh()));
        _subscriptions.Add(Realtime.Subscribe<MenuChangedEvent>(HubEvents.MenuChanged, _ => ScheduleRefresh()));
        Realtime.Reconnected += RefreshAsync;

        _stationId = await Api.GetStationPreferenceAsync();
        _showPictures = await Api.GetShowPicturesAsync();
        await Realtime.JoinStationAsync(_stationId);

        var stations = await Api.GetStationsAsync();
        if (stations.Success && stations.Data is { } list)
        {
            _stations = list.Where(s => s.IsActive).OrderBy(s => s.SortOrder).ToList();
        }

        var settings = await Api.GetPublicSettingsAsync();
        (_warn, _late) = KitchenRules.ReadTiming(settings.Data);

        // Re-colour the tickets every 30 s even when nothing changes on the server.
        _clock = new System.Threading.Timer(_ => _ = InvokeAsync(() => { AnnounceNewlyLate(); StateHasChanged(); }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        await RefreshAsync();
    }

    private async Task SetStationAsync(int? stationId)
    {
        _stationId = stationId;
        await Api.SetStationPreferenceAsync(stationId);
        await Realtime.JoinStationAsync(stationId);
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        var result = await Api.ListAsync(_stationId);
        if (result.Success && result.Data is { } data)
        {
            _tickets = data.Tickets.ToList();
            _clockOffset = data.ServerTimeUtc - DateTime.UtcNow;
            _updatedAt = DateTime.UtcNow;
            _error = null;
            AnnounceNewlyLate();
        }
        else if (_tickets is null)
        {
            _error = result.Message;
        }
        else
        {
            Toasts.Error(result.Message);
        }

        // Same data the Completed page shows; a failure here only leaves the count as "—".
        var completed = await Api.CompletedAsync();
        if (completed.Success && completed.Data is { } done)
        {
            _completedToday = done.Tickets.Count(t => t.Status == KitchenOrderStatus.Completed);
        }

        await InvokeAsync(StateHasChanged);
    }

    // A ticket that first crosses the late threshold while this page is open raises one TicketDelayed notification
    // (bell, toast, beep and vibration per this device's preferences). Tickets already late when the page first
    // loads are remembered silently, so opening the page never sounds an alarm for old news.
    private void AnnounceNewlyLate()
    {
        if (_tickets is null)
        {
            return;
        }

        var lateNow = _tickets
            .Where(t => t.Status != KitchenOrderStatus.Ready && KitchenRules.ColumnOf(t.Status) is not null
                && KitchenRules.Timing(t.CreatedAtUtc, Now, _warn, _late) == TicketTiming.Late)
            .ToList();
        foreach (var ticket in lateNow)
        {
            if (_lateSeen.Add(ticket.Id) && _lateBaselined)
            {
                Notifier.TicketDelayed(ticket.Id, ticket.TicketNumber, ticket.TableCode);
            }
        }

        _lateSeen.IntersectWith(lateNow.Select(t => t.Id));
        _lateBaselined = true;
    }

    private void ScheduleRefresh()
    {
        _debounce?.Cancel();
        var cts = _debounce = new CancellationTokenSource();
        _ = Task.Delay(250, cts.Token).ContinueWith(t => { if (!t.IsCanceled) { _ = InvokeAsync(RefreshAsync); } }, TaskScheduler.Default);
    }

    private async Task ActAsync((KitchenTicketDto Ticket, string Action) request)
    {
        // One action at a time: a second tap while the first is in flight is ignored (the button is disabled as well).
        if (_busyTicket is not null)
        {
            return;
        }

        _busyTicket = request.Ticket.Id;
        try
        {
            var result = await Api.ActAsync(request.Ticket.Id, request.Action);
            if (!result.Success)
            {
                Toasts.Error(result.Message);
            }

            await RefreshAsync();
        }
        finally
        {
            _busyTicket = null;
        }
    }

    public void Dispose()
    {
        Realtime.Reconnected -= RefreshAsync;
        _debounce?.Cancel();
        _clock?.Dispose();
        foreach (var subscription in _subscriptions)
        {
            subscription.Dispose();
        }
    }
}
