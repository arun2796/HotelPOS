@using HotelPOS.Contracts.Enums
@using HotelPOS.Contracts.Kitchen
@* Phase 21.2 K3: one kitchen ticket. No prices, no pictures. Tapping the card opens the detail; the big buttons never do. *@
<article class="ticket @TimingClass @(Selected ? "selected" : null)" data-ticket="@Ticket.Id" data-status="@Ticket.Status">
    <div class="ticket-top" role="button" tabindex="0" aria-label="@($"Details of {Ticket.TableCode}, order {Ticket.OrderNumber}")" @onclick="() => OnOpen.InvokeAsync(Ticket)" @onkeydown="OnKey">
        <div class="ticket-id">
            <span class="ticket-table">@Ticket.TableCode</span>
            @if (ShowStation && !string.IsNullOrEmpty(Ticket.StationCode))
            {
                @* One order makes one ticket per station; the station tells two "T05" tickets apart at a glance. *@
                <span class="chip info ticket-station">@Ticket.StationCode</span>
            }
            @if (Ticket.Status == KitchenOrderStatus.Accepted)
            {
                <span class="chip info">Accepted</span>
            }
            @if (KitchenRules.IsAddedItems(Ticket))
            {
                <span class="chip primary">+ADD</span>
            }
        </div>
        <span class="chip ticket-elapsed @(Timing == TicketTiming.Late ? "danger" : Timing == TicketTiming.Warn ? "warning" : null)" data-testid="elapsed"><Icon Name="clock" Size="16" /> @ElapsedLabel</span>
    </div>
    <div class="ticket-meta muted">#@Ticket.OrderNumber · @Ticket.WaiterName · @ItemCount @(ItemCount == 1 ? "item" : "items")</div>
    <ul class="ticket-lines">
        @foreach (var line in Ticket.Items)
        {
            <li class="@(line.IsCancelled ? "cancelled" : null)">
                <div class="ticket-line"><b class="ticket-qty">@line.Quantity ×</b> <span class="ticket-name">@line.Name</span></div>
                @if (line.Modifiers.Count > 0)
                {
                    <div class="ticket-mods muted">@string.Join(", ", line.Modifiers)</div>
                }
                @if (!string.IsNullOrEmpty(line.Notes))
                {
                    <div class="ticket-note"><Icon Name="edit" Size="16" /> @line.Notes</div>
                }
            </li>
        }
    </ul>
    @{ var actions = KitchenRules.ActionsFor(Ticket.Status); }
    @if (actions.Count > 0)
    {
        <div class="ticket-actions">
            @foreach (var action in actions)
            {
                var act = action;
                @* Only the expected next step is solid; ACCEPT and START side by side must not look alike. *@
                <button type="button" class="btn lg @ButtonClass(act, act == actions[0])" data-action="@act" disabled="@Busy" @onclick="() => OnAct.InvokeAsync((Ticket, act))" @onclick:stopPropagation="true">@KitchenRules.ButtonLabel(act)</button>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public KitchenTicketDto Ticket { get; set; } = default!;
    [Parameter] public DateTime Now { get; set; } = DateTime.UtcNow;
    [Parameter] public int Warn { get; set; } = KitchenRules.DefaultWarnMinutes;
    [Parameter] public int Late { get; set; } = KitchenRules.DefaultLateMinutes;
    [Parameter] public bool ShowStation { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<KitchenTicketDto> OnOpen { get; set; }
    [Parameter] public EventCallback<(KitchenTicketDto Ticket, string Action)> OnAct { get; set; }

    // Late and warn always count from the time the ticket was created, whatever column it is in.
    private TicketTiming Timing => KitchenRules.Timing(Ticket.CreatedAtUtc, Now, Warn, Late);

    private string? TimingClass => Timing == TicketTiming.Late ? "late" : Timing == TicketTiming.Warn ? "warn" : null;

    private int ItemCount => Ticket.Items.Where(i => !i.IsCancelled).Sum(i => i.Quantity);

    // A Ready ticket shows how long it has been waiting for pick-up; every other ticket shows its age.
    private string ElapsedLabel => Ticket.Status == KitchenOrderStatus.Ready && Ticket.ReadyAtUtc is { } ready
        ? "Ready · waiting " + KitchenRules.ElapsedText(ready, Now)
        : KitchenRules.ElapsedText(Ticket.CreatedAtUtc, Now);

    private static string ButtonClass(string action, bool first) => action switch
    {
        KitchenRules.Ready => "warning",
        _ when first => "primary",
        _ => "outline",
    };

    private Task OnKey(KeyboardEventArgs e) =>
        e.Key is "Enter" or " " ? OnOpen.InvokeAsync(Ticket) : Task.CompletedTask;
}
