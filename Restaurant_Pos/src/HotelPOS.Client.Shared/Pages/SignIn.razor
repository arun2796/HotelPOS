@page "/signin"
@layout EmptyLayout
@inject WebAuthState Auth
@inject DeviceIdentity Device
@inject WebRealtimeClient Realtime
@inject WebApiClient Api
@inject NavigationManager Navigation
@inject IClientHost Host

<PageTitle>Sign in · HotelPOS</PageTitle>

<div class="signin">
    <div class="card">
        <div class="muted small">@(_restaurant ?? "HotelPOS")</div>
        <h1 style="margin-bottom:16px">Sign in</h1>

        @if (!string.IsNullOrEmpty(Auth.SessionEndedReason))
        {
            <div class="banner warning">@Auth.SessionEndedReason</div>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="banner error">@_error</div>
        }

        <label class="field">
            <span>This device is used by</span>
            <div class="seg" role="radiogroup">
                <button type="button" class="@(_type == DeviceType.Waiter ? "on" : null)" @onclick="() => SetTypeAsync(DeviceType.Waiter)">Waiter</button>
                <button type="button" class="@(_type == DeviceType.Kitchen ? "on" : null)" @onclick="() => SetTypeAsync(DeviceType.Kitchen)">Kitchen</button>
            </div>
        </label>

        <EditForm Model="this" OnValidSubmit="SubmitAsync">
            <label class="field">
                <span>Username</span>
                @* oninput, not onchange: the Sign in button enables while the field still has focus. *@
                <input class="input" @bind="_username" @bind:event="oninput" autocomplete="username" autocapitalize="none" inputmode="text" />
            </label>
            <label class="field">
                <span>Password</span>
                <input class="input" type="password" @bind="_password" @bind:event="oninput" autocomplete="current-password" />
            </label>
            <button type="submit" class="btn primary block lg" disabled="@(_busy || string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))">
                @(_busy ? "Signing in…" : "Sign in")
            </button>
        </EditForm>

        <div class="muted small" style="margin-top:16px">
            Terminal <b>@_deviceName</b> · @(_serverText)
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string _username = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _busy;
    private DeviceType _type = DeviceType.Waiter;
    private string _deviceName = string.Empty;
    private string? _restaurant;
    private string _serverText = "checking the server…";

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsSignedIn)
        {
            Navigation.NavigateTo(ReturnUrl ?? string.Empty, replace: true);
            return;
        }

        _type = await Device.GetPreferredTypeAsync();
        _deviceName = await Device.GetOrCreateNameAsync(_type);
        var info = await Api.GetAsync<SystemInfoDto>("api/system/info");
        if (info.Success && info.Data is { } data)
        {
            _restaurant = data.RestaurantName;
            _serverText = "server online";
        }
        else
        {
            _serverText = "server unreachable";
        }
    }

    private async Task SetTypeAsync(DeviceType type)
    {
        _type = type;
        await Device.SetPreferredTypeAsync(type);
        _deviceName = await Device.GetOrCreateNameAsync(type);
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.SignInAsync(_username.Trim(), _password, _deviceName, _type);
            if (!result.Success)
            {
                _error = result.Message;
                return;
            }

            await Realtime.StartAsync();
            Navigation.NavigateTo(ReturnUrl ?? string.Empty, replace: true);
        }
        finally
        {
            _busy = false;
        }
    }
}
