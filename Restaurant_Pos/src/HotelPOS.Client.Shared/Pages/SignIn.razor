@page "/signin"
@layout EmptyLayout
@inject WebAuthState Auth
@inject DeviceIdentity Device
@inject WebRealtimeClient Realtime
@inject WebApiClient Api
@inject NavigationManager Navigation
@inject IClientHost Host

<PageTitle>Sign in · HotelPOS</PageTitle>

@* Phase 21 W7 restyle: same fields, same calls (api/system/info, WebAuthState.SignInAsync), same device-type choice. *@
<div class="signin">
    <div class="card signin-card">
        <div class="signin-hero" aria-hidden="true">
            <span class="signin-mark"><Icon Name="utensils" Size="40" /></span>
        </div>
        <div class="signin-brand">@(_restaurant ?? "HotelPOS")</div>
        <h1 class="signin-title">Sign in</h1>

        @if (!string.IsNullOrEmpty(Auth.SessionEndedReason))
        {
            <div class="banner warning">@Auth.SessionEndedReason</div>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="banner error" role="alert">@_error</div>
        }

        <div class="field">
            <span>This device is used by</span>
            <Segmented Items="DeviceTypes" Selected="@_type.ToString()" SelectedChanged="SetTypeAsync" />
        </div>

        <EditForm Model="this" OnValidSubmit="SubmitAsync">
            <label class="field">
                <span>Username</span>
                @* oninput, not onchange: the Sign in button enables while the field still has focus. *@
                <input class="input" @bind="_username" @bind:event="oninput" autocomplete="username" autocapitalize="none" inputmode="text" />
            </label>
            <label class="field">
                <span>Password</span>
                <span class="input-wrap">
                    <input class="input" type="@(_showPassword ? "text" : "password")" data-testid="password" @bind="_password" @bind:event="oninput" autocomplete="current-password" />
                    <button type="button" class="input-eye" data-testid="toggle-password" aria-label="@(_showPassword ? "Hide password" : "Show password")" aria-pressed="@(_showPassword ? "true" : "false")" @onclick="() => _showPassword = !_showPassword">
                        <Icon Name="@(_showPassword ? "ban" : "circle")" Size="18" />
                    </button>
                </span>
            </label>
            <button type="submit" class="btn primary block lg" disabled="@(_busy || string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))">
                @(_busy ? "Signing in…" : "Sign in")
            </button>
        </EditForm>

        <div class="signin-foot">
            <span class="muted small">Terminal <b data-testid="signin-device">@_deviceName</b></span>
            <StatusBadge Display="ServerDisplay" />
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private static readonly IReadOnlyList<TabItem> DeviceTypes = new[] { new TabItem(nameof(DeviceType.Waiter), "Waiter"), new TabItem(nameof(DeviceType.Kitchen), "Kitchen") };

    private string _username = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _showPassword;
    private DeviceType _type = DeviceType.Waiter;
    private string _deviceName = string.Empty;
    private string? _restaurant;
    private bool? _serverOnline;

    private StatusDisplay ServerDisplay => _serverOnline switch
    {
        true => new StatusDisplay("Server online", StatusTone.Success, "check"),
        false => new StatusDisplay("Server unreachable", StatusTone.Danger, "wifi-off"),
        _ => new StatusDisplay("Checking the server…", StatusTone.Neutral, "refresh"),
    };

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsSignedIn)
        {
            Navigation.NavigateTo(ReturnUrl ?? string.Empty, replace: true);
            return;
        }

        _type = await Device.GetPreferredTypeAsync();
        _deviceName = await Device.GetOrCreateNameAsync(_type);
        var info = await Api.GetAsync<SystemInfoDto>("api/system/info");
        if (info.Success && info.Data is { } data)
        {
            _restaurant = data.RestaurantName;
            _serverOnline = true;
        }
        else
        {
            _serverOnline = false;
        }
    }

    private Task SetTypeAsync(string key) => SetTypeAsync(Enum.Parse<DeviceType>(key));

    private async Task SetTypeAsync(DeviceType type)
    {
        _type = type;
        await Device.SetPreferredTypeAsync(type);
        _deviceName = await Device.GetOrCreateNameAsync(type);
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.SignInAsync(_username.Trim(), _password, _deviceName, _type);
            if (!result.Success)
            {
                _error = result.Message;
                return;
            }

            await Realtime.StartAsync();
            // A password set by an administrator must be replaced first; the server allows nothing else until then.
            Navigation.NavigateTo(result.Data?.User.MustChangePassword == true ? "change-password" : ReturnUrl ?? string.Empty, replace: true);
        }
        finally
        {
            _busy = false;
        }
    }
}
