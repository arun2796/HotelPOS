@* Phase 21 W4: one cart line: OrderLine (picture, name, options, note, line total) plus quantity, edit and delete controls. *@

<div class="cart-line" data-testid="cart-line">
    <OrderLine Name="@Line.DisplayName" Quantity="Line.Quantity" Modifiers="@string.Join(", ", Line.ModifierNames)" Note="@Line.Notes" Price="Line.LineTotal" ImageUrl="@ImageUrl" SeatCode="@Line.SeatCode" IsParcel="@(Line.IsParcel && !OnToggleParcel.HasDelegate)" />
    @if (Line.NeedsPortionChoice)
    {
        <div class="portion-missing" data-testid="portion-missing" role="alert">This portion is no longer on the menu. Tap the pencil and choose a portion again.</div>
    }
    <div class="cart-line-controls">
        <div class="stepper" role="group" aria-label="Quantity">
            <button type="button" class="btn icon" @onclick="OnDecrease" aria-label="One less"><span aria-hidden="true">−</span></button>
            <span class="stepper-value num-tab">@Line.Quantity</span>
            <button type="button" class="btn icon" @onclick="OnIncrease" disabled="@(Line.Quantity >= HotelPOS.Contracts.Orders.OrderLimits.MaxQuantity)" aria-label="One more"><span aria-hidden="true">+</span></button>
        </div>
        <span class="grow"></span>
        @if (OnToggleParcel.HasDelegate)
        {
            <button type="button" class="btn ghost cart-line-parcel @(Line.IsParcel ? "on" : null)" data-testid="cart-line-parcel" aria-pressed="@(Line.IsParcel ? "true" : "false")"
                    aria-label="@($"Parcel for {Line.DisplayName}")" @onclick="OnToggleParcel"><Icon Name="@(Line.IsParcel ? "check" : "shopping-bag")" Size="16" /> Parcel</button>
        }
        <button type="button" class="btn icon ghost" data-testid="cart-line-edit" @onclick="OnEdit" aria-label="@($"Edit {Line.DisplayName}")"><Icon Name="pencil" /></button>
        <button type="button" class="btn icon ghost danger-text" data-testid="cart-line-delete" @onclick="OnDelete" aria-label="@($"Remove {Line.DisplayName}")"><Icon Name="trash" /></button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CartLine Line { get; set; } = new();

    [Parameter] public string? ImageUrl { get; set; }

    [Parameter] public EventCallback OnIncrease { get; set; }

    [Parameter] public EventCallback OnDecrease { get; set; }

    [Parameter] public EventCallback OnEdit { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }

    /// <summary>Flips this line's parcel flag; the toggle is only drawn when a handler is given.</summary>
    [Parameter] public EventCallback OnToggleParcel { get; set; }
}
