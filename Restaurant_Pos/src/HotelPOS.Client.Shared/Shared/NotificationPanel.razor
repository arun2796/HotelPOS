@using HotelPOS.Contracts.Realtime
@implements IDisposable
@inject NotificationCenter Center
@inject NavigationManager Navigation

<div class="notice-panel card" role="dialog" aria-label="Notifications">
    <div class="notice-head">
        <b>Notifications</b>
        <span class="spacer"></span>
        @if (Center.UnreadCount > 0)
        {
            <button class="btn ghost" type="button" @onclick="Center.MarkAllRead">Mark all read</button>
        }
        <button class="btn ghost" type="button" aria-label="Close" @onclick="OnClose">✕</button>
    </div>

    @if (Center.Items.Count == 0)
    {
        <p class="muted small">No notifications.</p>
    }
    else
    {
        <ul class="notice-list">
            @foreach (var item in Center.Items)
            {
                var entry = item;
                <li class="notice @LevelCss(entry) @(entry.IsRead ? "read" : "unread")" data-testid="notice">
                    <button class="notice-main" type="button" @onclick="() => OpenAsync(entry)">
                        <span class="notice-ico" aria-hidden="true">@Glyph(entry.Kind)</span>
                        <span class="notice-text">
                            <span class="notice-msg">@entry.Message</span>
                            <span class="muted small">@entry.Level · @entry.ReceivedAt.ToString("HH:mm")</span>
                        </span>
                    </button>
                    @if (!entry.IsAcknowledged)
                    {
                        <button class="btn ghost" type="button" @onclick="() => Center.Acknowledge(entry.Id)">Acknowledge</button>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override void OnInitialized() => Center.Changed += OnChanged;

    private async Task OpenAsync(NotificationEntry entry)
    {
        Center.MarkRead(entry.Id);
        if (NotificationRouter.UrlFor(entry.Target) is { } url)
        {
            await OnClose.InvokeAsync();
            Navigation.NavigateTo(url);
        }
    }

    private static string LevelCss(NotificationEntry entry) => entry.Level.ToString().ToLowerInvariant();

    private static string Glyph(NotificationKind kind) => kind switch
    {
        NotificationKind.TicketCreated => "🧾",
        NotificationKind.OrderAccepted => "✔",
        NotificationKind.OrderPreparing or NotificationKind.TicketDelayed => "⏱",
        NotificationKind.OrderReady => "🍽",
        NotificationKind.BillRequested or NotificationKind.BillClaimed => "🧾",
        NotificationKind.PaymentCompleted or NotificationKind.PaymentFailed => "₹",
        NotificationKind.DeviceOnline or NotificationKind.DeviceOffline => "🖥",
        NotificationKind.PrintFailed => "🖨",
        NotificationKind.DayEndWarning or NotificationKind.PeriodChanged => "📅",
        _ => "ℹ",
    };

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Center.Changed -= OnChanged;
}
