@* Notifications received on this device (NotificationCenter), newest first. Phase 21 W7: line icons per kind and tone
   colours instead of glyphs; the same list serves the bell drop-down and the More sheet. *@
@using HotelPOS.Contracts.Realtime
@implements IDisposable
@inject NotificationCenter Center
@inject NavigationManager Navigation

<div class="notice-panel card" role="dialog" aria-labelledby="notice-title">
    <div class="notice-head">
        <b id="notice-title">Notifications</b>
        @if (Center.UnreadCount > 0)
        {
            <span class="tab-count" data-testid="notice-unread">@Center.UnreadCount</span>
        }
        <span class="spacer"></span>
        @if (Center.UnreadCount > 0)
        {
            <button class="btn ghost" type="button" @onclick="Center.MarkAllRead">Mark all read</button>
        }
        <button class="btn icon ghost" type="button" aria-label="Close notifications" @onclick="OnClose"><Icon Name="x" /></button>
    </div>

    @if (Center.Items.Count == 0)
    {
        <EmptyState Small="true" Icon="bell" Text="No notifications on this device yet." />
    }
    else
    {
        <ul class="notice-list">
            @foreach (var item in Center.Items)
            {
                var entry = item;
                <li class="notice @LevelCss(entry) @(entry.IsRead ? "read" : "unread")" data-testid="notice">
                    <button class="notice-main" type="button" @onclick="() => OpenAsync(entry)">
                        <span class="notice-ico @LevelCss(entry)"><Icon Name="@NotificationIcons.For(entry.Kind)" Size="18" /></span>
                        <span class="notice-text">
                            <span class="notice-msg">@entry.Title</span>
                            @if (!string.IsNullOrWhiteSpace(entry.Body))
                            {
                                <span class="muted small">@entry.Body</span>
                            }
                            <span class="muted small num-tab">@entry.ReceivedAt.ToString("HH:mm")</span>
                        </span>
                    </button>
                    @if (!entry.IsAcknowledged)
                    {
                        <button class="btn ghost" type="button" @onclick="() => Center.Acknowledge(entry.Id)">Acknowledge</button>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override void OnInitialized() => Center.Changed += OnChanged;

    private async Task OpenAsync(NotificationEntry entry)
    {
        Center.MarkRead(entry.Id);
        if (NotificationRouter.UrlFor(entry.Target) is { } url)
        {
            await OnClose.InvokeAsync();
            Navigation.NavigateTo(url);
        }
    }

    private static string LevelCss(NotificationEntry entry) => entry.Level.ToString().ToLowerInvariant();

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Center.Changed -= OnChanged;
}
