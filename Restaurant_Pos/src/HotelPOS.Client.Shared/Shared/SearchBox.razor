<div class="search-box">
    <Icon Name="search" Size="20" />
    <input type="search" class="search-input" placeholder="@Placeholder" aria-label="@(AriaLabel ?? Placeholder)" value="@Value" @oninput="OnInputAsync" />
    @if (!string.IsNullOrEmpty(Value))
    {
        <button type="button" class="search-clear" aria-label="Clear search" @onclick="ClearAsync"><Icon Name="x" Size="18" /></button>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Search";

    [Parameter] public string? AriaLabel { get; set; }

    private Task OnInputAsync(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        return ValueChanged.InvokeAsync(Value);
    }

    private Task ClearAsync()
    {
        Value = string.Empty;
        return ValueChanged.InvokeAsync(Value);
    }
}
