@* Phase 21 W4: picture card of the order builder. The picture is the item's own ImageUrl (resolved by the host); without one
   the initials stand in (D11: no stock photos). The whole card adds the item; the star pins it to Favourites.
   Portions: an item sold in two or more portions (Quarter, Half, Full...) shows them as chips, the default selected. Tapping a
   chip only highlights it and changes the price on the Add button; the Add button puts that portion in the order. An item with
   one price keeps the single tap on the whole card. *@
@using HotelPOS.Contracts.Menu

<div class="item-wrap">
    <button type="button" class="item-card" data-testid="menu-item" disabled="@(!Item.IsAvailable)" @onclick="PickCard">
        <div class="item-img">
            @if (!string.IsNullOrEmpty(ImageUrl))
            {
                <img src="@ImageUrl" alt="" loading="lazy" />
            }
            else
            {
                <span class="item-initials" aria-hidden="true">@TextFormat.Initials(Item.Name)</span>
            }
            @if (!Item.IsAvailable)
            {
                <span class="chip danger sold">Sold out</span>
            }
        </div>
        <div class="item-body">
            <div class="item-name">@Item.Name</div>
            <div class="item-meta">
                <span class="price num-tab">@DisplayPrice</span>
                @if (StockHint is { } hint)
                {
                    <span class="muted small item-stock-hint" data-testid="item-stock">@hint</span>
                }
                @if (HasPortions)
                {
                    <span class="muted small item-options-hint">@Item.Portions.Count portions</span>
                }
                else if (Item.ModifierGroupIds.Count > 0)
                {
                    <span class="muted small item-options-hint">Customise</span>
                }
            </div>
        </div>
        @if (Item.IsAvailable)
        {
            <span class="item-add" aria-hidden="true"><Icon Name="plus" Size="18" /></span>
        }
    </button>
    <button type="button" class="item-star @(Pinned ? "on" : null)" aria-label="@((Pinned ? "Unpin " : "Pin ") + Item.Name)" aria-pressed="@(Pinned ? "true" : "false")" @onclick="OnTogglePin">
        <Icon Name="star" Size="20" />
    </button>
</div>

@code {
    [Parameter, EditorRequired] public MenuEntryDto Item { get; set; } = new();

    /// <summary>Absolute picture URL (IClientHost.ImageUrl); null draws the initials placeholder.</summary>
    [Parameter] public string? ImageUrl { get; set; }

    [Parameter] public bool Pinned { get; set; }

    /// <summary>The whole card was tapped.</summary>
    [Parameter] public EventCallback OnPick { get; set; }

    /// <summary>Kept for backwards compatibility.</summary>
    [Parameter] public EventCallback<MenuItemPortionDto> OnPickPortion { get; set; }

    [Parameter] public EventCallback OnTogglePin { get; set; }

    // Two or more portions on sale.
    private bool HasPortions => Item.Portions.Count > 1;

    private IEnumerable<MenuItemPortionDto> Sorted => Item.Portions.OrderBy(p => p.SortOrder).ThenBy(p => p.Id);

    private string DisplayPrice => HasPortions
        ? $"{Sorted.First().Price:N2}"
        : Item.Price.ToString("N2");

    private Task PickCard() => OnPick.InvokeAsync();

    // "12 left" / "Approx. 40 left" for a counted dish that can still be ordered; nothing otherwise.
    private string? StockHint => Item.IsAvailable && Item.StockRemaining is { } left
        ? Item.StockMode switch
        {
            StockTrackingMode.Exact => $"{left:N0} left",
            StockTrackingMode.Approximate => $"Approx. {left:N0} left",
            _ => null,
        }
        : null;
}
