<div class="order-line @(Cancelled ? "cancelled" : null)" data-testid="order-line">
    <span class="order-line-img">
        @if (!string.IsNullOrEmpty(ImageUrl))
        {
            <img src="@ImageUrl" alt="" loading="lazy" />
        }
        else
        {
            <span class="order-line-initials" aria-hidden="true">@Initials</span>
        }
    </span>
    <div class="order-line-main">
        <div class="order-line-name">@Quantity × @DisplayName</div>
        @if (!string.IsNullOrEmpty(SeatCode) || IsParcel)
        {
            <div class="order-line-tags">
                @if (!string.IsNullOrEmpty(SeatCode))
                {
                    <span class="chip info" data-testid="line-seat">Seat @SeatCode</span>
                }
                @if (IsParcel)
                {
                    <span class="chip warning" data-testid="line-parcel"><Icon Name="shopping-bag" Size="12" /> Parcel</span>
                }
            </div>
        }
        @if (!string.IsNullOrEmpty(Modifiers))
        {
            <div class="order-line-mods muted small">@Modifiers</div>
        }
        @if (!string.IsNullOrEmpty(Note))
        {
            <div class="order-line-note"><Icon Name="pencil" Size="14" /> <span>@Note</span></div>
        }
    </div>
    @if (Price is { } price)
    {
        <div class="order-line-price num-tab">@price.ToString("N2")</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    [Parameter] public int Quantity { get; set; } = 1;

    [Parameter] public string? Modifiers { get; set; }

    [Parameter] public string? Note { get; set; }

    [Parameter] public decimal? Price { get; set; }

    /// <summary>Absolute image URL (use IClientHost.ImageUrl); null shows the initials placeholder.</summary>
    [Parameter] public string? ImageUrl { get; set; }

    [Parameter] public bool Cancelled { get; set; }

    /// <summary>"4A": the seat the dish is for; null/empty = the whole table (nothing shown).</summary>
    [Parameter] public string? SeatCode { get; set; }

    /// <summary>Shows the "Parcel" chip; the server's " (Parcel)" name suffix is then dropped so it is not said twice.</summary>
    [Parameter] public bool IsParcel { get; set; }

    private string DisplayName => IsParcel ? OrderComposer.StripParcelSuffix(Name) : Name;

    private string Initials
    {
        get
        {
            var words = Name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            return words.Length switch
            {
                0 => "?",
                1 => words[0][..1].ToUpperInvariant(),
                _ => (words[0][..1] + words[1][..1]).ToUpperInvariant(),
            };
        }
    }
}
