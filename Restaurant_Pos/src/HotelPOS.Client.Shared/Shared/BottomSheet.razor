@* The shared .overlay + .sheet pattern (bottom sheet on phones, centred dialog from 720 px). *@
@if (Open)
{
    <div class="overlay" @onclick="OnClose">
        <div class="sheet bsheet" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation="true">
            <div class="sheet-head">
                <h2>@Title</h2>
                <button type="button" class="btn icon ghost" aria-label="Close" @onclick="OnClose"><Icon Name="x" /></button>
            </div>
            @ChildContent
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter] public string Title { get; set; } = string.Empty;

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
