@inherits LayoutComponentBase
@implements IDisposable
@inject WebAuthState Auth
@inject WebRealtimeClient Realtime
@inject ShellState Shell
@inject NavigationManager Navigation
@inject NotificationRouter Notifications
@inject NotificationCenter NotificationList

<div class="shell">
    <header class="topbar">
        <div class="title">
            @Shell.Title
            @if (!string.IsNullOrEmpty(Shell.Subtitle))
            {
                <span class="sub">@Shell.Subtitle</span>
            }
        </div>
        <ConnectionPill />
        <NotificationBell />
        @if (Auth.IsSignedIn)
        {
            <button class="btn icon ghost" title="@($"{Auth.User!.DisplayName} · Sign out")" @onclick="SignOutAsync" aria-label="Sign out">
                <span style="font-weight:700;color:var(--primary)">@Initials</span>
            </button>
        }
    </header>

    <main class="page">
        @Body
    </main>

    @if (Auth.IsSignedIn && IsWaiter)
    {
        <nav class="bottomnav">
            <NavLink href="tables" Match="NavLinkMatch.Prefix"><span class="ico">▦</span>Tables</NavLink>
            <NavLink href="my-orders"><span class="ico">☰</span>My orders</NavLink>
        </nav>
    }
    else if (Auth.IsSignedIn && IsKitchen)
    {
        <nav class="bottomnav">
            <NavLink href="kitchen" Match="NavLinkMatch.All"><span class="ico">✓</span>Kitchen</NavLink>
            <NavLink href="kitchen/completed"><span class="ico">☑</span>Completed</NavLink>
            <NavLink href="kitchen/station"><span class="ico">⚙</span>Station</NavLink>
        </nav>
    }

    <Toasts />
</div>

@code {
    private bool IsWaiter => Auth.Has(Permissions.TablesView) && !Auth.IsInRole(Roles.Kitchen);
    private bool IsKitchen => Auth.Has(Permissions.KitchenOperate) && !Auth.Has(Permissions.TablesView);

    private string Initials
    {
        get
        {
            var name = Auth.User?.DisplayName ?? "?";
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant() : name[..1].ToUpperInvariant();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Shell.Changed += StateHasChanged;
        await Notifications.StartAsync();
    }

    private async Task SignOutAsync()
    {
        Notifications.Stop();
        NotificationList.Clear();
        await Realtime.StopAsync();
        await Auth.SignOutAsync();
        Navigation.NavigateTo("signin", replace: true);
    }

    public void Dispose()
    {
        Shell.Changed -= StateHasChanged;
        Notifications.Stop();
    }
}
