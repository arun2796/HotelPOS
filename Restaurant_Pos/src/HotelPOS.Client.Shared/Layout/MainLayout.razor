@inherits LayoutComponentBase
@implements IDisposable
@inject WebAuthState Auth
@inject WebRealtimeClient Realtime
@inject ShellState Shell
@inject NavigationManager Navigation
@inject NotificationRouter Notifications
@inject NotificationCenter NotificationList

<div class="shell">
    <header class="topbar">
        <div class="title">
            <span class="title-main">@Shell.Title</span>
            @if (!string.IsNullOrEmpty(Shell.Subtitle))
            {
                <span class="sub" title="@Shell.Subtitle">@Shell.Subtitle</span>
            }
        </div>
        <ConnectionPill />
        <NotificationBell />
        <ThemeToggle />
        @if (Auth.IsSignedIn)
        {
            <button class="btn icon ghost" title="@($"{Auth.User!.DisplayName} · Sign out")" @onclick="SignOutAsync" aria-label="Sign out">
                <span class="avatar">@ShellModes.Initials(Auth.User!.DisplayName)</span>
            </button>
        }
    </header>

    <main class="page" id="main">
        @Body
    </main>

    @if (Auth.IsSignedIn && Mode == ShellMode.Waiter)
    {
        <nav class="bottomnav" aria-label="Primary">
            <NavLink href="home" aria-current="@Current("home")"><span class="ico" aria-hidden="true">⌂</span>Home</NavLink>
            <NavLink href="tables" Match="NavLinkMatch.Prefix" aria-current="@Current("tables")"><span class="ico" aria-hidden="true">▦</span>Tables</NavLink>
            <NavLink href="my-orders" aria-current="@Current("my-orders")"><span class="ico" aria-hidden="true">☰</span>My orders</NavLink>
            <NavLink href="settings" aria-current="@Current("settings")"><span class="ico" aria-hidden="true">⚙</span>Settings</NavLink>
        </nav>
    }
    else if (Auth.IsSignedIn && Mode == ShellMode.Kitchen)
    {
        <nav class="bottomnav" aria-label="Primary">
            <NavLink href="kitchen" Match="NavLinkMatch.All" aria-current="@Current("kitchen", true)"><span class="ico" aria-hidden="true">✓</span>Kitchen</NavLink>
            <NavLink href="kitchen/completed" aria-current="@Current("kitchen/completed")"><span class="ico" aria-hidden="true">☑</span>Completed</NavLink>
            <NavLink href="kitchen/station" aria-current="@Current("kitchen/station")"><span class="ico" aria-hidden="true">⚙</span>Station</NavLink>
            <NavLink href="settings" aria-current="@Current("settings")"><span class="ico" aria-hidden="true">⚙</span>Settings</NavLink>
        </nav>
    }

    <Toasts />
</div>

@code {
    private ShellMode Mode => ShellModes.For(Auth);

    private string? Current(string path, bool exact = false)
    {
        var rel = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        var on = exact ? rel == path : rel == path || rel.StartsWith(path + "/", StringComparison.Ordinal);
        return on ? "page" : null;
    }

    protected override async Task OnInitializedAsync()
    {
        Shell.Changed += StateHasChanged;
        await Notifications.StartAsync();
    }

    private async Task SignOutAsync()
    {
        Notifications.Stop();
        NotificationList.Clear();
        await Realtime.StopAsync();
        await Auth.SignOutAsync();
        Navigation.NavigateTo("signin", replace: true);
    }

    public void Dispose()
    {
        Shell.Changed -= StateHasChanged;
        Notifications.Stop();
    }
}
